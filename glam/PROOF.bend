  %ew : {RG.px.ok(AD.view(U32, RG.words(Pair.snd(Array<U32>, P.H, R.crossings(cs, (map, P.H{KM.MG{_}, a}), s)))), d, s, RG.cxs.I(RG.cxs(cs, AD.view(U32, map), dm, I, L, F)), [], RG.cxs.L(RG.cxs(cs, AD.view(U32, map), dm, I, L, F)), RG.cxs.F(RG.cxs(cs, AD.view(U32, map), dm, I, L, F)), N) && AD.full(U32, RG.words(Pair.snd(Array<U32>, P.H, R.crossings(cs, (map, P.H{KM.MG{_}, a}), s))), d) == True{} : Bool}
  %ea : {RG.px.ok(AD.view(U32, RG.words(Pair.snd(Array<U32>, P.H, R.crossings(cs, (map, P.H{KM.MG{LAT.fromT(U32, tw)}, _}), s)))), d, s, RG.cxs.I(RG.cxs(cs, AD.view(U32, map), dm, I, L, F)), [], RG.cxs.L(RG.cxs(cs, AD.view(U32, map), dm, I, L, F)), RG.cxs.F(RG.cxs(cs, AD.view(U32, map), dm, I, L, F)), N) && AD.full(U32, RG.words(Pair.snd(Array<U32>, P.H, R.crossings(cs, (map, P.H{KM.MG{LAT.fromT(U32, tw)}, _}), s))), d) == True{} : Bool}
  %em : {RG.px.ok(AD.view(U32, RG.words(Pair.snd(Array<U32>, P.H, R.crossings(cs, (_, P.H{KM.MG{LAT.fromT(U32, tw)}, LAT.fromT(V.Val, ta)}), s)))), d, s, RG.cxs.I(RG.cxs(cs, AD.view(U32, _), dm, I, L, F)), [], RG.cxs.L(RG.cxs(cs, AD.view(U32, _), dm, I, L, F)), RG.cxs.F(RG.cxs(cs, AD.view(U32, _), dm, I, L, F)), N) && AD.full(U32, RG.words(Pair.snd(Array<U32>, P.H, R.crossings(cs, (_, P.H{KM.MG{LAT.fromT(U32, tw)}, LAT.fromT(V.Val, ta)}), s))), d) == True{} : Bool}
