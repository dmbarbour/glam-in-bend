  match t:
    case IM.Lf{+y, +ky}:
      {==}
    case IM.Br{+b, +i, +l, +r}:
      +hlr = and_r(IM.nd.sep(d, b, n), IM.tr.offn(l, d, n) && IM.tr.offn(r, d, n), h)
