# the crossings in turn: every word off the tracked nodes', the free list's
# head and the faced ports' link words as it was
def crk.go(cl: List<&2, R.FzC>, -w: Array<U32>, -a: Array<V.Val>, -map: Array<U32>, +d: Nat, +dm: Nat, +s: U32, +I: IM.Ix, +L: List<&2, U32>, +F: List<&2, U32>, +N: List<&2, U32>,
  hf: {AD.full(U32, w, d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool}, hfm: {AD.full(U32, map, dm) == True{} : Bool}, +hdm: {Nat.is_lt(dm, 32n) == True{} : Bool},
  +hN: {RG.layout(N, d) == True{} : Bool}, +hB: {RG.bases(N) == True{} : Bool}, hp: {RG.px.ok(AD.view(U32, w), d, s, I, RG.pls(cl, AD.view(U32, map), dm), L, F, N) == True{} : Bool}, hok: {RG.cxs.ok(cl, AD.view(U32, map), dm, I, F) == True{} : Bool},
  +Fp: List<&2, U32>, +j: U32, +hj: {RG.off.nodes(N, d, j) == True{} : Bool}, +hjh: {Nat.is_eq(AD.slot(P.at_fh(), d), AD.slot(j, d)) == False{} : Bool}, +hjf: {RG.off.ports(Fp, d, j) == True{} : Bool}, hfi: {faced.in(L, AD.view(U32, w), d, Fp) == True{} : Bool}, mw: LAT.Mirror(U32, w), ma: LAT.Mirror(V.Val, a), mm: LAT.Mirror(U32, map)) ->
  {Pair.snd(P.H, U32, P.rd(Pair.snd(Array<U32>, P.H, R.crossings(cl, (map, P.H{KM.MG{w}, a}), s)), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{w}, a}, j)) : U32}:
  match cl:
    case Nil{}:
      {==}
    case Con{c, +rest}:
      match c:
        case R.FzC{+at, +src, +neg, +far}:
          (+tw, +ew) = mw
          (+ta, +ea) = ma
          (+tm, +em) = mm
          +hft = LAP.full_t(U32, w, tw, d, ew, hf)
          +hfmt = LAP.full_t(U32, map, tm, dm, em, hfm)
          +ePL = ME.subst(Maybe<&2, U32>, q => {RG.pl.of(q) == Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)) : U32}, Some{Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at))}, List.get(&2, U32, AD.view(U32, LAT.fromT(U32, tm)), AD.slot(at, dm)), LA.get_view(U32, LAT.fromT(U32, tm), dm, at, hfmt, hdm), {==})
          +hpa = LAB.subst(Array<U32>, qq => {RG.px.ok(AD.view(U32, qq), d, s, I, Con{RG.pl.of(List.get(&2, U32, AD.view(U32, map), AD.slot(at, dm))), RG.pls(rest, AD.view(U32, map), dm)}, L, F, N) == True{} : Bool}, w, LAT.fromT(U32, tw), Equal.sym(Array<U32>, LAT.fromT(U32, tw), w, ew), hp)
          +hpb = LAB.subst(Array<U32>, qq => {RG.px.ok(AD.view(U32, LAT.fromT(U32, tw)), d, s, I, Con{RG.pl.of(List.get(&2, U32, AD.view(U32, qq), AD.slot(at, dm))), RG.pls(rest, AD.view(U32, qq), dm)}, L, F, N) == True{} : Bool}, map, LAT.fromT(U32, tm), Equal.sym(Array<U32>, LAT.fromT(U32, tm), map, em), hpa)
          +hp3 = ME.subst(U32, q => {RG.px.ok(AD.view(U32, LAT.fromT(U32, tw)), d, s, I, Con{q, RG.pls(rest, AD.view(U32, LAT.fromT(U32, tm)), dm)}, L, F, N) == True{} : Bool}, RG.pl.of(List.get(&2, U32, AD.view(U32, LAT.fromT(U32, tm)), AD.slot(at, dm))), Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)), ePL, hpb)
          +hoa = LAB.subst(Array<U32>, qq => {(RG.cx.ab(IM.ix.look(I, far), I, src) && RG.cx.room(IM.ix.look(I, far), I, F)) && RG.cxs.ok(rest, AD.view(U32, qq), dm, RG.cx.I(IM.ix.look(I, far), I, RG.pl.of(List.get(&2, U32, AD.view(U32, qq), AD.slot(at, dm))), src, RG.cx.hd(F), far), RG.cx.F1(IM.ix.look(I, far), I, RG.pl.of(List.get(&2, U32, AD.view(U32, qq), AD.slot(at, dm))), far, RG.cx.tl(IM.ix.look(I, far), I, F))) == True{} : Bool}, map, LAT.fromT(U32, tm), Equal.sym(Array<U32>, LAT.fromT(U32, tm), map, em), hok)
          +hob = ME.subst(U32, q => {(RG.cx.ab(IM.ix.look(I, far), I, src) && RG.cx.room(IM.ix.look(I, far), I, F)) && RG.cxs.ok(rest, AD.view(U32, LAT.fromT(U32, tm)), dm, RG.cx.I(IM.ix.look(I, far), I, q, src, RG.cx.hd(F), far), RG.cx.F1(IM.ix.look(I, far), I, q, far, RG.cx.tl(IM.ix.look(I, far), I, F))) == True{} : Bool}, RG.pl.of(List.get(&2, U32, AD.view(U32, LAT.fromT(U32, tm)), AD.slot(at, dm))), Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)), ePL, hoa)
          +hab = and_l(RG.cx.ab(IM.ix.look(I, far), I, src), RG.cx.room(IM.ix.look(I, far), I, F), and_l(RG.cx.ab(IM.ix.look(I, far), I, src) && RG.cx.room(IM.ix.look(I, far), I, F), RG.cxs.ok(rest, AD.view(U32, LAT.fromT(U32, tm)), dm, RG.cx.I(IM.ix.look(I, far), I, Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)), src, RG.cx.hd(F), far), RG.cx.F1(IM.ix.look(I, far), I, Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)), far, RG.cx.tl(IM.ix.look(I, far), I, F))), hob))
          +hrm = and_r(RG.cx.ab(IM.ix.look(I, far), I, src), RG.cx.room(IM.ix.look(I, far), I, F), and_l(RG.cx.ab(IM.ix.look(I, far), I, src) && RG.cx.room(IM.ix.look(I, far), I, F), RG.cxs.ok(rest, AD.view(U32, LAT.fromT(U32, tm)), dm, RG.cx.I(IM.ix.look(I, far), I, Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)), src, RG.cx.hd(F), far), RG.cx.F1(IM.ix.look(I, far), I, Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)), far, RG.cx.tl(IM.ix.look(I, far), I, F))), hob))
          +hokr = and_r(RG.cx.ab(IM.ix.look(I, far), I, src) && RG.cx.room(IM.ix.look(I, far), I, F), RG.cxs.ok(rest, AD.view(U32, LAT.fromT(U32, tm)), dm, RG.cx.I(IM.ix.look(I, far), I, Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)), src, RG.cx.hd(F), far), RG.cx.F1(IM.ix.look(I, far), I, Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)), far, RG.cx.tl(IM.ix.look(I, far), I, F))), hob)
          +hpF = ME.subst(List<&2, U32>, q => {RG.px.ok(AD.view(U32, LAT.fromT(U32, tw)), d, s, I, Con{Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)), RG.pls(rest, AD.view(U32, LAT.fromT(U32, tm)), dm)}, L, q, N) == True{} : Bool}, F, RG.cx.F0(IM.ix.look(I, far), I, RG.cx.hd(F), RG.cx.tl(IM.ix.look(I, far), I, F)), Equal.sym(List<&2, U32>, RG.cx.F0(IM.ix.look(I, far), I, RG.cx.hd(F), RG.cx.tl(IM.ix.look(I, far), I, F)), F, cx_f0(IM.ix.look(I, far), I, F, hrm)), hp3)
          +hfiT = LAB.subst(Array<U32>, qq => {faced.in(L, AD.view(U32, qq), d, Fp) == True{} : Bool}, w, LAT.fromT(U32, tw), Equal.sym(Array<U32>, LAT.fromT(U32, tw), w, ew), hfi)
          +hC = cxp.t(tw, ta, d, s, I, RG.pls(rest, AD.view(U32, LAT.fromT(U32, tm)), dm), L, RG.cx.tl(IM.ix.look(I, far), I, F), N, Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)), src, neg, far, RG.cx.hd(F), hft, hd32, hN, hB, hpF, hab)
          +hst = cks.t(I, tw, ta, d, s, RG.pls(rest, AD.view(U32, LAT.fromT(U32, tm)), dm), L, RG.cx.tl(IM.ix.look(I, far), I, F), N, Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)), src, neg, far, RG.cx.hd(F), hft, hd32, hN, hB, hpF, hab, Fp, j, hj, hjh, hjf, hfiT)
          +hfi1 = cfs.t(I, tw, ta, d, s, RG.pls(rest, AD.view(U32, LAT.fromT(U32, tm)), dm), L, RG.cx.tl(IM.ix.look(I, far), I, F), N, Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)), src, neg, far, RG.cx.hd(F), hft, hd32, hN, hB, hpF, hab, Fp, hfiT)
          %ew : {Pair.snd(P.H, U32, P.rd(Pair.snd(Array<U32>, P.H, R.crossings(Con{R.FzC{at, src, neg, far}, rest}, (map, P.H{KM.MG{_}, a}), s)), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{_}, a}, j)) : U32}
          %ea : {Pair.snd(P.H, U32, P.rd(Pair.snd(Array<U32>, P.H, R.crossings(Con{R.FzC{at, src, neg, far}, rest}, (map, P.H{KM.MG{LAT.fromT(U32, tw)}, _}), s)), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{LAT.fromT(U32, tw)}, _}, j)) : U32}
          %em : {Pair.snd(P.H, U32, P.rd(Pair.snd(Array<U32>, P.H, R.crossings(Con{R.FzC{at, src, neg, far}, rest}, (_, P.H{KM.MG{LAT.fromT(U32, tw)}, LAT.fromT(V.Val, ta)}), s)), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{LAT.fromT(U32, tw)}, LAT.fromT(V.Val, ta)}, j)) : U32}
