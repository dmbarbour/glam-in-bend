def jnk.k(I: IM.Ix, +t0: LAT.Tree<U32>, +ta: LAT.Tree<V.Val>, +d: Nat, +s: U32, +ps: List<&2, U32>, +L: List<&2, U32>, +F: List<&2, U32>, +N: List<&2, U32>, +x: U32, +y: U32, +kx: U32, +ky: U32,
  +hft: {AD.full(U32, LAT.fromT(U32, t0), d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool}, +hN: {RG.layout(N, d) == True{} : Bool}, +hB: {RG.bases(N) == True{} : Bool},
  +hp: {RG.px.ok(AD.view(U32, LAT.fromT(U32, t0)), d, s, I, ps, L, F, N) == True{} : Bool}, +hx: {IM.ix.look(I, kx) == Some{x} : Maybe<&2, U32>}, +hy: {IM.ix.look(IM.ix.del(I, x, kx), ky) == Some{y} : Maybe<&2, U32>}, +j: U32, +hj: {RG.off.nodes(N, d, j) == True{} : Bool}, +hjh: {Nat.is_eq(AD.slot(P.at_fh(), d), AD.slot(j, d)) == False{} : Bool}, +hju: {KMd.off.port(d, KMd.word(AD.view(U32, LAT.fromT(U32, t0)), d, (x + 1 : U32)), j) == True{} : Bool}, +hjw: {KMd.off.port(d, KMd.word(AD.view(U32, LAT.fromT(U32, t0)), d, (y + 1 : U32)), j) == True{} : Bool}) -> {Pair.snd(P.H, U32, P.rd(R.join(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, x, y), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, j)) : U32}:
  match I:
    case IM.Ept{}:
      Empty.absurd({Pair.snd(P.H, U32, P.rd(R.join(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, x, y), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, j)) : U32}, MB.false_ne_true()(Equal.cong(Maybe<&2, U32>, Bool, mm => XP.is_some(mm), None{}, Some{x}, hx)))
