# A copy's crossings over the index: the words they keep
# ======================================================
#
# cells-freeze.sharing.cursors.index.ring.fold: crossings_keeps by the
# crossings in turn, each keeping word j by the index's own frame laws
# (remove_keeps, insert_keeps) at the heap after its link or its header's
# writes, a free's and a link's frame; the ports the live nodes face kept
# among the first ones (faced.in), a join moving a faced port from one
# node to another.

# word j off a node's words, ring_model's form to kmodel's
def on_ow(+d: Nat, +m: U32, +j: U32, +h: {Bool.not(Nat.is_eq(AD.slot(m, d), AD.slot(j, d))) && (Bool.not(Nat.is_eq(AD.slot((m + 1 : U32), d), AD.slot(j, d))) && (Bool.not(Nat.is_eq(AD.slot((m + 2 : U32), d), AD.slot(j, d))) && Bool.not(Nat.is_eq(AD.slot((m + 3 : U32), d), AD.slot(j, d))))) == True{} : Bool}) -> {KMd.off.words(KMd.nw(m), d, j) == True{} : Bool}:
  and_intro(Bool.not(Nat.is_eq(AD.slot(m, d), AD.slot(j, d))), Bool.not(Nat.is_eq(AD.slot((m + 1 : U32), d), AD.slot(j, d))) && (Bool.not(Nat.is_eq(AD.slot((m + 2 : U32), d), AD.slot(j, d))) && (Bool.not(Nat.is_eq(AD.slot((m + 3 : U32), d), AD.slot(j, d))) && True{})), and_l(Bool.not(Nat.is_eq(AD.slot(m, d), AD.slot(j, d))), Bool.not(Nat.is_eq(AD.slot((m + 1 : U32), d), AD.slot(j, d))) && (Bool.not(Nat.is_eq(AD.slot((m + 2 : U32), d), AD.slot(j, d))) && Bool.not(Nat.is_eq(AD.slot((m + 3 : U32), d), AD.slot(j, d)))), h), and_intro(Bool.not(Nat.is_eq(AD.slot((m + 1 : U32), d), AD.slot(j, d))), Bool.not(Nat.is_eq(AD.slot((m + 2 : U32), d), AD.slot(j, d))) && (Bool.not(Nat.is_eq(AD.slot((m + 3 : U32), d), AD.slot(j, d))) && True{}), and_l(Bool.not(Nat.is_eq(AD.slot((m + 1 : U32), d), AD.slot(j, d))), Bool.not(Nat.is_eq(AD.slot((m + 2 : U32), d), AD.slot(j, d))) && Bool.not(Nat.is_eq(AD.slot((m + 3 : U32), d), AD.slot(j, d))), and_r(Bool.not(Nat.is_eq(AD.slot(m, d), AD.slot(j, d))), Bool.not(Nat.is_eq(AD.slot((m + 1 : U32), d), AD.slot(j, d))) && (Bool.not(Nat.is_eq(AD.slot((m + 2 : U32), d), AD.slot(j, d))) && Bool.not(Nat.is_eq(AD.slot((m + 3 : U32), d), AD.slot(j, d)))), h)), and_intro(Bool.not(Nat.is_eq(AD.slot((m + 2 : U32), d), AD.slot(j, d))), Bool.not(Nat.is_eq(AD.slot((m + 3 : U32), d), AD.slot(j, d))) && True{}, and_l(Bool.not(Nat.is_eq(AD.slot((m + 2 : U32), d), AD.slot(j, d))), Bool.not(Nat.is_eq(AD.slot((m + 3 : U32), d), AD.slot(j, d))), and_r(Bool.not(Nat.is_eq(AD.slot((m + 1 : U32), d), AD.slot(j, d))), Bool.not(Nat.is_eq(AD.slot((m + 2 : U32), d), AD.slot(j, d))) && Bool.not(Nat.is_eq(AD.slot((m + 3 : U32), d), AD.slot(j, d))), and_r(Bool.not(Nat.is_eq(AD.slot(m, d), AD.slot(j, d))), Bool.not(Nat.is_eq(AD.slot((m + 1 : U32), d), AD.slot(j, d))) && (Bool.not(Nat.is_eq(AD.slot((m + 2 : U32), d), AD.slot(j, d))) && Bool.not(Nat.is_eq(AD.slot((m + 3 : U32), d), AD.slot(j, d)))), h))), and_intro(Bool.not(Nat.is_eq(AD.slot((m + 3 : U32), d), AD.slot(j, d))), True{}, and_r(Bool.not(Nat.is_eq(AD.slot((m + 2 : U32), d), AD.slot(j, d))), Bool.not(Nat.is_eq(AD.slot((m + 3 : U32), d), AD.slot(j, d))), and_r(Bool.not(Nat.is_eq(AD.slot((m + 1 : U32), d), AD.slot(j, d))), Bool.not(Nat.is_eq(AD.slot((m + 2 : U32), d), AD.slot(j, d))) && Bool.not(Nat.is_eq(AD.slot((m + 3 : U32), d), AD.slot(j, d))), and_r(Bool.not(Nat.is_eq(AD.slot(m, d), AD.slot(j, d))), Bool.not(Nat.is_eq(AD.slot((m + 1 : U32), d), AD.slot(j, d))) && (Bool.not(Nat.is_eq(AD.slot((m + 2 : U32), d), AD.slot(j, d))) && Bool.not(Nat.is_eq(AD.slot((m + 3 : U32), d), AD.slot(j, d)))), h))), {==}))))

# word j off every node of N, so off each one's
def n_at(N: List<&2, U32>, +d: Nat, +j: U32, +m: U32, +h: {RG.off.nodes(N, d, j) == True{} : Bool}, hm: {RG.has(N, m) == True{} : Bool}) -> {KMd.off.words(KMd.nw(m), d, j) == True{} : Bool}:
  on_ow(d, m, j, nodes_at(N, d, j, m, h, hm))

# word j off every branch of a tree whose nodes N holds
def offb_from(t: IM.Tr, +N: List<&2, U32>, +d: Nat, +j: U32, +hs: {RG.sub(IM.tr.nodes(t), N) == True{} : Bool}, +hj: {RG.off.nodes(N, d, j) == True{} : Bool}) -> {IM.tr.offb(t, d, j) == True{} : Bool}:
  match t:
    case IM.Lf{+y, +k}:
      {==}
    case IM.Br{+b, +i, +l, +r}:
      XP.and_intro(KMd.off.words(KMd.nw(b), d, j), IM.tr.offb(l, d, j) && IM.tr.offb(r, d, j), n_at(N, d, j, b, hj, XP.and_l(RG.has(N, b), RG.sub(List.append(&2, U32, IM.tr.nodes(l), IM.tr.nodes(r)), N), hs)),
        XP.and_intro(IM.tr.offb(l, d, j), IM.tr.offb(r, d, j),
          offb_from(l, N, d, j, sub_trans(IM.tr.nodes(l), List.append(&2, U32, IM.tr.nodes(l), IM.tr.nodes(r)), N, sub_appl(IM.tr.nodes(l), IM.tr.nodes(r)), XP.and_r(RG.has(N, b), RG.sub(List.append(&2, U32, IM.tr.nodes(l), IM.tr.nodes(r)), N), hs)), hj),
          offb_from(r, N, d, j, sub_trans(IM.tr.nodes(r), List.append(&2, U32, IM.tr.nodes(l), IM.tr.nodes(r)), N, sub_appr(IM.tr.nodes(l), IM.tr.nodes(r)), XP.and_r(RG.has(N, b), RG.sub(List.append(&2, U32, IM.tr.nodes(l), IM.tr.nodes(r)), N), hs)), hj)))

# and off the situating node's word 3: the index's frame premise
def ixoffb(I: IM.Ix, +s: U32, +N: List<&2, U32>, +d: Nat, +j: U32, +hsN: {RG.has(N, s) == True{} : Bool}, +hIN: {RG.sub(IM.ix.nodes(I), N) == True{} : Bool}, +hj: {RG.off.nodes(N, d, j) == True{} : Bool}) -> {IM.ix.offb(I, s, d, j) == True{} : Bool}:
  match I:
    case IM.Ept{}:
      and_l(Bool.not(Nat.is_eq(AD.slot((s + 3 : U32), d), AD.slot(j, d))), True{}, and_r(Bool.not(Nat.is_eq(AD.slot((s + 2 : U32), d), AD.slot(j, d))), Bool.not(Nat.is_eq(AD.slot((s + 3 : U32), d), AD.slot(j, d))) && True{}, and_r(Bool.not(Nat.is_eq(AD.slot((s + 1 : U32), d), AD.slot(j, d))), Bool.not(Nat.is_eq(AD.slot((s + 2 : U32), d), AD.slot(j, d))) && (Bool.not(Nat.is_eq(AD.slot((s + 3 : U32), d), AD.slot(j, d))) && True{}), and_r(Bool.not(Nat.is_eq(AD.slot(s, d), AD.slot(j, d))), Bool.not(Nat.is_eq(AD.slot((s + 1 : U32), d), AD.slot(j, d))) && (Bool.not(Nat.is_eq(AD.slot((s + 2 : U32), d), AD.slot(j, d))) && (Bool.not(Nat.is_eq(AD.slot((s + 3 : U32), d), AD.slot(j, d))) && True{})), n_at(N, d, j, s, hj, hsN)))))
    case IM.Has{+t}:
      XP.and_intro(Bool.not(Nat.is_eq(AD.slot((s + 3 : U32), d), AD.slot(j, d))), IM.tr.offb(t, d, j), and_l(Bool.not(Nat.is_eq(AD.slot((s + 3 : U32), d), AD.slot(j, d))), True{}, and_r(Bool.not(Nat.is_eq(AD.slot((s + 2 : U32), d), AD.slot(j, d))), Bool.not(Nat.is_eq(AD.slot((s + 3 : U32), d), AD.slot(j, d))) && True{}, and_r(Bool.not(Nat.is_eq(AD.slot((s + 1 : U32), d), AD.slot(j, d))), Bool.not(Nat.is_eq(AD.slot((s + 2 : U32), d), AD.slot(j, d))) && (Bool.not(Nat.is_eq(AD.slot((s + 3 : U32), d), AD.slot(j, d))) && True{}), and_r(Bool.not(Nat.is_eq(AD.slot(s, d), AD.slot(j, d))), Bool.not(Nat.is_eq(AD.slot((s + 1 : U32), d), AD.slot(j, d))) && (Bool.not(Nat.is_eq(AD.slot((s + 2 : U32), d), AD.slot(j, d))) && (Bool.not(Nat.is_eq(AD.slot((s + 3 : U32), d), AD.slot(j, d))) && True{})), n_at(N, d, j, s, hj, hsN))))), offb_from(t, N, d, j, hIN, hj))

# any heap in its parts (kmodel's)
def heta3(h: P.H) -> {P.H{KM.MG{KMd.words(h)}, KMd.vals(h)} == h : P.H}:
  match h:
    case P.H{w, a}:
      match w:
        case KM.MG{x}:
          {==}

# a free, every word off the node and the head as it was
def fk.m(-w: Array<U32>, -a: Array<V.Val>, +d: Nat, +r: U32, +j: U32, hf: {AD.full(U32, w, d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool},
  +h0: {Nat.is_eq(AD.slot(P.base(r), d), AD.slot(j, d)) == False{} : Bool}, +h1: {Nat.is_eq(AD.slot((P.base(r) + 1 : U32), d), AD.slot(j, d)) == False{} : Bool}, +hh: {Nat.is_eq(AD.slot(P.at_fh(), d), AD.slot(j, d)) == False{} : Bool}, m: LAT.Mirror(U32, w), ma: LAT.Mirror(V.Val, a)) ->
  {Pair.snd(P.H, U32, P.rd(P.free(P.H{KM.MG{w}, a}, r), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{w}, a}, j)) : U32}:
  (+t, +e) = m
  (+ta, +ea) = ma
