  +hft: {AD.full(U32, LAT.fromT(U32, t0), d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool}, +hN: {RG.layout(N, d) == True{} : Bool}, +hB: {RG.bases(N) == True{} : Bool},
  +hp: {RG.px.ok(AD.view(U32, LAT.fromT(U32, t0)), d, s, I, ps, L, F, N) == True{} : Bool}, +hy: {IM.ix.look(I, k) == Some{y} : Maybe<&2, U32>}, +hpo: {RG.po.all(p, [], d, N) == True{} : Bool}, +hpk: {RG.port.ok(L, d, p) == True{} : Bool}, +j: U32, +hj: {RG.off.nodes(N, d, j) == True{} : Bool}, +hjh: {Nat.is_eq(AD.slot(P.at_fh(), d), AD.slot(j, d)) == False{} : Bool}, +hjp: {KMd.off.port(d, p, j) == True{} : Bool}, +hjw: {KMd.off.port(d, KMd.word(AD.view(U32, LAT.fromT(U32, t0)), d, (y + 1 : U32)), j) == True{} : Bool}) -> {Pair.snd(P.H, U32, P.rd(R.leave(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, p, y), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, j)) : U32}:
