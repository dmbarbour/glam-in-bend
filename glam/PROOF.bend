def crossings_keeps.m(-w: Array<U32>, -a: Array<V.Val>, -map: Array<U32>, +d: Nat, +dm: Nat, +s: U32, +I: IM.Ix, +L: List<&2, U32>, +F: List<&2, U32>, +N: List<&2, U32>, +cs: List<&2, R.FzC>, +j: U32,
  hf: {AD.full(U32, w, d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool}, hfm: {AD.full(U32, map, dm) == True{} : Bool}, +hdm: {Nat.is_lt(dm, 32n) == True{} : Bool},
  +hN: {RG.layout(N, d) == True{} : Bool}, +hB: {RG.bases(N) == True{} : Bool}, hp: {RG.px.ok(AD.view(U32, w), d, s, I, RG.pls(cs, AD.view(U32, map), dm), L, F, N) == True{} : Bool}, hok: {RG.cxs.ok(cs, AD.view(U32, map), dm, I, F) == True{} : Bool},
  +hj: {RG.off.nodes(N, d, j) == True{} : Bool}, +hjh: {Nat.is_eq(AD.slot(P.at_fh(), d), AD.slot(j, d)) == False{} : Bool}, hjf: {RG.off.ports(RG.faced(L, AD.view(U32, w), d), d, j) == True{} : Bool},
  mw: LAT.Mirror(U32, w), ma: LAT.Mirror(V.Val, a), mm: LAT.Mirror(U32, map)) -> {Pair.snd(P.H, U32, P.rd(Pair.snd(Array<U32>, P.H, R.crossings(cs, (map, P.H{KM.MG{w}, a}), s)), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{w}, a}, j)) : U32}:
  (+tw, +ew) = mw
  (+ta, +ea) = ma
  (+tm, +em) = mm
  +hft = LAP.full_t(U32, w, tw, d, ew, hf)
  +hfmt = LAP.full_t(U32, map, tm, dm, em, hfm)
  +hpa = LAB.subst(Array<U32>, qq => {RG.px.ok(AD.view(U32, qq), d, s, I, RG.pls(cs, AD.view(U32, map), dm), L, F, N) == True{} : Bool}, w, LAT.fromT(U32, tw), Equal.sym(Array<U32>, LAT.fromT(U32, tw), w, ew), hp)
  +hpb = LAB.subst(Array<U32>, qq => {RG.px.ok(AD.view(U32, LAT.fromT(U32, tw)), d, s, I, RG.pls(cs, AD.view(U32, qq), dm), L, F, N) == True{} : Bool}, map, LAT.fromT(U32, tm), Equal.sym(Array<U32>, LAT.fromT(U32, tm), map, em), hpa)
  +hoT = LAB.subst(Array<U32>, qq => {RG.cxs.ok(cs, AD.view(U32, qq), dm, I, F) == True{} : Bool}, map, LAT.fromT(U32, tm), Equal.sym(Array<U32>, LAT.fromT(U32, tm), map, em), hok)
  +hjfT = LAB.subst(Array<U32>, qq => {RG.off.ports(RG.faced(L, AD.view(U32, qq), d), d, j) == True{} : Bool}, w, LAT.fromT(U32, tw), Equal.sym(Array<U32>, LAT.fromT(U32, tw), w, ew), hjf)
  %ew : {Pair.snd(P.H, U32, P.rd(Pair.snd(Array<U32>, P.H, R.crossings(cs, (map, P.H{KM.MG{_}, a}), s)), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{_}, a}, j)) : U32}
  %ea : {Pair.snd(P.H, U32, P.rd(Pair.snd(Array<U32>, P.H, R.crossings(cs, (map, P.H{KM.MG{LAT.fromT(U32, tw)}, _}), s)), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{LAT.fromT(U32, tw)}, _}, j)) : U32}
  %em : {Pair.snd(P.H, U32, P.rd(Pair.snd(Array<U32>, P.H, R.crossings(cs, (_, P.H{KM.MG{LAT.fromT(U32, tw)}, LAT.fromT(V.Val, ta)}), s)), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{LAT.fromT(U32, tw)}, LAT.fromT(V.Val, ta)}, j)) : U32}
  crk.go(cs, LAT.fromT(U32, tw), LAT.fromT(V.Val, ta), LAT.fromT(U32, tm), d, dm, s, I, L, F, N, hft, hd32, hfmt, hdm, hN, hB, hpb, hoT,
    RG.faced(L, AD.view(U32, LAT.fromT(U32, tw)), d), j, hj, hjh, hjfT, faced_init(L, L, tw, d, hft, hd32, sub_refl(L)), LAT.mirror(U32, LAT.fromT(U32, tw)), LAT.mirror(V.Val, LAT.fromT(V.Val, ta)), LAT.mirror(U32, LAT.fromT(U32, tm)))

