def Laws.serve_exact(w, a, map, d, dm, s, t, L, cs, r, nc, hf, hd32, hfm, hdm, hp, hc, hu, hr):
  serve_exact.m(w, a, map, d, dm, s, t, L, cs, r, nc, hf, hd32, hfm, hdm, hp, hc, hu, hr, LAT.mirror(U32, w), LAT.mirror(V.Val, a), LAT.mirror(U32, map))

# The pending placeholders over the index
# =======================================
#
# cells-freeze.sharing.cursors.index.ring.inv: the invariant RG.px.ok,
# every node a serve touches in one list N laid out once, apartness
# taken from it (XL.layout_ok, XL.layout_sep), roles by membership.

def and_intro(+p: Bool, +q: Bool, +hp: {p == True{} : Bool}, +hq: {q == True{} : Bool}) -> {Bool.and(p, q) == True{} : Bool}:
  XP.and_intro(p, q, hp, hq)

def and_l(+a: Bool, -b: Bool, +h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  XP.and_l(a, b, h)

def and_r(+a: Bool, -b: Bool, +h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  XP.and_r(a, b, h)

def not_true(+b: Bool, +h: {Bool.not(b) == True{} : Bool}) -> {b == False{} : Bool}:
  XP.not_true(b, h)

def neq_comm2(+a: Nat, +b: Nat, +h: {Nat.is_eq(a, b) == False{} : Bool}) -> {Nat.is_eq(b, a) == False{} : Bool}:
  XP.neq_comm(a, b, h)

def has_head(+x: U32, +xs: List<&2, U32>) -> {RG.has(Con{x, xs}, x) == True{} : Bool}:
  has_self(x, xs)

def rw_kw(h: P.H) -> {RG.words(h) == KMd.words(h) : Array<U32>}:
  match h:
    case P.H{m, a}:
      match m:
        case KM.MG{w}:
          {==}

def branch_hd(+neg: Bool) -> {X.ix.branch(P.hd2(18, R.cur.form(neg), 0)) == False{} : Bool}:
  match neg:
    case True{}:
      {==}
    case False{}:
      {==}

def nf2(+b: Bool, +h: {b == False{} : Bool}) -> {Bool.not(b) == True{} : Bool}:
  not_t(b, h)

# x in L, b not: two nodes
def nhas.k(+e: Bool, +L: List<&2, U32>, +x: U32, +b: U32, +he: {U32.is_eq(x, b) == e : Bool}, +hx: {RG.has(L, x) == True{} : Bool}, +hb: {RG.has(L, b) == False{} : Bool}) ->
  {U32.is_eq(x, b) == False{} : Bool}:
  match e:
    case True{}:
      Empty.absurd({U32.is_eq(x, b) == False{} : Bool}, MB.true_ne_false()(Equal.trans(Bool, True{}, RG.has(L, b), False{},
        Equal.sym(Bool, RG.has(L, b), True{}, ME.subst(U32, z => {RG.has(L, z) == True{} : Bool}, x, b, MS.u32_eq_of_is_eq(x, b, he), hx)), hb)))
    case False{}:
      he

def nhas(+L: List<&2, U32>, +x: U32, +b: U32, +hx: {RG.has(L, x) == True{} : Bool}, +hb: {RG.has(L, b) == False{} : Bool}) -> {U32.is_eq(x, b) == False{} : Bool}:
  nhas.k(U32.is_eq(x, b), L, x, b, {==}, hx, hb)

def none_nil(L: List<&2, U32>) -> {RG.none.in(L, []) == True{} : Bool}:
  match L:
    case Nil{}:
      {==}
    case Con{+z, +r}:
      and_intro(Bool.not(RG.has([], z)), RG.none.in(r, []), {==}, none_nil(r))

# none of L b, and none of it of X: none of it of b and X
def none_cons2(L: List<&2, U32>, +b: U32, +X: List<&2, U32>, +hn: {RG.none.in(L, X) == True{} : Bool}, +hb: {RG.has(L, b) == False{} : Bool}) -> {RG.none.in(L, Con{b, X}) == True{} : Bool}:
  match L:
    case Nil{}:
      {==}
    case Con{+z, +r}:
      and_intro(Bool.not(RG.has(Con{b, X}, z)), RG.none.in(r, Con{b, X}),
        not_t(RG.has(Con{b, X}, z), or_ff(U32.is_eq(b, z), RG.has(X, z), ueq_ne(z, b, or_false_l(U32.is_eq(z, b), RG.has(r, b), hb)),
          MB.eq_false_of_not_eq_true(RG.has(X, z), and_l(Bool.not(RG.has(X, z)), RG.none.in(r, X), hn)))),
        none_cons2(r, b, X, and_r(Bool.not(RG.has(X, z)), RG.none.in(r, X), hn), or_false_r(U32.is_eq(z, b), RG.has(r, b), hb)))

# none of ps s nor of X, nor x nor b: none of them
def none_ext(ps: List<&2, U32>, +s: U32, +x: U32, +b: U32, +X: List<&2, U32>, +hn: {RG.none.in(ps, Con{s, X}) == True{} : Bool}, +hx: {RG.has(ps, x) == False{} : Bool}, +hb: {RG.has(ps, b) == False{} : Bool}) ->
  {RG.none.in(ps, Con{s, Con{x, Con{b, X}}}) == True{} : Bool}:
  match ps:
    case Nil{}:
      {==}
    case Con{+q, +r}:
      +hq = MB.eq_false_of_not_eq_true(RG.has(Con{s, X}, q), and_l(Bool.not(RG.has(Con{s, X}, q)), RG.none.in(r, Con{s, X}), hn))
      and_intro(Bool.not(RG.has(Con{s, Con{x, Con{b, X}}}, q)), RG.none.in(r, Con{s, Con{x, Con{b, X}}}),
        not_t(RG.has(Con{s, Con{x, Con{b, X}}}, q), or_ff(U32.is_eq(s, q), RG.has(Con{x, Con{b, X}}, q), or_false_l(U32.is_eq(s, q), RG.has(X, q), hq),
          or_ff(U32.is_eq(x, q), RG.has(Con{b, X}, q), ueq_ne(q, x, or_false_l(U32.is_eq(q, x), RG.has(r, x), hx)),
            or_ff(U32.is_eq(b, q), RG.has(X, q), ueq_ne(q, b, or_false_l(U32.is_eq(q, b), RG.has(r, b), hb)), or_false_r(U32.is_eq(s, q), RG.has(X, q), hq))))),
        none_ext(r, s, x, b, X, and_r(Bool.not(RG.has(Con{s, X}, q)), RG.none.in(r, Con{s, X}), hn), or_false_r(U32.is_eq(q, x), RG.has(r, x), hx), or_false_r(U32.is_eq(q, b), RG.has(r, b), hb)))

# a tree of N's nodes and a node n of N not of the tree: n apart from it
def offn_of(t: IM.Tr, +N: List<&2, U32>, +d: Nat, +n: U32, +hN: {RG.layout(N, d) == True{} : Bool}, +hs: {RG.sub(IM.tr.nodes(t), N) == True{} : Bool}, +hn: {RG.has(N, n) == True{} : Bool},
  +hno: {RG.has(IM.tr.nodes(t), n) == False{} : Bool}) -> {IM.tr.offn(t, d, n) == True{} : Bool}:
  match t:
    case IM.Lf{+y, +ky}:
      XL.layout_sep(N, d, y, n, hN, and_l(RG.has(N, y), RG.sub([], N), hs), hn, or_false_l(U32.is_eq(y, n), RG.has([], n), hno))
    case IM.Br{+b, +i, +l, +r}:
      +hsa = and_r(RG.has(N, b), RG.sub(List.append(&2, U32, IM.tr.nodes(l), IM.tr.nodes(r)), N), hs)
      +hor = Equal.trans(Bool, Bool.or(RG.has(IM.tr.nodes(l), n), RG.has(IM.tr.nodes(r), n)), RG.has(List.append(&2, U32, IM.tr.nodes(l), IM.tr.nodes(r)), n), False{},
        Equal.sym(Bool, RG.has(List.append(&2, U32, IM.tr.nodes(l), IM.tr.nodes(r)), n), Bool.or(RG.has(IM.tr.nodes(l), n), RG.has(IM.tr.nodes(r), n)), XP.has_app(IM.tr.nodes(l), IM.tr.nodes(r), n)),
        or_false_r(U32.is_eq(b, n), RG.has(List.append(&2, U32, IM.tr.nodes(l), IM.tr.nodes(r)), n), hno))
      and_intro(IM.nd.sep(d, b, n), IM.tr.offn(l, d, n) && IM.tr.offn(r, d, n),
        XL.layout_sep(N, d, b, n, hN, and_l(RG.has(N, b), RG.sub(List.append(&2, U32, IM.tr.nodes(l), IM.tr.nodes(r)), N), hs), hn, or_false_l(U32.is_eq(b, n), RG.has(List.append(&2, U32, IM.tr.nodes(l), IM.tr.nodes(r)), n), hno)),
        and_intro(IM.tr.offn(l, d, n), IM.tr.offn(r, d, n),
          offn_of(l, N, d, n, hN, XP.sub_app_l(IM.tr.nodes(l), IM.tr.nodes(r), N, hsa), hn, or_false_l(RG.has(IM.tr.nodes(l), n), RG.has(IM.tr.nodes(r), n), hor)),
          offn_of(r, N, d, n, hN, XP.sub_app_r(IM.tr.nodes(l), IM.tr.nodes(r), N, hsa), hn, or_false_r(RG.has(IM.tr.nodes(l), n), RG.has(IM.tr.nodes(r), n), hor))))

# a node m of N no branch of a tree of N's nodes: its word 1 off the branches'
def offb_of(t: IM.Tr, +N: List<&2, U32>, +d: Nat, +m: U32, +hN: {RG.layout(N, d) == True{} : Bool}, +hs: {RG.sub(IM.tr.nodes(t), N) == True{} : Bool}, +hm: {RG.has(N, m) == True{} : Bool},
  +hnb: {RG.has(IM.tr.branches(t), m) == False{} : Bool}) -> {IM.tr.offb(t, d, (m + 1 : U32)) == True{} : Bool}:
  match t:
    case IM.Lf{+y, +ky}:
      {==}
    case IM.Br{+b, +i, +l, +r}:
      +hsa = and_r(RG.has(N, b), RG.sub(List.append(&2, U32, IM.tr.nodes(l), IM.tr.nodes(r)), N), hs)
      +hor = Equal.trans(Bool, Bool.or(RG.has(IM.tr.branches(l), m), RG.has(IM.tr.branches(r), m)), RG.has(List.append(&2, U32, IM.tr.branches(l), IM.tr.branches(r)), m), False{},
        Equal.sym(Bool, RG.has(List.append(&2, U32, IM.tr.branches(l), IM.tr.branches(r)), m), Bool.or(RG.has(IM.tr.branches(l), m), RG.has(IM.tr.branches(r), m)), XP.has_app(IM.tr.branches(l), IM.tr.branches(r), m)),
        or_false_r(U32.is_eq(b, m), RG.has(List.append(&2, U32, IM.tr.branches(l), IM.tr.branches(r)), m), hnb))
      +D = lay_pair(N, d, m, b, hN, hm, and_l(RG.has(N, b), RG.sub(List.append(&2, U32, IM.tr.nodes(l), IM.tr.nodes(r)), N), hs), ueq_ne(b, m, or_false_l(U32.is_eq(b, m), RG.has(List.append(&2, U32, IM.tr.branches(l), IM.tr.branches(r)), m), hnb)))
      and_intro(KMd.off.words(KMd.nw(b), d, (m + 1 : U32)), IM.tr.offb(l, d, (m + 1 : U32)) && IM.tr.offb(r, d, (m + 1 : U32)), and_l(KMd.off.words(KMd.nw(b), d, (m + 1 : U32)), KMd.off.words(KMd.nw(b), d, (m + 2 : U32)) && KMd.off.words(KMd.nw(b), d, (m + 3 : U32)), and_r(KMd.off.words(KMd.nw(b), d, m), KMd.off.words(KMd.nw(b), d, (m + 1 : U32)) && (KMd.off.words(KMd.nw(b), d, (m + 2 : U32)) && KMd.off.words(KMd.nw(b), d, (m + 3 : U32))), D)),
        and_intro(IM.tr.offb(l, d, (m + 1 : U32)), IM.tr.offb(r, d, (m + 1 : U32)),
          offb_of(l, N, d, m, hN, XP.sub_app_l(IM.tr.nodes(l), IM.tr.nodes(r), N, hsa), hm, or_false_l(RG.has(IM.tr.branches(l), m), RG.has(IM.tr.branches(r), m), hor)),
          offb_of(r, N, d, m, hN, XP.sub_app_r(IM.tr.nodes(l), IM.tr.nodes(r), N, hsa), hm, or_false_r(RG.has(IM.tr.branches(l), m), RG.has(IM.tr.branches(r), m), hor))))

def flok_of(F: List<&2, U32>, +N: List<&2, U32>, +d: Nat, +hN: {RG.layout(N, d) == True{} : Bool}, +hB: {RG.bases(N) == True{} : Bool}, +hs: {RG.sub(F, N) == True{} : Bool}) -> {IM.fl.ok(F, d) == True{} : Bool}:
  match F:
    case Nil{}:
      {==}
    case Con{+n, +r}:
      and_intro(IM.nd.ok(n, d), IM.fl.ok(r, d), XL.layout_ok(N, d, n, hN, hB, and_l(RG.has(N, n), RG.sub(r, N), hs)), flok_of(r, N, d, hN, hB, and_r(RG.has(N, n), RG.sub(r, N), hs)))

def flsep_of(F: List<&2, U32>, +N: List<&2, U32>, +d: Nat, +a: U32, +hN: {RG.layout(N, d) == True{} : Bool}, +hs: {RG.sub(F, N) == True{} : Bool}, +ha: {RG.has(N, a) == True{} : Bool}, +hna: {RG.has(F, a) == False{} : Bool}) ->
  {IM.fl.sep(F, d, a) == True{} : Bool}:
  match F:
    case Nil{}:
      {==}
    case Con{+n, +r}:
      and_intro(IM.nd.sep(d, a, n), IM.fl.sep(r, d, a),
        XL.layout_sep(N, d, a, n, hN, ha, and_l(RG.has(N, n), RG.sub(r, N), hs), ueq_ne(n, a, or_false_l(U32.is_eq(n, a), RG.has(r, a), hna))),
        flsep_of(r, N, d, a, hN, and_r(RG.has(N, n), RG.sub(r, N), hs), ha, or_false_r(U32.is_eq(n, a), RG.has(r, a), hna)))

def offt_of(F: List<&2, U32>, +t: IM.Tr, +N: List<&2, U32>, +d: Nat, +hN: {RG.layout(N, d) == True{} : Bool}, +hs: {RG.sub(F, N) == True{} : Bool}, +hst: {RG.sub(IM.tr.nodes(t), N) == True{} : Bool},
  +hn: {RG.none.in(F, IM.tr.nodes(t)) == True{} : Bool}) -> {IM.fl.offt(F, t, d) == True{} : Bool}:
  match F:
    case Nil{}:
      {==}
    case Con{+n, +r}:
      and_intro(IM.tr.offn(t, d, n), IM.fl.offt(r, t, d),
        offn_of(t, N, d, n, hN, hst, and_l(RG.has(N, n), RG.sub(r, N), hs), MB.eq_false_of_not_eq_true(RG.has(IM.tr.nodes(t), n), and_l(Bool.not(RG.has(IM.tr.nodes(t), n)), RG.none.in(r, IM.tr.nodes(t)), hn))),
        offt_of(r, t, N, d, hN, and_r(RG.has(N, n), RG.sub(r, N), hs), hst, and_r(Bool.not(RG.has(IM.tr.nodes(t), n)), RG.none.in(r, IM.tr.nodes(t)), hn)))

# word 0 of a node of N none of ys's, of N: off their words
def nodesoff_of0(ys: List<&2, U32>, +N: List<&2, U32>, +d: Nat, +x: U32, +hN: {RG.layout(N, d) == True{} : Bool}, +hs: {RG.sub(ys, N) == True{} : Bool}, +hx: {RG.has(N, x) == True{} : Bool}, +hxn: {RG.has(ys, x) == False{} : Bool}) ->
  {KMd.nodes.off(ys, d, x) == True{} : Bool}:
  match ys:
    case Nil{}:
      {==}
    case Con{+n, +r}:
      +D = lay_pair(N, d, x, n, hN, hx, and_l(RG.has(N, n), RG.sub(r, N), hs), ueq_ne(n, x, or_false_l(U32.is_eq(n, x), RG.has(r, x), hxn)))
      and_intro(KMd.off.words(KMd.nw(n), d, x), KMd.nodes.off(r, d, x), and_l(KMd.off.words(KMd.nw(n), d, x), KMd.off.words(KMd.nw(n), d, (x + 1 : U32)) && (KMd.off.words(KMd.nw(n), d, (x + 2 : U32)) && KMd.off.words(KMd.nw(n), d, (x + 3 : U32))), D),
        nodesoff_of0(r, N, d, x, hN, and_r(RG.has(N, n), RG.sub(r, N), hs), hx, or_false_r(U32.is_eq(n, x), RG.has(r, x), hxn)))

# word 2 of a node of N none of ys's, of N: off their words
def nodesoff_of2(ys: List<&2, U32>, +N: List<&2, U32>, +d: Nat, +x: U32, +hN: {RG.layout(N, d) == True{} : Bool}, +hs: {RG.sub(ys, N) == True{} : Bool}, +hx: {RG.has(N, x) == True{} : Bool}, +hxn: {RG.has(ys, x) == False{} : Bool}) ->
  {KMd.nodes.off(ys, d, (x + 2 : U32)) == True{} : Bool}:
