  %e : {faced.in(RG.cross.L(RG.first(cs, AD.view(U32, _), d, far), x, L), AD.view(U32, RG.words(R.cross(P.H{KM.MG{_}, a}, s, x, src, neg, far))), d, F) == True{} : Bool}
