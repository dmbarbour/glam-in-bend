    {RG.ring.ok(AD.view(U32, RG.words(R.leave(_, r, nc))), d, s, RG.without(Pair.fst(List<&2, U32>, List<&2, U32>, RG.cr(cs, AD.view(U32, LAT.fromT(U32, tm)), dm, AD.view(U32, LAT.fromT(U32, tw)), d, rt, L)), nc)) == True{} : Bool}
