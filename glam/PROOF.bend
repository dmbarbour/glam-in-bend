  and_l(IM.ix.real(AD.view(U32, RG.words(R.leave(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, p, y))), d, s, IM.ix.del(I, y, k)) && (IM.ix.inv(IM.ix.del(I, y, k)) && (IM.ix.lay(IM.ix.del(I, y, k), s, d) && (RG.sub(Con{s, IM.ix.leaves(IM.ix.del(I, y, k))}, RG.without(L, y)) && (RG.sub(ps, RG.without(L, y)) && (RG.none.in(ps, Con{s, IM.ix.nodes(IM.ix.del(I, y, k))}) && (RG.distinct(ps) && (RG.none.in(RG.without(L, y), IM.ix.branches(IM.ix.del(I, y, k))) && (KMd.chain(Con{y, IM.mb.cons(IM.ix.par(I, y, k), F)}, AD.view(U32, RG.words(R.leave(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, p, y))), d, KMd.word(AD.view(U32, RG.words(R.leave(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, p, y))), d, P.at_fh())) && (RG.distinct(Con{y, IM.mb.cons(IM.ix.par(I, y, k), F)}) && (RG.none.in(Con{y, IM.mb.cons(IM.ix.par(I, y, k), F)}, Con{s, IM.ix.nodes(IM.ix.del(I, y, k))}) && (RG.none.in(Con{y, IM.mb.cons(IM.ix.par(I, y, k), F)}, RG.without(L, y)) && (RG.sub(RG.without(L, y), N) && (RG.sub(Con{y, IM.mb.cons(IM.ix.par(I, y, k), F)}, N) && (RG.sub(IM.ix.nodes(IM.ix.del(I, y, k)), N) && (RG.faces(RG.without(L, y), AD.view(U32, RG.words(R.leave(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, p, y))), d, RG.without(L, y)) && (RG.px.off(RG.without(L, y), AD.view(U32, RG.words(R.leave(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, p, y))), d, RG.without(L, y), N) && RG.px.tw(RG.without(L, y), AD.view(U32, RG.words(R.leave(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, p, y))), d, RG.without(L, y)))))))))))))))))), AD.full(U32, RG.words(R.leave(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, p, y)), d),
