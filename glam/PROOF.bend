  +hp: {RG.px.ok(AD.view(U32, LAT.fromT(U32, t0)), d, s, I, Con{x, ps}, L, IM.ix.take(I, b, F), N) == True{} : Bool}, +ha: {IM.ix.look(I, src) == None{} : Maybe<&2, U32>}) -> {Pair.snd(P.H, U32, P.rd(R.cursor(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, s, x, src, neg), x)) == P.hd2(18, R.cur.form(neg), 0) : U32}:
  match I:
    case IM.Ept{}:
      ch.ept(t0, ta, d, s, ps, L, F, N, x, src, neg, b, hft, hd32, hN, hB, hp, ha)
    case IM.Has{+t}:
      ch.has(t, t0, ta, d, s, ps, L, F, N, x, src, neg, b, hft, hd32, hN, hB, hp, ha)

def ch.m(-w: Array<U32>, -a: Array<V.Val>, +d: Nat, +s: U32, +I: IM.Ix, +ps: List<&2, U32>, +L: List<&2, U32>, +F: List<&2, U32>, +N: List<&2, U32>, +x: U32, +src: U32, +neg: Bool, +b: U32,
  hf: {AD.full(U32, w, d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool}, +hN: {RG.layout(N, d) == True{} : Bool}, +hB: {RG.bases(N) == True{} : Bool},
  hp: {RG.px.ok(AD.view(U32, w), d, s, I, Con{x, ps}, L, IM.ix.take(I, b, F), N) == True{} : Bool}, +ha: {IM.ix.look(I, src) == None{} : Maybe<&2, U32>}, m: LAT.Mirror(U32, w), ma: LAT.Mirror(V.Val, a)) -> {Pair.snd(P.H, U32, P.rd(R.cursor(P.H{KM.MG{w}, a}, s, x, src, neg), x)) == P.hd2(18, R.cur.form(neg), 0) : U32}:
