  +hft = LAP.full_t(U32, w, t0, d, e, hf)
  +ew = Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, e)
  +hpT = LAB.subst(Array<U32>, qq => {RG.px.ok(AD.view(U32, qq), d, s, I, Con{x, ps}, L, RG.cx.F0(IM.ix.look(I, far), I, b, F), N) == True{} : Bool}, w, LAT.fromT(U32, t0), ew, hp)
  %e : {RG.px.ok(AD.view(U32, RG.words(R.cross(P.H{KM.MG{_}, a}, s, x, src, neg, far))), d, s, RG.cx.I(IM.ix.look(I, far), I, x, src, b, far), ps, RG.cx.L(IM.ix.look(I, far), x, L), RG.cx.F1(IM.ix.look(I, far), I, x, far, F), N) && AD.full(U32, RG.words(R.cross(P.H{KM.MG{_}, a}, s, x, src, neg, far)), d) == True{} : Bool}
