      %XP.wl_ne(v, d, j, (z + 1 : U32), val, not_true(Nat.is_eq(AD.slot(j, d), AD.slot((z + 1 : U32), d)), and_l(Bool.not(Nat.is_eq(AD.slot(j, d), AD.slot((z + 1 : U32), d))), ones(r, d, j), ho))) : {RG.po.all(_, L, d, N) && RG.px.off(r, List.set(&2, U32, v, AD.slot(j, d), val), d, L, N) == True{} : Bool}
