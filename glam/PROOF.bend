    case Nil{}:
      {==}
    case Con{+z, +r}:
      and_intro(RG.has(Con{y, RG.without(L, y)}, z), RG.sub(r, Con{y, RG.without(L, y)}), sub_back1.k(U32.is_eq(y, z), z, L, y, {==}, and_l(RG.has(L, z), RG.sub(r, L), hK)),
        sub_back1(r, L, y, and_r(RG.has(L, z), RG.sub(r, L), hK)))

