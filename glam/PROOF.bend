  +hjut = LAB.subst(Array<U32>, q => {KMd.off.port(d, Pair.snd(Array<U32>, U32, Array.get(U32, q, (x + 1 : U32))), j) == True{} : Bool}, w, LAT.fromT(U32, t), Equal.sym(Array<U32>, LAT.fromT(U32, t), w, e), hju)
