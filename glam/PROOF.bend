  hp: {RG.px.ok(AD.view(U32, w), d, s, I, ps, L, F, N) == True{} : Bool}, +hx: {IM.ix.look(I, kx) == Some{x} : Maybe<&2, U32>}, +hy: {IM.ix.look(IM.ix.del(I, x, kx), ky) == Some{y} : Maybe<&2, U32>},
  +hj: {RG.off.nodes(N, d, j) == True{} : Bool}, +hjh: {Nat.is_eq(AD.slot(P.at_fh(), d), AD.slot(j, d)) == False{} : Bool}, hju: {KMd.off.port(d, KMd.word(AD.view(U32, w), d, (x + 1 : U32)), j) == True{} : Bool}, hjw: {KMd.off.port(d, KMd.word(AD.view(U32, w), d, (y + 1 : U32)), j) == True{} : Bool},
  m: LAT.Mirror(U32, w), ma: LAT.Mirror(V.Val, a)) -> {Pair.snd(P.H, U32, P.rd(R.join(P.H{KM.MG{w}, a}, x, y), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{w}, a}, j)) : U32}:
