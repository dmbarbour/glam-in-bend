def pdone_exact.go(-w: Array<U32>, -a: Array<V.Val>, +d: Nat, +s: U32, +pre: List<&2, U32>, +x: U32, +post: List<&2, U32>,
  hf: {AD.full(U32, w, d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool},
