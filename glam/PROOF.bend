def Laws.join_pend(w, a, d, s, I, ps, L, F, N, x, y, kx, ky, hf, hd32, hN, hB, hp, hx, hy, hxy):
  jnpx.m(w, a, d, s, I, ps, L, F, N, x, y, kx, ky, hf, hd32, hN, hB, hp, hx, hy, hxy, LAT.mirror(U32, w), LAT.mirror(V.Val, a))

# The ports the live nodes face after a copy's crossings, among those faced
# at the start (cells-freeze.sharing.cursors.index.ring.leave: the frame of
# the leave at the source's root, serve_root_keeps)
def cfi.go(cl: List<&2, R.FzC>, -w: Array<U32>, -a: Array<V.Val>, -map: Array<U32>, +d: Nat, +dm: Nat, +s: U32, +I: IM.Ix, +L: List<&2, U32>, +F: List<&2, U32>, +N: List<&2, U32>,
  hf: {AD.full(U32, w, d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool}, hfm: {AD.full(U32, map, dm) == True{} : Bool}, +hdm: {Nat.is_lt(dm, 32n) == True{} : Bool},
  +hN: {RG.layout(N, d) == True{} : Bool}, +hB: {RG.bases(N) == True{} : Bool}, hp: {RG.px.ok(AD.view(U32, w), d, s, I, RG.pls(cl, AD.view(U32, map), dm), L, F, N) == True{} : Bool}, hok: {RG.cxs.ok(cl, AD.view(U32, map), dm, I, F) == True{} : Bool},
  +Fp: List<&2, U32>, hfi: {faced.in(L, AD.view(U32, w), d, Fp) == True{} : Bool}, mw: LAT.Mirror(U32, w), ma: LAT.Mirror(V.Val, a), mm: LAT.Mirror(U32, map)) -> {faced.in(RG.cxs.L(RG.cxs(cl, AD.view(U32, map), dm, I, L, F)), AD.view(U32, RG.words(Pair.snd(Array<U32>, P.H, R.crossings(cl, (map, P.H{KM.MG{w}, a}), s)))), d, Fp) == True{} : Bool}:
  match cl:
    case Nil{}:
      hfi
    case Con{c, +rest}:
      match c:
        case R.FzC{+at, +src, +neg, +far}:
          (+tw, +ew) = mw
          (+ta, +ea) = ma
          (+tm, +em) = mm
          +hft = LAP.full_t(U32, w, tw, d, ew, hf)
          +hfmt = LAP.full_t(U32, map, tm, dm, em, hfm)
