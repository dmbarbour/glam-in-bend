def fr_parts(-w: Array<U32>, -a: Array<V.Val>, +r: U32, m: LAT.Mirror(U32, w)) ->
    {P.H{KM.MG{RG.words(P.free(P.H{KM.MG{w}, a}, r))}, a} == P.free(P.H{KM.MG{w}, a}, r) : P.H}:
