def sub_back1.k(+ey: Bool, +z: U32, +L: List<&2, U32>, +y: U32, +hey: {U32.is_eq(y, z) == ey : Bool}, +hz: {RG.has(L, z) == True{} : Bool}) -> {RG.has(Con{y, RG.without(L, y)}, z) == True{} : Bool}:
  match ey:
    case True{}:
      %Equal.sym(Bool, U32.is_eq(y, z), True{}, hey) : {Bool.or(_, RG.has(RG.without(L, y), z)) == True{} : Bool}
      {==}
    case False{}:
      has_cons(y, RG.without(L, y), z, has_without(L, y, z, hey, hz))

def sub_back1(K: List<&2, U32>, +L: List<&2, U32>, +y: U32, +hK: {RG.sub(K, L) == True{} : Bool}) -> {RG.sub(K, Con{y, RG.without(L, y)}) == True{} : Bool}:
