        ow_po(r, L, d, N, n, hst, hpo, and_l(RG.has(N, n), RG.sub(t, N), hFN), MB.eq_false_of_not_eq_true(RG.has(L, n), and_l(Bool.not(RG.has(L, n)), RG.none.in(t, L), hFL))),
        nodesoff_po(t, r, L, d, N, hst, hpo, and_r(RG.has(N, n), RG.sub(t, N), hFN), and_r(Bool.not(RG.has(L, n)), RG.none.in(t, L), hFL)))

# the link's write at r + 1 off the words the realization reads
def offr_po(t: IM.Tr, +r: U32, +L: List<&2, U32>, +d: Nat, +N: List<&2, U32>, +hst: {P.is_static(r) == False{} : Bool}, +hpo: {RG.po.all(r, L, d, N) == True{} : Bool},
  +hpk: {RG.port.ok(L, d, r) == True{} : Bool}, +hsN: {RG.sub(IM.tr.nodes(t), N) == True{} : Bool}, +hsL: {RG.sub(IM.tr.leaves(t), L) == True{} : Bool}, +hbL: {RG.none.in(L, IM.tr.branches(t)) == True{} : Bool}) -> {IM.tr.offr(t, d, (r + 1 : U32)) == True{} : Bool}:
  match t:
    case IM.Lf{+y, +ky}:
      +hyL = and_l(RG.has(L, y), RG.sub([], L), hsL)
      and_intro(Bool.not(Nat.is_eq(AD.slot(y, d), AD.slot((r + 1 : U32), d))), Bool.not(Nat.is_eq(AD.slot((y + 2 : U32), d), AD.slot((r + 1 : U32), d))) && (Bool.not(Nat.is_eq(AD.slot((y + 3 : U32), d), AD.slot((r + 1 : U32), d))) && True{}), opw(r, d, y, hst, and_l(KMd.off.port(d, r, y), Bool.or(RG.has(L, y), KMd.off.port(d, r, (y + 1 : U32)) && (KMd.off.port(d, r, (y + 2 : U32)) && KMd.off.port(d, r, (y + 3 : U32)))), po_at(N, r, L, d, y, hpo, and_l(RG.has(N, y), RG.sub([], N), hsN)))), and_intro(Bool.not(Nat.is_eq(AD.slot((y + 2 : U32), d), AD.slot((r + 1 : U32), d))), Bool.not(Nat.is_eq(AD.slot((y + 3 : U32), d), AD.slot((r + 1 : U32), d))) && True{}, nf2(Nat.is_eq(AD.slot((y + 2 : U32), d), AD.slot((r + 1 : U32), d)), neq_comm2(AD.slot((r + 1 : U32), d), AD.slot((y + 2 : U32), d), not_true(Nat.is_eq(AD.slot((r + 1 : U32), d), AD.slot((y + 2 : U32), d)), JP.opos_at(L, d, (r + 1 : U32), y, and_r(RG.off.links(L, d, (r + 1 : U32)), RG.off.pos(L, d, (r + 1 : U32)), hpk), hyL)))), and_intro(Bool.not(Nat.is_eq(AD.slot((y + 3 : U32), d), AD.slot((r + 1 : U32), d))), True{}, nf2(Nat.is_eq(AD.slot((y + 3 : U32), d), AD.slot((r + 1 : U32), d)), neq_comm2(AD.slot((r + 1 : U32), d), AD.slot((y + 3 : U32), d), not_true(Nat.is_eq(AD.slot((r + 1 : U32), d), AD.slot((y + 3 : U32), d)), JP.ol_at(L, d, (r + 1 : U32), y, and_l(RG.off.links(L, d, (r + 1 : U32)), RG.off.pos(L, d, (r + 1 : U32)), hpk), hyL)))), {==})))
    case IM.Br{+b, +i, +l, +r2}:
      +hsa = and_r(RG.has(N, b), RG.sub(List.append(&2, U32, IM.tr.nodes(l), IM.tr.nodes(r2)), N), hsN)
      +hba = none_sub(L, Con{b, List.append(&2, U32, IM.tr.branches(l), IM.tr.branches(r2))}, List.append(&2, U32, IM.tr.branches(l), IM.tr.branches(r2)), hbL, sub_cons_r(List.append(&2, U32, IM.tr.branches(l), IM.tr.branches(r2)), b, List.append(&2, U32, IM.tr.branches(l), IM.tr.branches(r2)), sub_refl(List.append(&2, U32, IM.tr.branches(l), IM.tr.branches(r2)))))
      and_intro(KMd.off.words(KMd.nw(b), d, (r + 1 : U32)), IM.tr.offr(l, d, (r + 1 : U32)) && IM.tr.offr(r2, d, (r + 1 : U32)),
        ow_po(r, L, d, N, b, hst, hpo, and_l(RG.has(N, b), RG.sub(List.append(&2, U32, IM.tr.nodes(l), IM.tr.nodes(r2)), N), hsN), none_head(L, b, List.append(&2, U32, IM.tr.branches(l), IM.tr.branches(r2)), hbL)),
        and_intro(IM.tr.offr(l, d, (r + 1 : U32)), IM.tr.offr(r2, d, (r + 1 : U32)),
          offr_po(l, r, L, d, N, hst, hpo, hpk, XP.sub_app_l(IM.tr.nodes(l), IM.tr.nodes(r2), N, hsa), XP.sub_app_l(IM.tr.leaves(l), IM.tr.leaves(r2), L, hsL), none_sub(L, List.append(&2, U32, IM.tr.branches(l), IM.tr.branches(r2)), IM.tr.branches(l), hba, sub_appl(IM.tr.branches(l), IM.tr.branches(r2)))),
          offr_po(r2, r, L, d, N, hst, hpo, hpk, XP.sub_app_r(IM.tr.nodes(l), IM.tr.nodes(r2), N, hsa), XP.sub_app_r(IM.tr.leaves(l), IM.tr.leaves(r2), L, hsL), none_sub(L, List.append(&2, U32, IM.tr.branches(l), IM.tr.branches(r2)), IM.tr.branches(r2), hba, sub_appr(IM.tr.branches(l), IM.tr.branches(r2))))))

# and the situating node's word 3
def offr3(+r: U32, +L: List<&2, U32>, +d: Nat, +s: U32, +hpk: {RG.port.ok(L, d, r) == True{} : Bool}, +hsL: {RG.has(L, s) == True{} : Bool}) -> {Bool.not(Nat.is_eq(AD.slot((s + 3 : U32), d), AD.slot((r + 1 : U32), d))) == True{} : Bool}:
  nf2(Nat.is_eq(AD.slot((s + 3 : U32), d), AD.slot((r + 1 : U32), d)), neq_comm2(AD.slot((r + 1 : U32), d), AD.slot((s + 3 : U32), d), not_true(Nat.is_eq(AD.slot((r + 1 : U32), d), AD.slot((s + 3 : U32), d)), JP.ol_at(L, d, (r + 1 : U32), s, and_l(RG.off.links(L, d, (r + 1 : U32)), RG.off.pos(L, d, (r + 1 : U32)), hpk), hsL))))

# a link's write kept off the realization and the free list
def real_lk(+st: Bool, A: Array<U32>, +ta: LAT.Tree<V.Val>, +d: Nat, +s: U32, +I: IM.Ix, +r: U32, +val: U32, +hst: {P.is_static(r) == st : Bool},
  +hj: {Bool.or(st, IM.ix.offr(I, s, d, (r + 1 : U32))) == True{} : Bool}, hf: {AD.full(U32, A, d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool},
  hr: {IM.ix.real(AD.view(U32, A), d, s, I) == True{} : Bool}) -> {IM.ix.real(AD.view(U32, JP.lk(st, A, r, val)), d, s, I) == True{} : Bool}:
  match st:
    case True{}:
      hr
    case False{}:
      XL.real_kept1(A, LAT.fromT(V.Val, ta), d, s, I, (r + 1 : U32), val, hf, hd32, hj, hr)

def chain_lk(+st: Bool, A: Array<U32>, +ta: LAT.Tree<V.Val>, +d: Nat, +r: U32, +val: U32, +ns: List<&2, U32>, +hst: {P.is_static(r) == st : Bool},
  +hj: {Bool.or(st, KMd.nodes.off(ns, d, (r + 1 : U32))) == True{} : Bool}, +hjh: {Bool.or(st, Bool.not(Nat.is_eq(AD.slot((r + 1 : U32), d), AD.slot(P.at_fh(), d)))) == True{} : Bool},
  hf: {AD.full(U32, A, d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool},
  hc: {KMd.chain(ns, AD.view(U32, A), d, KMd.word(AD.view(U32, A), d, P.at_fh())) == True{} : Bool}) -> {KMd.chain(ns, AD.view(U32, JP.lk(st, A, r, val)), d, KMd.word(AD.view(U32, JP.lk(st, A, r, val)), d, P.at_fh())) == True{} : Bool}:
  match st:
    case True{}:
      hc
    case False{}:
      XL.chain_kept(A, LAT.fromT(V.Val, ta), d, (r + 1 : U32), val, ns, hf, hd32, not_true(Nat.is_eq(AD.slot((r + 1 : U32), d), AD.slot(P.at_fh(), d)), hjh), hj, hc)

# the three, for a faced port, from what the invariant asks of it
def offr_ix(I: IM.Ix, +r: U32, +L: List<&2, U32>, +d: Nat, +N: List<&2, U32>, +s: U32, +hst: {P.is_static(r) == False{} : Bool}, +hpo: {RG.po.all(r, L, d, N) == True{} : Bool},
  +hpk: {RG.port.ok(L, d, r) == True{} : Bool}, +hsL: {RG.has(L, s) == True{} : Bool}, +hIN: {RG.sub(IM.ix.nodes(I), N) == True{} : Bool}, +hlL: {RG.sub(IM.ix.leaves(I), L) == True{} : Bool}, +hbL: {RG.none.in(L, IM.ix.branches(I)) == True{} : Bool}) ->
  {IM.ix.offr(I, s, d, (r + 1 : U32)) == True{} : Bool}:
  match I:
    case IM.Ept{}:
      offr3(r, L, d, s, hpk, hsL)
    case IM.Has{+t}:
      and_intro(Bool.not(Nat.is_eq(AD.slot((s + 3 : U32), d), AD.slot((r + 1 : U32), d))), IM.tr.offr(t, d, (r + 1 : U32)), offr3(r, L, d, s, hpk, hsL), offr_po(t, r, L, d, N, hst, hpo, hpk, hIN, hlL, hbL))

