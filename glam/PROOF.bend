  %ea : {faced.in(RG.cxs.L(RG.cxs(cs, AD.view(U32, map), dm, I, L, F)), AD.view(U32, RG.words(Pair.snd(Array<U32>, P.H, R.crossings(cs, (map, P.H{KM.MG{LAT.fromT(U32, tw)}, _}), s)))), d, RG.faced(L, AD.view(U32, LAT.fromT(U32, tw)), d)) == True{} : Bool}
