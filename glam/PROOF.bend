# a node n of N not live: r's link word off its four words
def ow_po(+r: U32, +L: List<&2, U32>, +d: Nat, +N: List<&2, U32>, +n: U32, +hst: {P.is_static(r) == False{} : Bool}, +hpo: {RG.po.all(r, L, d, N) == True{} : Bool},
  +hn: {RG.has(N, n) == True{} : Bool}, +hnl: {RG.has(L, n) == False{} : Bool}) -> {KMd.off.words(KMd.nw(n), d, (r + 1 : U32)) == True{} : Bool}:
