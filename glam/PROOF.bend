def cxp.m(-w: Array<U32>, -a: Array<V.Val>, +d: Nat, +s: U32, +I: IM.Ix, +ps: List<&2, U32>, +L: List<&2, U32>, +F: List<&2, U32>, +N: List<&2, U32>, +x: U32, +src: U32, +neg: Bool, +far: U32, +b: U32,
  hf: {AD.full(U32, w, d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool}, +hN: {RG.layout(N, d) == True{} : Bool}, +hB: {RG.bases(N) == True{} : Bool},
  hp: {RG.px.ok(AD.view(U32, w), d, s, I, Con{x, ps}, L, RG.cx.F0(IM.ix.look(I, far), I, b, F), N) == True{} : Bool}, +ha: {RG.cx.ab(IM.ix.look(I, far), I, src) == True{} : Bool}, m: LAT.Mirror(U32, w), ma: LAT.Mirror(V.Val, a)) ->
  {RG.px.ok(AD.view(U32, RG.words(R.cross(P.H{KM.MG{w}, a}, s, x, src, neg, far))), d, s, RG.cx.I(IM.ix.look(I, far), I, x, src, b, far), ps, RG.cx.L(IM.ix.look(I, far), x, L), RG.cx.F1(IM.ix.look(I, far), I, x, far, F), N) == True{} : Bool}:
  (+t0, +e) = m
  (+ta, +ea) = ma
  +hft = LAP.full_t(U32, w, t0, d, e, hf)
  +ew = Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, e)
  +hpT = LAB.subst(Array<U32>, qq => {RG.px.ok(AD.view(U32, qq), d, s, I, Con{x, ps}, L, RG.cx.F0(IM.ix.look(I, far), I, b, F), N) == True{} : Bool}, w, LAT.fromT(U32, t0), ew, hp)
  %e : {RG.px.ok(AD.view(U32, RG.words(R.cross(P.H{KM.MG{_}, a}, s, x, src, neg, far))), d, s, RG.cx.I(IM.ix.look(I, far), I, x, src, b, far), ps, RG.cx.L(IM.ix.look(I, far), x, L), RG.cx.F1(IM.ix.look(I, far), I, x, far, F), N) == True{} : Bool}
  %ea : {RG.px.ok(AD.view(U32, RG.words(R.cross(P.H{KM.MG{LAT.fromT(U32, t0)}, _}, s, x, src, neg, far))), d, s, RG.cx.I(IM.ix.look(I, far), I, x, src, b, far), ps, RG.cx.L(IM.ix.look(I, far), x, L), RG.cx.F1(IM.ix.look(I, far), I, x, far, F), N) == True{} : Bool}
  and_l(RG.px.ok(AD.view(U32, RG.words(R.cross(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, s, x, src, neg, far))), d, s, RG.cx.I(IM.ix.look(I, far), I, x, src, b, far), ps, RG.cx.L(IM.ix.look(I, far), x, L), RG.cx.F1(IM.ix.look(I, far), I, x, far, F), N), AD.full(U32, RG.words(R.cross(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, s, x, src, neg, far)), d),
    cxp.t(t0, ta, d, s, I, ps, L, F, N, x, src, neg, far, b, hft, hd32, hN, hB, hpT, ha))

def Laws.cross_pend(w, a, d, s, I, ps, L, F, N, x, src, neg, far, b, hf, hd32, hN, hB, hp, ha):
  cxp.m(w, a, d, s, I, ps, L, F, N, x, src, neg, far, b, hf, hd32, hN, hB, hp, ha, LAT.mirror(U32, w), LAT.mirror(V.Val, a))

# A copy's crossings over the index
# =================================
#
# cells-freeze.sharing.cursors.index.ring.fold: crossings_pend by the
# crossings in turn, each by cxp.t (the invariant after a crossing and
# its words full), the heap after it rebuilt from its parts (heta2) for
# the next; the model's placeholder the code's (LA.get_view), its free
# list as the crossing's law takes it (cx_f0).

# any heap in its parts (as glam/SPLICE_PROOF.bend's heta, by RG.words)
def heta2(h: P.H) -> {P.H{KM.MG{RG.words(h)}, KMd.vals(h)} == h : P.H}:
  match h:
    case P.H{w, a}:
      match w:
        case KM.MG{x}:
          {==}

# the free list's first nodes as a crossing's law takes them, where there
# is room: the branch a cursor made in a tree takes, then the rest
def cx_f0(m: Maybe<&2, U32>, +I: IM.Ix, F: List<&2, U32>, +h: {RG.cx.room(m, I, F) == True{} : Bool}) -> {RG.cx.F0(m, I, RG.cx.hd(F), RG.cx.tl(m, I, F)) == F : List<&2, U32>}:
  match m:
    case Some{+y}:
      {==}
    case None{}:
      match I:
        case IM.Ept{}:
          {==}
        case IM.Has{+t}:
          match F:
            case Nil{}:
              Empty.absurd({RG.cx.F0(None{}, IM.Has{t}, RG.cx.hd([]), RG.cx.tl(None{}, IM.Has{t}, [])) == [] : List<&2, U32>}, MB.false_ne_true()(h))
            case Con{+b, +r}:
              {==}

# the crossings in turn: the invariant after them, and their words full
def crf.go(cl: List<&2, R.FzC>, -w: Array<U32>, -a: Array<V.Val>, -map: Array<U32>, +d: Nat, +dm: Nat, +s: U32, +I: IM.Ix, +L: List<&2, U32>, +F: List<&2, U32>, +N: List<&2, U32>,
