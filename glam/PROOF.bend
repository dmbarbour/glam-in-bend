  +hbL: {RG.none.in(L, IM.ix.branches(I)) == True{} : Bool}, +hFN: {RG.sub(F, N) == True{} : Bool}, +hFL: {RG.none.in(F, L) == True{} : Bool}) ->
  {Bool.or(st, IM.ix.offr(I, s, d, (r + 1 : U32))) && (Bool.or(st, KMd.nodes.off(F, d, (r + 1 : U32))) && Bool.or(st, Bool.not(Nat.is_eq(AD.slot((r + 1 : U32), d), AD.slot(P.at_fh(), d))))) == True{} : Bool}:
  match st:
    case True{}:
      {==}
    case False{}:
      and_intro(IM.ix.offr(I, s, d, (r + 1 : U32)), KMd.nodes.off(F, d, (r + 1 : U32)) && Bool.not(Nat.is_eq(AD.slot((r + 1 : U32), d), AD.slot(P.at_fh(), d))),
        offr_ix(I, r, L, d, N, s, hst, hpo, hpk, hsL, hIN, hlL, hbL),
        and_intro(KMd.nodes.off(F, d, (r + 1 : U32)), Bool.not(Nat.is_eq(AD.slot((r + 1 : U32), d), AD.slot(P.at_fh(), d))), nodesoff_po(F, r, L, d, N, hst, hpo, hFN, hFL),
          nf2(Nat.is_eq(AD.slot((r + 1 : U32), d), AD.slot(P.at_fh(), d)), opf(r, d, P.at_fh(), hst, po_fh(N, r, L, d, hpo)))))


