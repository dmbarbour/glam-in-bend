    case Nil{}:
      {==}
    case Con{+n, +r}:
      +D = lay_pair(N, d, x, n, hN, hx, and_l(RG.has(N, n), RG.sub(r, N), hs), ueq_ne(n, x, or_false_l(U32.is_eq(n, x), RG.has(r, x), hxn)))
      and_intro(KMd.off.words(KMd.nw(n), d, (x + 2 : U32)), KMd.nodes.off(r, d, (x + 2 : U32)), and_l(KMd.off.words(KMd.nw(n), d, (x + 2 : U32)), KMd.off.words(KMd.nw(n), d, (x + 3 : U32)), and_r(KMd.off.words(KMd.nw(n), d, (x + 1 : U32)), KMd.off.words(KMd.nw(n), d, (x + 2 : U32)) && KMd.off.words(KMd.nw(n), d, (x + 3 : U32)), and_r(KMd.off.words(KMd.nw(n), d, x), KMd.off.words(KMd.nw(n), d, (x + 1 : U32)) && (KMd.off.words(KMd.nw(n), d, (x + 2 : U32)) && KMd.off.words(KMd.nw(n), d, (x + 3 : U32))), D))),
        nodesoff_of2(r, N, d, x, hN, and_r(RG.has(N, n), RG.sub(r, N), hs), hx, or_false_r(U32.is_eq(n, x), RG.has(r, x), hxn)))

# the head off the words 1 of nodes laid out
def ones_fh(L: List<&2, U32>, +N: List<&2, U32>, +d: Nat, +hs: {RG.sub(L, N) == True{} : Bool}, +hN: {RG.layout(N, d) == True{} : Bool}) -> {ones(L, d, P.at_fh()) == True{} : Bool}:
  match L:
    case Nil{}:
      {==}
    case Con{+m, +r}:
      and_intro(Bool.not(Nat.is_eq(AD.slot(P.at_fh(), d), AD.slot((m + 1 : U32), d))), ones(r, d, P.at_fh()), nf2(Nat.is_eq(AD.slot(P.at_fh(), d), AD.slot((m + 1 : U32), d)), XP.off1(m, d, P.at_fh(), lay_head(N, d, m, hN, and_l(RG.has(N, m), RG.sub(r, N), hs)))),
        ones_fh(r, N, d, and_r(RG.has(N, m), RG.sub(r, N), hs), hN))

# a node b of N none of L's: its word 0 off their words 1
def ones_b0(L: List<&2, U32>, +N: List<&2, U32>, +d: Nat, +b: U32, +hs: {RG.sub(L, N) == True{} : Bool}, +hN: {RG.layout(N, d) == True{} : Bool}, +hbN: {RG.has(N, b) == True{} : Bool}, +hbL: {RG.has(L, b) == False{} : Bool}) ->
  {ones(L, d, b) == True{} : Bool}:
  match L:
    case Nil{}:
