def ones_clo(L: List<&2, U32>, +N: List<&2, U32>, +d: Nat, +t: IM.Tr, +x: U32, +k: U32, +s: U32, +hs: {RG.sub(L, N) == True{} : Bool}, +hN: {RG.layout(N, d) == True{} : Bool}, +hsN: {RG.has(N, s) == True{} : Bool},
  +htN: {RG.sub(IM.tr.nodes(t), N) == True{} : Bool}, +hLb: {RG.none.in(L, IM.tr.branches(t)) == True{} : Bool}, +hx: {IM.tr.look(t, k) == Some{x} : Maybe<&2, U32>}, +hne: {U32.is_eq(IM.tr.addr(t), x) == False{} : Bool}) -> {ones(L, d, XP.cut.lo(IM.tr.cutat(t, x, k, (s + 3 : U32)))) == True{} : Bool}:
