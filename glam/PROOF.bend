  +hft: {AD.full(U32, LAT.fromT(U32, t0), d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool}, +hN: {RG.layout(N, d) == True{} : Bool}, +hB: {RG.bases(N) == True{} : Bool},
  +hp: {RG.px.ok(AD.view(U32, LAT.fromT(U32, t0)), d, s, I, Con{x, ps}, L, IM.ix.take(I, b, F), N) == True{} : Bool}, +ha: {IM.ix.look(I, src) == None{} : Maybe<&2, U32>}) ->
  {RG.px.ok(AD.view(U32, RG.words(R.cursor(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, s, x, src, neg))), d, s, IM.ix.put(I, x, src, b), ps, L, F, N) && AD.full(U32, RG.words(R.cursor(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, s, x, src, neg)), d) == True{} : Bool}:
  match I:
    case IM.Ept{}:
      cpx.ept(t0, ta, d, s, ps, L, F, N, x, src, neg, b, hft, hd32, hN, hB, hp, ha)
    case IM.Has{+t}:
      cpx.has(t, t0, ta, d, s, ps, L, F, N, x, src, neg, b, hft, hd32, hN, hB, hp, ha)

def cpx.m(-w: Array<U32>, -a: Array<V.Val>, +d: Nat, +s: U32, +I: IM.Ix, +ps: List<&2, U32>, +L: List<&2, U32>, +F: List<&2, U32>, +N: List<&2, U32>, +x: U32, +src: U32, +neg: Bool, +b: U32,
  hf: {AD.full(U32, w, d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool}, +hN: {RG.layout(N, d) == True{} : Bool}, +hB: {RG.bases(N) == True{} : Bool},
  hp: {RG.px.ok(AD.view(U32, w), d, s, I, Con{x, ps}, L, IM.ix.take(I, b, F), N) == True{} : Bool}, +ha: {IM.ix.look(I, src) == None{} : Maybe<&2, U32>}, m: LAT.Mirror(U32, w), ma: LAT.Mirror(V.Val, a)) ->
  {RG.px.ok(AD.view(U32, RG.words(R.cursor(P.H{KM.MG{w}, a}, s, x, src, neg))), d, s, IM.ix.put(I, x, src, b), ps, L, F, N) && AD.full(U32, RG.words(R.cursor(P.H{KM.MG{w}, a}, s, x, src, neg)), d) == True{} : Bool}:
  (+t0, +e) = m
  (+ta, +ea) = ma
  +hft = LAP.full_t(U32, w, t0, d, e, hf)
  +ew = Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, e)
  %e : {RG.px.ok(AD.view(U32, RG.words(R.cursor(P.H{KM.MG{_}, a}, s, x, src, neg))), d, s, IM.ix.put(I, x, src, b), ps, L, F, N) && AD.full(U32, RG.words(R.cursor(P.H{KM.MG{_}, a}, s, x, src, neg)), d) == True{} : Bool}
  %ea : {RG.px.ok(AD.view(U32, RG.words(R.cursor(P.H{KM.MG{LAT.fromT(U32, t0)}, _}, s, x, src, neg))), d, s, IM.ix.put(I, x, src, b), ps, L, F, N) && AD.full(U32, RG.words(R.cursor(P.H{KM.MG{LAT.fromT(U32, t0)}, _}, s, x, src, neg)), d) == True{} : Bool}
  cpx.k(I, t0, ta, d, s, ps, L, F, N, x, src, neg, b, hft, hd32, hN, hB, LAB.subst(Array<U32>, q => {RG.px.ok(AD.view(U32, q), d, s, I, Con{x, ps}, L, IM.ix.take(I, b, F), N) == True{} : Bool}, w, LAT.fromT(U32, t0), ew, hp), ha)

def Laws.cursor_pend(w, a, d, s, I, ps, L, F, N, x, src, neg, b, hf, hd32, hN, hB, hp, ha):
  cpx.m(w, a, d, s, I, ps, L, F, N, x, src, neg, b, hf, hd32, hN, hB, hp, ha, LAT.mirror(U32, w), LAT.mirror(V.Val, a))

# The pending placeholders over the index: a join
# ===============================================

def sub_appl(xs: List<&2, U32>, +ys: List<&2, U32>) -> {RG.sub(xs, List.append(&2, U32, xs, ys)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+z, +t}:
      and_intro(RG.has(Con{z, List.append(&2, U32, t, ys)}, z), RG.sub(t, Con{z, List.append(&2, U32, t, ys)}), has_head(z, List.append(&2, U32, t, ys)), sub_cons_r(t, z, List.append(&2, U32, t, ys), sub_appl(t, ys)))

def sub_appr(xs: List<&2, U32>, +ys: List<&2, U32>) -> {RG.sub(ys, List.append(&2, U32, xs, ys)) == True{} : Bool}:
  match xs:
    case Nil{}:
      sub_refl(ys)
    case Con{+z, +t}:
      sub_cons_r(ys, z, List.append(&2, U32, t, ys), sub_appr(t, ys))

# none of L the head of a list none of L's
def none_head(L: List<&2, U32>, +b: U32, +X: List<&2, U32>, +h: {RG.none.in(L, Con{b, X}) == True{} : Bool}) -> {RG.has(L, b) == False{} : Bool}:
  match L:
    case Nil{}:
      {==}
    case Con{+z, +r}:
      +hz = MB.eq_false_of_not_eq_true(RG.has(Con{b, X}, z), and_l(Bool.not(RG.has(Con{b, X}, z)), RG.none.in(r, Con{b, X}), h))
      or_ff(U32.is_eq(z, b), RG.has(r, b), ueq_ne(b, z, or_false_l(U32.is_eq(b, z), RG.has(X, z), hz)), none_head(r, b, X, and_r(Bool.not(RG.has(Con{b, X}, z)), RG.none.in(r, Con{b, X}), h)))

# a list's members each x, y, or of L without both
def sub_back.k(+ex: Bool, +ey: Bool, +z: U32, +L: List<&2, U32>, +x: U32, +y: U32, +hex: {U32.is_eq(x, z) == ex : Bool}, +hey: {U32.is_eq(y, z) == ey : Bool}, +hz: {RG.has(L, z) == True{} : Bool}) ->
  {RG.has(Con{x, Con{y, RG.without(RG.without(L, x), y)}}, z) == True{} : Bool}:
  match ex:
    case True{}:
      %Equal.sym(Bool, U32.is_eq(x, z), True{}, hex) : {Bool.or(_, RG.has(Con{y, RG.without(RG.without(L, x), y)}, z)) == True{} : Bool}
      {==}
    case False{}:
      match ey:
        case True{}:
          has_cons(x, Con{y, RG.without(RG.without(L, x), y)}, z, ME.subst(Bool, q => {Bool.or(q, RG.has(RG.without(RG.without(L, x), y), z)) == True{} : Bool}, True{}, U32.is_eq(y, z), Equal.sym(Bool, U32.is_eq(y, z), True{}, hey), {==}))
        case False{}:
          has_cons(x, Con{y, RG.without(RG.without(L, x), y)}, z, has_cons(y, RG.without(RG.without(L, x), y), z, has_without(RG.without(L, x), y, z, hey, has_without(L, x, z, hex, hz))))

def sub_back(K: List<&2, U32>, +L: List<&2, U32>, +x: U32, +y: U32, +hK: {RG.sub(K, L) == True{} : Bool}) -> {RG.sub(K, Con{x, Con{y, RG.without(RG.without(L, x), y)}}) == True{} : Bool}:
  match K:
    case Nil{}:
      {==}
    case Con{+z, +r}:
      and_intro(RG.has(Con{x, Con{y, RG.without(RG.without(L, x), y)}}, z), RG.sub(r, Con{x, Con{y, RG.without(RG.without(L, x), y)}}), sub_back.k(U32.is_eq(x, z), U32.is_eq(y, z), z, L, x, y, {==}, {==}, and_l(RG.has(L, z), RG.sub(r, L), hK)),
        sub_back(r, L, x, y, and_r(RG.has(L, z), RG.sub(r, L), hK)))

# none of a part of L none of M's, nor of a part of M
def none_mem.k(+e: Bool, +y: U32, +t: List<&2, U32>, +M: List<&2, U32>, +z: U32, +he: {U32.is_eq(y, z) == e : Bool}, +hn: {RG.none.in(Con{y, t}, M) == True{} : Bool}, +hz: {Bool.or(U32.is_eq(y, z), RG.has(t, z)) == True{} : Bool},
  ih: {RG.has(t, z) == True{} : Bool} -> {RG.has(M, z) == False{} : Bool}) -> {RG.has(M, z) == False{} : Bool}:
  match e:
    case True{}:
      %MS.u32_eq_of_is_eq(y, z, he) : {RG.has(M, _) == False{} : Bool}
      MB.eq_false_of_not_eq_true(RG.has(M, y), and_l(Bool.not(RG.has(M, y)), RG.none.in(t, M), hn))
    case False{}:
      ih(XP.ort_r(U32.is_eq(y, z), RG.has(t, z), he, hz))

def none_mem(L: List<&2, U32>, +M: List<&2, U32>, +z: U32, +hn: {RG.none.in(L, M) == True{} : Bool}, +hz: {RG.has(L, z) == True{} : Bool}) -> {RG.has(M, z) == False{} : Bool}:
  match L:
    case Nil{}:
      Empty.absurd({RG.has(M, z) == False{} : Bool}, MB.false_ne_true()(hz))
    case Con{+y, +t}:
      none_mem.k(U32.is_eq(y, z), y, t, M, z, {==}, hn, hz, hzt => none_mem(t, M, z, and_r(Bool.not(RG.has(M, y)), RG.none.in(t, M), hn), hzt))

# the leaves of a tree among its nodes
def none_subl(K: List<&2, U32>, +L: List<&2, U32>, +M: List<&2, U32>, +hs: {RG.sub(K, L) == True{} : Bool}, +hn: {RG.none.in(L, M) == True{} : Bool}) -> {RG.none.in(K, M) == True{} : Bool}:
  match K:
    case Nil{}:
      {==}
    case Con{+z, +r}:
      and_intro(Bool.not(RG.has(M, z)), RG.none.in(r, M), nf2(RG.has(M, z), none_mem(L, M, z, hn, and_l(RG.has(L, z), RG.sub(r, L), hs))), none_subl(r, L, M, and_r(RG.has(L, z), RG.sub(r, L), hs), hn))



def ln.k(+e: Bool, +l: IM.Tr, +r: IM.Tr, +z: U32, +he: {RG.has(IM.tr.leaves(l), z) == e : Bool}, +h: {Bool.or(RG.has(IM.tr.leaves(l), z), RG.has(IM.tr.leaves(r), z)) == True{} : Bool},
  ihl: {RG.has(IM.tr.leaves(l), z) == True{} : Bool} -> {RG.has(IM.tr.nodes(l), z) == True{} : Bool}, ihr: {RG.has(IM.tr.leaves(r), z) == True{} : Bool} -> {RG.has(IM.tr.nodes(r), z) == True{} : Bool}) ->
  {RG.has(List.append(&2, U32, IM.tr.nodes(l), IM.tr.nodes(r)), z) == True{} : Bool}:
  match e:
    case True{}:
      XP.has_app_l(IM.tr.nodes(l), IM.tr.nodes(r), z, ihl(he))
    case False{}:
      XP.has_app_r(IM.tr.nodes(l), IM.tr.nodes(r), z, ihr(XP.ort_r(RG.has(IM.tr.leaves(l), z), RG.has(IM.tr.leaves(r), z), he, h)))

def leaf_node(t: IM.Tr, +z: U32, +h: {RG.has(IM.tr.leaves(t), z) == True{} : Bool}) -> {RG.has(IM.tr.nodes(t), z) == True{} : Bool}:
  match t:
    case IM.Lf{+y, +ky}:
      h
    case IM.Br{+b, +i, +l, +r}:
      has_cons(b, List.append(&2, U32, IM.tr.nodes(l), IM.tr.nodes(r)), z, ln.k(RG.has(IM.tr.leaves(l), z), l, r, z, {==},
        Equal.trans(Bool, Bool.or(RG.has(IM.tr.leaves(l), z), RG.has(IM.tr.leaves(r), z)), RG.has(List.append(&2, U32, IM.tr.leaves(l), IM.tr.leaves(r)), z), True{},
          Equal.sym(Bool, RG.has(List.append(&2, U32, IM.tr.leaves(l), IM.tr.leaves(r)), z), Bool.or(RG.has(IM.tr.leaves(l), z), RG.has(IM.tr.leaves(r), z)), XP.has_app(IM.tr.leaves(l), IM.tr.leaves(r), z)), h),
        hl => leaf_node(l, z, hl), hr => leaf_node(r, z, hr)))


# what the port r a live node faces asks of a tracked node n
def po_at.k(+e: Bool, +m: U32, +t: List<&2, U32>, +r: U32, +L: List<&2, U32>, +d: Nat, +n: U32, +he: {U32.is_eq(m, n) == e : Bool},
  +h: {RG.po.all(r, L, d, Con{m, t}) == True{} : Bool}, +hn: {Bool.or(U32.is_eq(m, n), RG.has(t, n)) == True{} : Bool}, ih: {RG.has(t, n) == True{} : Bool} -> {RG.po.n(r, L, d, n) == True{} : Bool}) -> {RG.po.n(r, L, d, n) == True{} : Bool}:
  match e:
    case True{}:
      %MS.u32_eq_of_is_eq(m, n, he) : {RG.po.n(r, L, d, _) == True{} : Bool}
      and_l(RG.po.n(r, L, d, m), RG.po.all(r, L, d, t), h)
    case False{}:
      ih(XP.ort_r(U32.is_eq(m, n), RG.has(t, n), he, hn))

def po_at(N: List<&2, U32>, +r: U32, +L: List<&2, U32>, +d: Nat, +n: U32, +h: {RG.po.all(r, L, d, N) == True{} : Bool}, +hn: {RG.has(N, n) == True{} : Bool}) -> {RG.po.n(r, L, d, n) == True{} : Bool}:
  match N:
    case Nil{}:
      Empty.absurd({RG.po.n(r, L, d, n) == True{} : Bool}, MB.false_ne_true()(hn))
    case Con{+m, +t}:
      po_at.k(U32.is_eq(m, n), m, t, r, L, d, n, {==}, h, hn, hnt => po_at(t, r, L, d, n, and_r(RG.po.n(r, L, d, m), RG.po.all(r, L, d, t), h), hnt))

def po_fh(N: List<&2, U32>, +r: U32, +L: List<&2, U32>, +d: Nat, +h: {RG.po.all(r, L, d, N) == True{} : Bool}) -> {KMd.off.port(d, r, P.at_fh()) == True{} : Bool}:
  match N:
    case Nil{}:
      h
    case Con{+m, +t}:
      po_fh(t, r, L, d, and_r(RG.po.n(r, L, d, m), RG.po.all(r, L, d, t), h))

# a non-static port's off.port as its link word, r + 1, off j
def opf(+r: U32, +d: Nat, +j: U32, +hst: {P.is_static(r) == False{} : Bool}, +h: {KMd.off.port(d, r, j) == True{} : Bool}) -> {Nat.is_eq(AD.slot((r + 1 : U32), d), AD.slot(j, d)) == False{} : Bool}:
  not_true(Nat.is_eq(AD.slot((r + 1 : U32), d), AD.slot(j, d)), ME.subst(Bool, q => {KMd.off.lw(KMd.lw.k(q, r), d, j) == True{} : Bool}, P.is_static(r), False{}, hst, h))

# flipped, as KMd.off.words reads it
def opw(+r: U32, +d: Nat, +j: U32, +hst: {P.is_static(r) == False{} : Bool}, +h: {KMd.off.port(d, r, j) == True{} : Bool}) -> {Bool.not(Nat.is_eq(AD.slot(j, d), AD.slot((r + 1 : U32), d))) == True{} : Bool}:
  nf2(Nat.is_eq(AD.slot(j, d), AD.slot((r + 1 : U32), d)), neq_comm2(AD.slot((r + 1 : U32), d), AD.slot(j, d), opf(r, d, j, hst, h)))

# a node n of N not live: r's link word off its four words
def ow_po(+r: U32, +L: List<&2, U32>, +d: Nat, +N: List<&2, U32>, +n: U32, +hst: {P.is_static(r) == False{} : Bool}, +hpo: {RG.po.all(r, L, d, N) == True{} : Bool},
  +hn: {RG.has(N, n) == True{} : Bool}, +hnl: {RG.has(L, n) == False{} : Bool}) -> {KMd.off.words(KMd.nw(n), d, (r + 1 : U32)) == True{} : Bool}:
  +hp = po_at(N, r, L, d, n, hpo, hn)
  +hw = ME.subst(Bool, q => {Bool.or(q, KMd.off.port(d, r, (n + 1 : U32)) && (KMd.off.port(d, r, (n + 2 : U32)) && KMd.off.port(d, r, (n + 3 : U32)))) == True{} : Bool}, RG.has(L, n), False{}, hnl, and_r(KMd.off.port(d, r, n), Bool.or(RG.has(L, n), KMd.off.port(d, r, (n + 1 : U32)) && (KMd.off.port(d, r, (n + 2 : U32)) && KMd.off.port(d, r, (n + 3 : U32)))), hp))
  and_intro(Bool.not(Nat.is_eq(AD.slot(n, d), AD.slot((r + 1 : U32), d))), Bool.not(Nat.is_eq(AD.slot((n + 1 : U32), d), AD.slot((r + 1 : U32), d))) && (Bool.not(Nat.is_eq(AD.slot((n + 2 : U32), d), AD.slot((r + 1 : U32), d))) && (Bool.not(Nat.is_eq(AD.slot((n + 3 : U32), d), AD.slot((r + 1 : U32), d))) && True{})),
    opw(r, d, n, hst, and_l(KMd.off.port(d, r, n), Bool.or(RG.has(L, n), KMd.off.port(d, r, (n + 1 : U32)) && (KMd.off.port(d, r, (n + 2 : U32)) && KMd.off.port(d, r, (n + 3 : U32)))), hp)),
    and_intro(Bool.not(Nat.is_eq(AD.slot((n + 1 : U32), d), AD.slot((r + 1 : U32), d))), Bool.not(Nat.is_eq(AD.slot((n + 2 : U32), d), AD.slot((r + 1 : U32), d))) && (Bool.not(Nat.is_eq(AD.slot((n + 3 : U32), d), AD.slot((r + 1 : U32), d))) && True{}),
      opw(r, d, (n + 1 : U32), hst, and_l(KMd.off.port(d, r, (n + 1 : U32)), KMd.off.port(d, r, (n + 2 : U32)) && KMd.off.port(d, r, (n + 3 : U32)), hw)),
      and_intro(Bool.not(Nat.is_eq(AD.slot((n + 2 : U32), d), AD.slot((r + 1 : U32), d))), Bool.not(Nat.is_eq(AD.slot((n + 3 : U32), d), AD.slot((r + 1 : U32), d))) && True{},
        opw(r, d, (n + 2 : U32), hst, and_l(KMd.off.port(d, r, (n + 2 : U32)), KMd.off.port(d, r, (n + 3 : U32)), and_r(KMd.off.port(d, r, (n + 1 : U32)), KMd.off.port(d, r, (n + 2 : U32)) && KMd.off.port(d, r, (n + 3 : U32)), hw))),
        and_intro(Bool.not(Nat.is_eq(AD.slot((n + 3 : U32), d), AD.slot((r + 1 : U32), d))), True{},
          opw(r, d, (n + 3 : U32), hst, and_r(KMd.off.port(d, r, (n + 2 : U32)), KMd.off.port(d, r, (n + 3 : U32)), and_r(KMd.off.port(d, r, (n + 1 : U32)), KMd.off.port(d, r, (n + 2 : U32)) && KMd.off.port(d, r, (n + 3 : U32)), hw))), {==}))))

# the free list's first nodes, none live: r's link word off all their words
def nodesoff_po(F: List<&2, U32>, +r: U32, +L: List<&2, U32>, +d: Nat, +N: List<&2, U32>, +hst: {P.is_static(r) == False{} : Bool}, +hpo: {RG.po.all(r, L, d, N) == True{} : Bool},
  +hFN: {RG.sub(F, N) == True{} : Bool}, +hFL: {RG.none.in(F, L) == True{} : Bool}) -> {KMd.nodes.off(F, d, (r + 1 : U32)) == True{} : Bool}:
  match F:
    case Nil{}:
      {==}
    case Con{+n, +t}:
      and_intro(KMd.off.words(KMd.nw(n), d, (r + 1 : U32)), KMd.nodes.off(t, d, (r + 1 : U32)),
        ow_po(r, L, d, N, n, hst, hpo, and_l(RG.has(N, n), RG.sub(t, N), hFN), MB.eq_false_of_not_eq_true(RG.has(L, n), and_l(Bool.not(RG.has(L, n)), RG.none.in(t, L), hFL))),
        nodesoff_po(t, r, L, d, N, hst, hpo, and_r(RG.has(N, n), RG.sub(t, N), hFN), and_r(Bool.not(RG.has(L, n)), RG.none.in(t, L), hFL)))

# the link's write at r + 1 off the words the realization reads
def offr_po(t: IM.Tr, +r: U32, +L: List<&2, U32>, +d: Nat, +N: List<&2, U32>, +hst: {P.is_static(r) == False{} : Bool}, +hpo: {RG.po.all(r, L, d, N) == True{} : Bool},
  +hpk: {RG.port.ok(L, d, r) == True{} : Bool}, +hsN: {RG.sub(IM.tr.nodes(t), N) == True{} : Bool}, +hsL: {RG.sub(IM.tr.leaves(t), L) == True{} : Bool}, +hbL: {RG.none.in(L, IM.tr.branches(t)) == True{} : Bool}) -> {IM.tr.offr(t, d, (r + 1 : U32)) == True{} : Bool}:
  match t:
