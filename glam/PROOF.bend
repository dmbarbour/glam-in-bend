def crossL_sub(m: Maybe<&2, U32>, +x: U32, +L: List<&2, U32>) -> {RG.sub(RG.cross.L(m, x, L), L) == True{} : Bool}:
  match m:
    case Some{+y}:
      sub_trans(RG.without(RG.without(L, x), y), RG.without(L, x), L, sub_without(RG.without(L, x), y), sub_without(L, x))
    case None{}:
      sub_refl(L)

