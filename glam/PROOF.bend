def notin_l(+A: List<&2, U32>, +B: List<&2, U32>, +x: U32, +h: {Bool.and(Bool.not(RG.has(A, x)), Bool.not(RG.has(B, x))) == True{} : Bool}) -> {RG.has(A, x) == False{} : Bool}:
