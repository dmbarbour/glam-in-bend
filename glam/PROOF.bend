def Laws.join_pend(w, a, d, s, I, ps, L, F, N, x, y, kx, ky, hf, hd32, hN, hB, hp, hx, hy):
  jnpx.m(w, a, d, s, I, ps, L, F, N, x, y, kx, ky, hf, hd32, hN, hB, hp, hx, hy, LAT.mirror(U32, w), LAT.mirror(V.Val, a))

# The ports the live nodes face after a copy's crossings, among those faced
