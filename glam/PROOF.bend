  (+ta, +ea) = ma
  +hft = LAP.full_t(U32, w, t0, d, e, hf)
  +ew = Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, e)
  %e : {Pair.snd(P.H, U32, P.rd(R.join(P.H{KM.MG{_}, a}, x, y), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{_}, a}, j)) : U32}
  %ea : {Pair.snd(P.H, U32, P.rd(R.join(P.H{KM.MG{LAT.fromT(U32, t0)}, _}, x, y), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{LAT.fromT(U32, t0)}, _}, j)) : U32}
  jnk.k(I, t0, ta, d, s, ps, L, F, N, x, y, kx, ky, hft, hd32, hN, hB, LAB.subst(Array<U32>, qq => {RG.px.ok(AD.view(U32, qq), d, s, I, ps, L, F, N) == True{} : Bool}, w, LAT.fromT(U32, t0), ew, hp), hx, hy, j, hj, hjh,
    LAB.subst(Array<U32>, qq => {KMd.off.port(d, KMd.word(AD.view(U32, qq), d, (x + 1 : U32)), j) == True{} : Bool}, w, LAT.fromT(U32, t0), ew, hju), LAB.subst(Array<U32>, qq => {KMd.off.port(d, KMd.word(AD.view(U32, qq), d, (y + 1 : U32)), j) == True{} : Bool}, w, LAT.fromT(U32, t0), ew, hjw))

