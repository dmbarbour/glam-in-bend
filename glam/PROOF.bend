# The ring exact (cells-freeze.nested.host.ring.exact)

def sub_cons_r(ys: List<&2, U32>, +z: U32, +M: List<&2, U32>, +h: {RG.sub(ys, M) == True{} : Bool}) -> {RG.sub(ys, Con{z, M}) == True{} : Bool}:
