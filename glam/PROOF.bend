      %Equal.sym(Bool, Nat.is_eq(AD.slot((r + 1 : U32), d), AD.slot(j, d)), False{}, h) : {Bool.not(_) == True{} : Bool}
      {==}

def off_port_of(+d: Nat, +r: U32, +j: U32, +h: {Nat.is_eq(AD.slot((r + 1 : U32), d), AD.slot(j, d)) == False{} : Bool}) -> {KMd.off.port(d, r, j) == True{} : Bool}:
