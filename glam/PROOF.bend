def Laws.leave_pend(w, a, d, s, I, ps, L, F, N, p, c, k, hf, hd32, hN, hB, hp, hc, hpo, hpk):
  lpx.m(w, a, d, s, I, ps, L, F, N, p, c, k, hf, hd32, hN, hB, hp, hc, hpo, hpk, LAT.mirror(U32, w), LAT.mirror(V.Val, a))

# The pending placeholders over the index: a join of two cursors
# ==============================================================
#
# cells-freeze.sharing.cursors.index.ring.leave: join_pend, the link as
# join1_pend's, x's removal, then join1_pend's removal of y and frees
# (jrm) over the index without x, its parent pushed on the free list.

# what the free list after x's removal holds, the removal's parent m if any
def jnpl(+m: Maybe<&2, U32>, +t: IM.Tr, +d: Nat, +s: U32, +L: List<&2, U32>, +F: List<&2, U32>, +N: List<&2, U32>, +x: U32, +y: U32, +kx: U32,
  +hbr: {RG.none.in(L, IM.tr.branches(t)) == True{} : Bool}, +hfn: {RG.none.in(F, Con{s, IM.tr.nodes(t)}) == True{} : Bool}, +hFL: {RG.none.in(F, L) == True{} : Bool}, +hFN: {RG.sub(F, N) == True{} : Bool}, +hFd: {RG.distinct(F) == True{} : Bool},
  +hyF: {RG.has(F, y) == False{} : Bool}, +hxF: {RG.has(F, x) == False{} : Bool}, +hIN: {RG.sub(IM.tr.nodes(t), N) == True{} : Bool}, +hst: {RG.has(IM.tr.nodes(t), s) == False{} : Bool}, +hyB: {RG.has(IM.tr.branches(t), y) == False{} : Bool}, +hxB: {RG.has(IM.tr.branches(t), x) == False{} : Bool},
  +hlay: {IM.ix.lay(IM.Has{t}, s, d) == True{} : Bool}, +hx: {IM.ix.look(IM.Has{t}, kx) == Some{x} : Maybe<&2, U32>}, +he: {IM.ix.par(IM.Has{t}, x, kx) == m : Maybe<&2, U32>}) -> {RG.none.in(IM.mb.cons(m, F), Con{s, IM.ix.nodes(IM.ix.del(IM.Has{t}, x, kx))}) && (RG.none.in(IM.mb.cons(m, F), L) && (RG.sub(IM.mb.cons(m, F), N) && (RG.distinct(IM.mb.cons(m, F)) && (Bool.not(RG.has(IM.mb.cons(m, F), y)) && Bool.not(RG.has(IM.mb.cons(m, F), x)))))) == True{} : Bool}:
  match m:
    case Some{+pp}:
      +hpb = XL.par_branch(IM.Has{t}, x, kx, pp, he)
      +hpn = sub_has(IM.tr.branches(t), IM.tr.nodes(t), pp, br_sub(t), hpb)
      +hpN = sub_has(IM.tr.nodes(t), N, pp, hIN, hpn)
      +hpL = none_notin(L, IM.tr.branches(t), pp, hbr, hpb)
      +hpF = none_notin(F, Con{s, IM.tr.nodes(t)}, pp, hfn, has_cons(s, IM.tr.nodes(t), pp, hpn))
      +hpy = nhas(IM.tr.branches(t), pp, y, hpb, hyB)
      +hpx = nhas(IM.tr.branches(t), pp, x, hpb, hxB)
      +hps = nhas(IM.tr.nodes(t), pp, s, hpn, hst)
