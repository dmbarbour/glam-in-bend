  +hre = and_l(IM.ix.real(AD.view(U32, LAT.fromT(U32, t0)), d, s, I), IM.ix.inv(I) && (IM.ix.lay(I, s, d) && (RG.sub(Con{s, IM.ix.leaves(I)}, L) && (RG.sub(Con{x, ps}, L) && (RG.none.in(Con{x, ps}, Con{s, IM.ix.nodes(I)}) && (RG.distinct(Con{x, ps}) && (RG.none.in(L, IM.ix.branches(I)) && (KMd.chain(RG.cx.F0(IM.ix.look(I, far), I, b, F), AD.view(U32, LAT.fromT(U32, t0)), d, KMd.word(AD.view(U32, LAT.fromT(U32, t0)), d, P.at_fh())) && (RG.distinct(RG.cx.F0(IM.ix.look(I, far), I, b, F)) && (RG.none.in(RG.cx.F0(IM.ix.look(I, far), I, b, F), Con{s, IM.ix.nodes(I)}) && (RG.none.in(RG.cx.F0(IM.ix.look(I, far), I, b, F), L) && (RG.sub(L, N) && (RG.sub(RG.cx.F0(IM.ix.look(I, far), I, b, F), N) && (RG.sub(IM.ix.nodes(I), N) && (RG.faces(L, AD.view(U32, LAT.fromT(U32, t0)), d, L) && (RG.px.off(L, AD.view(U32, LAT.fromT(U32, t0)), d, L, N) && RG.px.tw(L, AD.view(U32, LAT.fromT(U32, t0)), d, L)))))))))))))))), hp)
  +hiv = and_l(IM.ix.inv(I), IM.ix.lay(I, s, d) && (RG.sub(Con{s, IM.ix.leaves(I)}, L) && (RG.sub(Con{x, ps}, L) && (RG.none.in(Con{x, ps}, Con{s, IM.ix.nodes(I)}) && (RG.distinct(Con{x, ps}) && (RG.none.in(L, IM.ix.branches(I)) && (KMd.chain(RG.cx.F0(IM.ix.look(I, far), I, b, F), AD.view(U32, LAT.fromT(U32, t0)), d, KMd.word(AD.view(U32, LAT.fromT(U32, t0)), d, P.at_fh())) && (RG.distinct(RG.cx.F0(IM.ix.look(I, far), I, b, F)) && (RG.none.in(RG.cx.F0(IM.ix.look(I, far), I, b, F), Con{s, IM.ix.nodes(I)}) && (RG.none.in(RG.cx.F0(IM.ix.look(I, far), I, b, F), L) && (RG.sub(L, N) && (RG.sub(RG.cx.F0(IM.ix.look(I, far), I, b, F), N) && (RG.sub(IM.ix.nodes(I), N) && (RG.faces(L, AD.view(U32, LAT.fromT(U32, t0)), d, L) && (RG.px.off(L, AD.view(U32, LAT.fromT(U32, t0)), d, L, N) && RG.px.tw(L, AD.view(U32, LAT.fromT(U32, t0)), d, L))))))))))))))), and_r(IM.ix.real(AD.view(U32, LAT.fromT(U32, t0)), d, s, I), IM.ix.inv(I) && (IM.ix.lay(I, s, d) && (RG.sub(Con{s, IM.ix.leaves(I)}, L) && (RG.sub(Con{x, ps}, L) && (RG.none.in(Con{x, ps}, Con{s, IM.ix.nodes(I)}) && (RG.distinct(Con{x, ps}) && (RG.none.in(L, IM.ix.branches(I)) && (KMd.chain(RG.cx.F0(IM.ix.look(I, far), I, b, F), AD.view(U32, LAT.fromT(U32, t0)), d, KMd.word(AD.view(U32, LAT.fromT(U32, t0)), d, P.at_fh())) && (RG.distinct(RG.cx.F0(IM.ix.look(I, far), I, b, F)) && (RG.none.in(RG.cx.F0(IM.ix.look(I, far), I, b, F), Con{s, IM.ix.nodes(I)}) && (RG.none.in(RG.cx.F0(IM.ix.look(I, far), I, b, F), L) && (RG.sub(L, N) && (RG.sub(RG.cx.F0(IM.ix.look(I, far), I, b, F), N) && (RG.sub(IM.ix.nodes(I), N) && (RG.faces(L, AD.view(U32, LAT.fromT(U32, t0)), d, L) && (RG.px.off(L, AD.view(U32, LAT.fromT(U32, t0)), d, L, N) && RG.px.tw(L, AD.view(U32, LAT.fromT(U32, t0)), d, L)))))))))))))))), hp))
