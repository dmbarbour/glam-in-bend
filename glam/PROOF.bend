# the port a node of K faces among Fp, where each of K faces one
def fi_at(K: List<&2, U32>, +v: List<&2, U32>, +d: Nat, +Fp: List<&2, U32>, +z: U32, +h: {faced.in(K, v, d, Fp) == True{} : Bool}, hz: {RG.has(K, z) == True{} : Bool}) -> {fin.m(List.get(&2, U32, v, AD.slot((z + 1 : U32), d)), d, Fp) == True{} : Bool}:
  match K:
    case Nil{}:
      Empty.absurd({fin.m(List.get(&2, U32, v, AD.slot((z + 1 : U32), d)), d, Fp) == True{} : Bool}, MB.false_ne_true()(hz))
    case Con{+m, +r}:
      or_cases(U32.is_eq(m, z), RG.has(r, z), fin.m(List.get(&2, U32, v, AD.slot((z + 1 : U32), d)), d, Fp), hz,
        q => ME.subst(U32, kk => {fin.m(List.get(&2, U32, v, AD.slot((kk + 1 : U32), d)), d, Fp) == True{} : Bool}, m, z, MS.u32_eq_of_is_eq(m, z, q), and_l(fin.m(List.get(&2, U32, v, AD.slot((m + 1 : U32), d)), d, Fp), faced.in(r, v, d, Fp), h)),
        q => fi_at(r, v, d, Fp, z, and_r(fin.m(List.get(&2, U32, v, AD.slot((m + 1 : U32), d)), d, Fp), faced.in(r, v, d, Fp), h), q))

# a port of Fp, its link word off j where every one of Fp's is
def ops_at(Fp: List<&2, U32>, +d: Nat, +j: U32, +r: U32, +h: {RG.off.ports(Fp, d, j) == True{} : Bool}, hr: {RG.has(Fp, r) == True{} : Bool}) -> {KMd.off.port(d, r, j) == True{} : Bool}:
  match Fp:
    case Nil{}:
      Empty.absurd({KMd.off.port(d, r, j) == True{} : Bool}, MB.false_ne_true()(hr))
    case Con{+f, +q}:
      or_cases(U32.is_eq(f, r), RG.has(q, r), KMd.off.port(d, r, j), hr,
        e => ME.subst(U32, kk => {KMd.off.port(d, kk, j) == True{} : Bool}, f, r, MS.u32_eq_of_is_eq(f, r, e), and_l(KMd.off.port(d, f, j), RG.off.ports(q, d, j), h)),
        e => ops_at(q, d, j, r, and_r(KMd.off.port(d, f, j), RG.off.ports(q, d, j), h), e))

