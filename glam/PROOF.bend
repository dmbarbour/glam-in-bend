def jk.k(I: IM.Ix, +t0: LAT.Tree<U32>, +ta: LAT.Tree<V.Val>, +d: Nat, +s: U32, +ps: List<&2, U32>, +L: List<&2, U32>, +F: List<&2, U32>, +N: List<&2, U32>, +x: U32, +y: U32, +k: U32,
  +hft: {AD.full(U32, LAT.fromT(U32, t0), d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool}, +hN: {RG.layout(N, d) == True{} : Bool}, +hB: {RG.bases(N) == True{} : Bool},
  +hp: {RG.px.ok(AD.view(U32, LAT.fromT(U32, t0)), d, s, I, Con{x, ps}, L, F, N) == True{} : Bool}, +hy: {IM.ix.look(I, k) == Some{y} : Maybe<&2, U32>}, +Fp: List<&2, U32>, +j: U32, +hj: {RG.off.nodes(N, d, j) == True{} : Bool}, +hjh: {Nat.is_eq(AD.slot(P.at_fh(), d), AD.slot(j, d)) == False{} : Bool}, +hjf: {RG.off.ports(Fp, d, j) == True{} : Bool}, +hfi: {faced.in(L, AD.view(U32, LAT.fromT(U32, t0)), d, Fp) == True{} : Bool}) -> {Pair.snd(P.H, U32, P.rd(R.join1(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, x, y), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, j)) : U32}:
  match I:
    case IM.Ept{}:
      Empty.absurd({Pair.snd(P.H, U32, P.rd(R.join1(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, x, y), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, j)) : U32}, MB.false_ne_true()(Equal.cong(Maybe<&2, U32>, Bool, mm => XP.is_some(mm), None{}, Some{y}, hy)))
    case IM.Has{+t}:
      jk.t(t, t0, ta, d, s, ps, L, F, N, x, y, k, hft, hd32, hN, hB, hp, hy, Fp, j, hj, hjh, hjf, hfi)

# a crossing, either way
def cks.k(+m: Maybe<&2, U32>, +I: IM.Ix, +t0: LAT.Tree<U32>, +ta: LAT.Tree<V.Val>, +d: Nat, +s: U32, +ps: List<&2, U32>, +L: List<&2, U32>, +F: List<&2, U32>, +N: List<&2, U32>, +x: U32, +src: U32, +neg: Bool, +far: U32, +b: U32,
  +hft: {AD.full(U32, LAT.fromT(U32, t0), d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool}, +hN: {RG.layout(N, d) == True{} : Bool}, +hB: {RG.bases(N) == True{} : Bool}, +he: {IM.ix.look(I, far) == m : Maybe<&2, U32>}, +hp: {RG.px.ok(AD.view(U32, LAT.fromT(U32, t0)), d, s, I, Con{x, ps}, L, RG.cx.F0(m, I, b, F), N) == True{} : Bool}, +ha: {RG.cx.ab(m, I, src) == True{} : Bool},
  +Fp: List<&2, U32>, +j: U32, +hj: {RG.off.nodes(N, d, j) == True{} : Bool}, +hjh: {Nat.is_eq(AD.slot(P.at_fh(), d), AD.slot(j, d)) == False{} : Bool}, +hjf: {RG.off.ports(Fp, d, j) == True{} : Bool}, +hfi: {faced.in(L, AD.view(U32, LAT.fromT(U32, t0)), d, Fp) == True{} : Bool}) -> {Pair.snd(P.H, U32, P.rd(R.cross.k((P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, m), s, x, src, neg), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, j)) : U32}:
  match m:
    case Some{+y}:
      jk.k(I, t0, ta, d, s, ps, L, F, N, x, y, far, hft, hd32, hN, hB, hp, he, Fp, j, hj, hjh, hjf, hfi)
    case None{}:
      ck.k(I, t0, ta, d, s, ps, L, F, N, x, src, neg, b, hft, hd32, hN, hB, hp, isnone_eq(IM.ix.look(I, src), ha), j, hj, hjh)

