  +hN: {RG.layout(N, d) == True{} : Bool}, +hB: {RG.bases(N) == True{} : Bool}, hp: {RG.px.ok(AD.view(U32, w), d, s, I, RG.pls(cl, AD.view(U32, map), dm), L, F, N) == True{} : Bool}, hok: {RG.cxs.ok(cl, AD.view(U32, map), dm, I, F) == True{} : Bool},
  mw: LAT.Mirror(U32, w), ma: LAT.Mirror(V.Val, a), mm: LAT.Mirror(U32, map)) -> {RG.px.ok(AD.view(U32, RG.words(Pair.snd(Array<U32>, P.H, R.crossings(cl, (map, P.H{KM.MG{w}, a}), s)))), d, s, RG.cxs.I(RG.cxs(cl, AD.view(U32, map), dm, I, L, F)), [], RG.cxs.L(RG.cxs(cl, AD.view(U32, map), dm, I, L, F)), RG.cxs.F(RG.cxs(cl, AD.view(U32, map), dm, I, L, F)), N) && AD.full(U32, RG.words(Pair.snd(Array<U32>, P.H, R.crossings(cl, (map, P.H{KM.MG{w}, a}), s))), d) == True{} : Bool}:
