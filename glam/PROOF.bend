  ch.k(I, t0, ta, d, s, ps, L, F, N, x, src, neg, b, hft, hd32, hN, hB, LAB.subst(Array<U32>, qq => {RG.px.ok(AD.view(U32, qq), d, s, I, Con{x, ps}, L, IM.ix.take(I, b, F), N) == True{} : Bool}, w, LAT.fromT(U32, t0), Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, e), hp), ha)

def Laws.cursor_head(w, a, d, s, I, ps, L, F, N, x, src, neg, b, hf, hd32, hN, hB, hp, ha):
  ch.m(w, a, d, s, I, ps, L, F, N, x, src, neg, b, hf, hd32, hN, hB, hp, ha, LAT.mirror(U32, w), LAT.mirror(V.Val, a))

