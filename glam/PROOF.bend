      match f:
        case 0n:
          Empty.absurd({Pair.snd(P.H, U32, R.rg.pred.w(R.rg.pred.go(0n, R.Rw{P.H{KM.MG{LAT.fromT(U32, t)}, a}, Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, t), (p + 3 : U32))), p, None{}, False{}}, x))) == p : U32}, MB.false_ne_true()(hfu))
