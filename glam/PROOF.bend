# The served cursor's lookup kept through a copy's crossings
# (cells-freeze.sharing.cursors.index.ring.premises.lookups): a join
# removes the cursor at another key, an insert puts at a key absent, so
# that neither moves a cursor found at a key no crossing looks for
def isnone_none(+m: Maybe<&2, U32>, +h: {RG.isnone(m) == True{} : Bool}) -> {m == None{} : Maybe<&2, U32>}:
  match m:
    case Some{+y}:
      Empty.absurd({Some{y} == None{} : Maybe<&2, U32>}, MB.false_ne_true()(h))
    case None{}:
      {==}

def src_ne.k(+e: Bool, +I: IM.Ix, +src: U32, +k: U32, +nc: U32, +he: {U32.is_eq(src, k) == e : Bool}, +ha: {IM.ix.look(I, src) == None{} : Maybe<&2, U32>},
  +hk: {IM.ix.look(I, k) == Some{nc} : Maybe<&2, U32>}) -> {e == False{} : Bool}:
  match e:
    case True{}:
      Empty.absurd({True{} == False{} : Bool}, MB.false_ne_true()(Equal.cong(Maybe<&2, U32>, Bool, m => XP.is_some(m), None{}, Some{nc},
        Equal.trans(Maybe<&2, U32>, None{}, IM.ix.look(I, k), Some{nc}, Equal.sym(Maybe<&2, U32>, IM.ix.look(I, k), None{}, ME.subst(U32, z => {IM.ix.look(I, z) == None{} : Maybe<&2, U32>}, src, k, MS.u32_eq_of_is_eq(src, k, he), ha)), hk))))
    case False{}:
      {==}

def src_ne(+I: IM.Ix, +src: U32, +k: U32, +nc: U32, +ha: {IM.ix.look(I, src) == None{} : Maybe<&2, U32>}, +hk: {IM.ix.look(I, k) == Some{nc} : Maybe<&2, U32>}) ->
  {U32.is_eq(src, k) == False{} : Bool}:
  src_ne.k(U32.is_eq(src, k), I, src, k, nc, {==}, ha, hk)

# one crossing: the cursor found at k found there after
def cxl.k(+m: Maybe<&2, U32>, +I: IM.Ix, +s: U32, +d: Nat, +x: U32, +src: U32, +b: U32, +far: U32, +k: U32, +nc: U32, +he: {IM.ix.look(I, far) == m : Maybe<&2, U32>},
  +hi: {IM.ix.inv(I) == True{} : Bool}, +hl: {IM.ix.lay(I, s, d) == True{} : Bool}, +hab: {RG.cx.ab(m, I, src) == True{} : Bool},
  +hk: {IM.ix.look(I, k) == Some{nc} : Maybe<&2, U32>}, +hfk: {U32.is_eq(far, k) == False{} : Bool}) -> {IM.ix.look(RG.cx.I(m, I, x, src, b, far), k) == Some{nc} : Maybe<&2, U32>}:
  match m:
    case Some{+y}:
      Equal.trans(Maybe<&2, U32>, IM.ix.look(IM.ix.del(I, y, far), k), IM.ix.look(I, k), Some{nc}, XL.look_del_other(I, s, y, far, k, d, hi, hl, he, hfk), hk)
    case None{}:
      +ha = isnone_none(IM.ix.look(I, src), hab)
