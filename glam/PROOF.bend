      or_cases(U32.is_eq(c, f), RG.has(r, f), KMd.off.port(d, f, j), hf,
        q => ME.subst(U32, k => {KMd.off.port(d, k, j) == True{} : Bool}, c, f, MS.u32_eq_of_is_eq(c, f, q), MB.eq_true_of_and_left(KMd.off.port(d, c, j), RG.off.ports(r, d, j), h)),
        hh => ports_at(r, d, j, f, MB.eq_true_of_and_right(KMd.off.port(d, c, j), RG.off.ports(r, d, j), h), hh))

def off_nodes_sub(K: List<&2, U32>, +L: List<&2, U32>, +d: Nat, +j: U32, +hs: {RG.sub(K, L) == True{} : Bool}, +h: {RG.off.nodes(L, d, j) == True{} : Bool}) -> {RG.off.nodes(K, d, j) == True{} : Bool}:
