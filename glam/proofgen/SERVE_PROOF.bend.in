# The materializer's composition unfolded (glam/serve.bend; the CursorLaws
# plan's cursor-laws.materializer): away from the root, the crossings'
# heap; at it, the served cursor leaving with the copy's root port linked
# in its place, read through the map. The serve's laws are stated over
# SC.serve, their proofs over these forms.
def serve.cr(q: Array<U32> & P.H, root: T.TEnd, +nc: U32) -> {SC.serve.r(q, root, nc, False{}) == Pair.snd(Array<U32>, P.H, q) : P.H}:
  match q:
    case (map, h):
      {==}

def serve.rte(g: Array<U32> & U32, h: P.H, +p: U32, +nc: U32) -> {SC.rt.e(g, h, p, nc) == R.leave(h, (Pair.snd(Array<U32>, U32, g) + p : U32), nc) : P.H}:
  match g:
    case (m, +n):
      {==}

def serve.ct(q: Array<U32> & P.H, +rn: U32, +rp: U32, +nc: U32) ->
  {SC.serve.r(q, T.TE{rn, rp}, nc, True{}) == R.leave(Pair.snd(Array<U32>, P.H, q), (Pair.snd(Array<U32>, U32, Array.get(U32, Pair.fst(Array<U32>, P.H, q), rn)) + rp : U32), nc) : P.H}:
  match q:
    case (map, h):
      serve.rte(Array.get(U32, map, rn), h, rp, nc)

def serve_false(v: S.Sp, cs: List<&2, R.FzC>, root: T.TEnd, +s: U32, +nc: U32) ->
  {SC.serve(v, cs, root, s, nc, False{}) == Pair.snd(Array<U32>, P.H, R.crossings(cs, (SM.map(v), SM.heap(v)), s)) : P.H}:
  match v:
    case S.Sp{h, map}:
      serve.cr(R.crossings(cs, (map, h), s), root, nc)

def serve_true(v: S.Sp, cs: List<&2, R.FzC>, +rn: U32, +rp: U32, +s: U32, +nc: U32) ->
  {SC.serve(v, cs, T.TE{rn, rp}, s, nc, True{}) == R.leave(Pair.snd(Array<U32>, P.H, R.crossings(cs, (SM.map(v), SM.heap(v)), s)), (Pair.snd(Array<U32>, U32, Array.get(U32, Pair.fst(Array<U32>, P.H, R.crossings(cs, (SM.map(v), SM.heap(v)), s)), rn)) + rp : U32), nc) : P.H}:
  match v:
    case S.Sp{h, map}:
      serve.ct(R.crossings(cs, (map, h), s), rn, rp, nc)

