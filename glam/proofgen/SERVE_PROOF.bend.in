def dyn_at(ns: List<&2, U32>, +x: U32, +b: Bool, +hb: {b == hdeq(ns, x) : Bool}, +hdy: {SV.dyn(ns) == True{} : Bool}, +hx: {RG.has(ns, x) == True{} : Bool}) -> {P.is_static(x) == False{} : Bool}:
  match ns:
    case Nil{}:
      Empty.absurd({P.is_static(x) == False{} : Bool}, MB.false_ne_true()(hx))
    case Con{+n, +r}:
      match b:
        case True{}:
          ME.subst(U32, z => {P.is_static(z) == False{} : Bool}, n, x, MS.u32_eq_of_is_eq(n, x, Equal.sym(Bool, True{}, U32.is_eq(n, x), hb)), MB.eq_false_of_not_eq_true(P.is_static(n), MB.eq_true_of_and_left(Bool.not(P.is_static(n)), SV.dyn(r), hdy)))
