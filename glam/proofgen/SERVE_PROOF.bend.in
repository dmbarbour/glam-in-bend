    case Nil{}:
      {==}
    case Con{+m, +r}:
      MB.and_eq_true(RG.faces.m(List.get(&2, U32, v, AD.slot((m + 1 : U32), d)), d, List.append(&2, U32, A, B)), RG.faces(r, v, d, List.append(&2, U32, A, B)), fm_app(List.get(&2, U32, v, AD.slot((m + 1 : U32), d)), d, A, B, MB.eq_true_of_and_left(RG.faces.m(List.get(&2, U32, v, AD.slot((m + 1 : U32), d)), d, A), RG.faces(r, v, d, A), ha), MB.eq_true_of_and_left(RG.faces.m(List.get(&2, U32, v, AD.slot((m + 1 : U32), d)), d, B), RG.faces(r, v, d, B), hb)), faces_two(r, v, d, A, B, MB.eq_true_of_and_right(RG.faces.m(List.get(&2, U32, v, AD.slot((m + 1 : U32), d)), d, A), RG.faces(r, v, d, A), ha), MB.eq_true_of_and_right(RG.faces.m(List.get(&2, U32, v, AD.slot((m + 1 : U32), d)), d, B), RG.faces(r, v, d, B), hb)))

