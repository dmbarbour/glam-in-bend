    {Bool.or(Bool.not(Bool.and(U32.is_eq(SM.pick(b1, 1, k1), 1), U32.is_eq(SM.pick(b2, 1, k2), 1))), Bool.not(U32.is_eq(SM.pick(b1, m, w1), SM.pick(b2, m, w2)))) == True{} : Bool}:
