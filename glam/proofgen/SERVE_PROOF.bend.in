# a link's write: kept where it misses word j, made where it hits
def lww_keep(+st: Bool, +x: U32, +y: U32, +d: Nat, +j: U32, +old: U32, +hx: {Nat.is_eq(AD.slot((x + 1 : U32), d), AD.slot(j, d)) == False{} : Bool}) -> {SM.lw.w(st, x, y, d, j, old) == old : U32}:
  match st:
    case True{}:
      {==}
    case False{}:
      %Equal.sym(Bool, Nat.is_eq(AD.slot((x + 1 : U32), d), AD.slot(j, d)), False{}, hx) : {SM.pick(_, y, old) == old : U32}
      {==}

def lww_hit(+x: U32, +y: U32, +d: Nat, +old: U32, +hs: {P.is_static(x) == False{} : Bool}) -> {SM.lw.w(P.is_static(x), x, y, d, (x + 1 : U32), old) == y : U32}:
  %Equal.sym(Bool, P.is_static(x), False{}, hs) : {SM.lw.w(_, x, y, d, (x + 1 : U32), old) == y : U32}
  %Equal.sym(Bool, Nat.is_eq(AD.slot((x + 1 : U32), d), AD.slot((x + 1 : U32), d)), True{}, MN.is_eq_refl(AD.slot((x + 1 : U32), d))) : {SM.pick(_, y, old) == y : U32}
  {==}

def orfalse(+x: Bool, +h: {Bool.or(x, False{}) == True{} : Bool}) -> {x == True{} : Bool}:
  match x:
    case True{}:
      {==}
    case False{}:
      h

