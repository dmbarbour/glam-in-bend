    case True{}:
      hd
    case False{}:
      imp_r(U32.is_eq(k, 1), U32.is_eq(m, w), RG.has(r, w), h)

def n3(+b1: Bool, +b2: Bool, +k1: U32, +w1: U32, +k2: U32, +w2: U32, +m: U32, +r: List<&2, U32>, +hb: {Bool.and(b1, b2) == False{} : Bool},
