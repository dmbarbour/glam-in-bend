# whether a list's head is x: a recursion's split on it, as a parameter
def hdeq(xs: List<&2, U32>, +x: U32) -> Bool:
  match xs:
    case Nil{}:
      False{}
    case Con{+y, +r}:
      U32.is_eq(y, x)

# x among xs, n's slot none of xs's: x's slot not n's
def slin_ne(xs: List<&2, U32>, +x: U32, +b: Bool, +hb: {b == hdeq(xs, x) : Bool}, +dm: Nat, +n: U32, +hx: {RG.has(xs, x) == True{} : Bool}, +h: {SV.sl.in(xs, dm, n) == False{} : Bool}) -> {SV.sl.eq(x, n, dm) == False{} : Bool}:
  match xs:
    case Nil{}:
      Empty.absurd({SV.sl.eq(x, n, dm) == False{} : Bool}, MB.false_ne_true()(hx))
    case Con{+y, +r}:
      match b:
        case True{}:
          ME.subst(U32, z => {SV.sl.eq(z, n, dm) == False{} : Bool}, y, x, MS.u32_eq_of_is_eq(y, x, Equal.sym(Bool, True{}, U32.is_eq(y, x), hb)), orf_l(SV.sl.eq(y, n, dm), SV.sl.in(r, dm, n), h))
        case False{}:
          slin_ne(r, x, hdeq(r, x), {==}, dm, n, ME.subst(Bool, z => {Bool.or(z, RG.has(r, x)) == True{} : Bool}, U32.is_eq(y, x), False{}, Equal.sym(Bool, False{}, U32.is_eq(y, x), hb), hx), orf_r(SV.sl.eq(y, n, dm), SV.sl.in(r, dm, n), h))

