# Distinct lists
def bff(+x: Bool, +y: Bool, +hx: {x == False{} : Bool}, +hy: {y == False{} : Bool}) -> {Bool.or(x, y) == False{} : Bool}:
  %Equal.sym(Bool, x, False{}, hx) : {Bool.or(_, y) == False{} : Bool}
  hy

def orf_l(+x: Bool, +y: Bool, +h: {Bool.or(x, y) == False{} : Bool}) -> {x == False{} : Bool}:
  match x:
    case True{}:
      Empty.absurd({True{} == False{} : Bool}, MB.false_ne_true()(Equal.sym(Bool, True{}, False{}, h)))
    case False{}:
      {==}

def orf_r(+x: Bool, +y: Bool, +h: {Bool.or(x, y) == False{} : Bool}) -> {y == False{} : Bool}:
  match x:
    case True{}:
      Empty.absurd({y == False{} : Bool}, MB.false_ne_true()(Equal.sym(Bool, True{}, False{}, h)))
    case False{}:
      h

def nott(+x: Bool, +hx: {x == False{} : Bool}) -> {Bool.not(x) == True{} : Bool}:
  %Equal.sym(Bool, x, False{}, hx) : {Bool.not(_) == True{} : Bool}
  {==}

# a node apart from b is not b
def neq_k(+e: Bool, +a: U32, +b: U32, +d: Nat, +he: {U32.is_eq(b, a) == e : Bool}, +h: {RG.disj4(d, a, b) == True{} : Bool}) -> {e == False{} : Bool}:
  match e:
    case False{}:
      {==}
    case True{}:
      Empty.absurd({True{} == False{} : Bool}, MB.false_ne_true()(ME.subst(Bool, z => {Bool.not(z) == True{} : Bool}, Nat.is_eq(AD.slot(a, d), AD.slot(a, d)), True{}, MN.is_eq_refl(AD.slot(a, d)),
        MB.eq_true_of_and_left(Bool.not(Nat.is_eq(AD.slot(a, d), AD.slot(a, d))), RG.off(Con{(a + 1 : U32), Con{(a + 2 : U32), Con{(a + 3 : U32), Nil{}}}}, d, a), MB.eq_true_of_and_left(RG.off(Con{a, Con{(a + 1 : U32), Con{(a + 2 : U32), Con{(a + 3 : U32), Nil{}}}}}, d, a), Bool.and(RG.off(Con{a, Con{(a + 1 : U32), Con{(a + 2 : U32), Con{(a + 3 : U32), Nil{}}}}}, d, (a + 1 : U32)), Bool.and(RG.off(Con{a, Con{(a + 1 : U32), Con{(a + 2 : U32), Con{(a + 3 : U32), Nil{}}}}}, d, (a + 2 : U32)), RG.off(Con{a, Con{(a + 1 : U32), Con{(a + 2 : U32), Con{(a + 3 : U32), Nil{}}}}}, d, (a + 3 : U32)))), ME.subst(U32, z => {RG.disj4(d, a, z) == True{} : Bool}, b, a, MS.u32_eq_of_is_eq(b, a, he), h))))))

def neq(+a: U32, +b: U32, +d: Nat, +h: {RG.disj4(d, a, b) == True{} : Bool}) -> {U32.is_eq(b, a) == False{} : Bool}:
  neq_k(U32.is_eq(b, a), a, b, d, {==}, h)

def cross_notin(t: List<&2, U32>, +d: Nat, +a: U32, +h: {RG.cross(t, d, a) == True{} : Bool}) -> {RG.has(t, a) == False{} : Bool}:
  match t:
    case Nil{}:
