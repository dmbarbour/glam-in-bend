      MB.and_eq_true(Bool.not(Nat.is_eq(AD.slot(i, d), AD.slot((y + 3 : U32), d))), RG.off.links(List.append(&2, U32, r, B), d, i), MB.eq_true_of_and_left(Bool.not(Nat.is_eq(AD.slot(i, d), AD.slot((y + 3 : U32), d))), RG.off.links(r, d, i), ha), ol_app(r, B, d, i, MB.eq_true_of_and_right(Bool.not(Nat.is_eq(AD.slot(i, d), AD.slot((y + 3 : U32), d))), RG.off.links(r, d, i), ha), hb))

def op_app(A: List<&2, U32>, +B: List<&2, U32>, +d: Nat, +i: U32, +ha: {RG.off.pos(A, d, i) == True{} : Bool}, +hb: {RG.off.pos(B, d, i) == True{} : Bool}) -> {RG.off.pos(List.append(&2, U32, A, B), d, i) == True{} : Bool}:
