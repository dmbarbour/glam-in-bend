    +hlay: {RG.layout(List.append(&2, U32, Con{s, t}, ns), d) == True{} : Bool}, +hbs: {RG.bases(ns) == True{} : Bool}, +hdy: {SV.dyn(ns) == True{} : Bool}, +hpa: {KMd.past(List.append(&2, U32, Con{s, t}, ns), d) == True{} : Bool}, +hhd: {KMd.off.words(KMd.hdr_words(), d, P.at_fh()) == True{} : Bool},
    +hfr: {RG.faces(Con{s, t}, AD.view(U32, LAT.fromT(U32, t0)), d, ns) == True{} : Bool}, +ht: {SM.tpl.ok(ls, ts, dm) == True{} : Bool}, +at: U32, +hna: {SV.node.at(ts, dm, at) == True{} : Bool}, +hat: {RG.has(SV.ats(cs), at) == True{} : Bool}, +hh: {SV.holes.ok(SV.ats(cs), ls, ts, dm, SV.ats(cs)) == True{} : Bool},
