# whether the first link's ends name the hole: the recursion's splits
def hd1(ls: List<&2, T.TLink>, +dm: Nat, +at: U32) -> Bool:
  match ls:
    case Nil{}:
      False{}
    case Con{l, r}:
      match l:
        case T.TL{a, b}:
          match a:
            case T.TE{+n1, +p1}:
              SV.sl.eq(n1, at, dm)

def hd2(ls: List<&2, T.TLink>, +dm: Nat, +at: U32) -> Bool:
  match ls:
    case Nil{}:
      False{}
    case Con{l, r}:
      match l:
        case T.TL{a, b}:
          match b:
            case T.TE{+n2, +p2}:
              SV.sl.eq(n2, at, dm)

# The hole's word 1 after the links pass: a port L may face, once a link
# names the hole (the partner's port), as it was before
