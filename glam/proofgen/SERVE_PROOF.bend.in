# A word off every copy node that is no hole: a hole's faced port's link
# word off it (the copy's hand-off over the index: the holes' own words)
def has_minus.k(+e: Bool, +x: U32, +r: List<&2, U32>, +ys: List<&2, U32>, +c: U32, +he: {RG.has(ys, x) == e : Bool}, +hr: {RG.has(RG.minus(r, ys), c) == True{} : Bool}) ->
  {RG.has(RG.minus.k(e, x, RG.minus(r, ys)), c) == True{} : Bool}:
  match e:
    case True{}:
      hr
    case False{}:
      SPP.or_r(U32.is_eq(x, c), RG.has(RG.minus(r, ys), c), hr)

def has_minus.x(+e: Bool, +x: U32, +r: List<&2, U32>, +ys: List<&2, U32>, +he: {RG.has(ys, x) == e : Bool}, +hy: {RG.has(ys, x) == False{} : Bool}) ->
  {RG.has(RG.minus.k(e, x, RG.minus(r, ys)), x) == True{} : Bool}:
  match e:
    case True{}:
      Empty.absurd({RG.has(RG.minus.k(True{}, x, RG.minus(r, ys)), x) == True{} : Bool}, MB.false_ne_true()(Equal.trans(Bool, False{}, RG.has(ys, x), True{}, Equal.sym(Bool, RG.has(ys, x), False{}, hy), he)))
    case False{}:
      SPP.or_l(U32.is_eq(x, x), RG.has(RG.minus(r, ys), x), SPP.u32_refl(x))

def has_minus(xs: List<&2, U32>, +ys: List<&2, U32>, +c: U32, hx: {RG.has(xs, c) == True{} : Bool}, +hy: {RG.has(ys, c) == False{} : Bool}) -> {RG.has(RG.minus(xs, ys), c) == True{} : Bool}:
  match xs:
    case Nil{}:
      Empty.absurd({RG.has(RG.minus([], ys), c) == True{} : Bool}, MB.false_ne_true()(hx))
    case Con{+x, +r}:
      SPP.or_cases(U32.is_eq(x, c), RG.has(r, c), RG.has(RG.minus(Con{x, r}, ys), c), hx,
        q => ME.subst(U32, z => {RG.has(RG.minus(Con{z, r}, ys), c) == True{} : Bool}, c, x, Equal.sym(U32, x, c, MS.u32_eq_of_is_eq(x, c, q)),
