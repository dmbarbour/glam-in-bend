          {==}
        case False{}:
          h

# a node's step: the next fresh node m, the rest r after it
def n1(+b: Bool, +k: U32, +w: U32, +m: U32, +r: List<&2, U32>, +hd: {Bool.not(RG.has(r, m)) == True{} : Bool}, +h: {Bool.or(Bool.not(U32.is_eq(k, 1)), Bool.not(RG.has(Con{m, r}, w))) == True{} : Bool}) -> {Bool.or(Bool.not(U32.is_eq(SM.pick(b, 1, k), 1)), Bool.not(RG.has(r, SM.pick(b, m, w)))) == True{} : Bool}:
