# A U32 plus 0 is itself (a symbolic sum does not reduce), proved over
# the modulus as a variable, never 2^32 computed (docs/Proving.md)
def add0_m(+m: Nat, +h: U32, +e: {Nat.pow(2n, 32n) == m : Nat}) -> {U32.to_nat((h + 0 : U32)) == U32.to_nat(h) : Nat}:
  Equal.trans(Nat, U32.to_nat((h + 0 : U32)), Nat.add(U32.to_nat(h), 0n), U32.to_nat(h),
    MU.internal_u32_add_exact(m, h, 0, e, ME.subst(Nat, x => MN.lt(x, m), U32.to_nat(h), Nat.add(U32.to_nat(h), 0n), MN.add_zero_sym(U32.to_nat(h)), MU.internal_u32_to_nat_lt(m, h, e))),
    MN.add_zero(U32.to_nat(h)))

def u32_add0(+h: U32) -> {(h + 0 : U32) == h : U32}:
  MU.u32_to_nat_inj((h + 0 : U32), h, add0_m(Nat.pow(2n, 32n), h, {==}))

# the ring's reading of a word and the splice's agree
def plof(m: Maybe<&2, U32>) -> {RG.pl.of(m) == KMd.word.m(m) : U32}:
  match m:
    case Some{+q}:
      {==}
    case None{}:
      {==}

# The links pass leaves the map as it was
def lmap_go(ls: List<&2, T.TLink>, -h: P.H, -map: Array<U32>, mm: LAT.Mirror(U32, map)) ->
  {SM.map(S.sp.links(ls, S.Sp{h, map})) == map : Array<U32>}:
  match ls:
    case Nil{}:
      {==}
    case Con{l, +rest}:
      match l:
        case T.TL{e1, e2}:
          match e1:
            case T.TE{+n1, +p1}:
              match e2:
                case T.TE{+n2, +p2}:
                  (+tm, +em) = mm
                  %em : {SM.map(S.sp.links(Con{T.TL{T.TE{n1, p1}, T.TE{n2, p2}}, rest}, S.Sp{h, _})) == _ : Array<U32>}
                  %Equal.sym(Array<U32> & U32, Array.get(U32, LAT.fromT(U32, tm), n1), (LAT.fromT(U32, tm), Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1))), LA.get_pair(U32, LAT.fromT(U32, tm), n1)) :
                    {SM.map(S.sp.links(rest, S.sp.link1(S.sp.ref(_, p1), T.TE{n2, p2}, h))) == LAT.fromT(U32, tm) : Array<U32>}
                  %Equal.sym(Array<U32> & U32, Array.get(U32, LAT.fromT(U32, tm), n2), (LAT.fromT(U32, tm), Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n2))), LA.get_pair(U32, LAT.fromT(U32, tm), n2)) :
                    {SM.map(S.sp.links(rest, S.sp.link2(S.sp.ref(_, p2), (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1)) + p1 : U32), h))) == LAT.fromT(U32, tm) : Array<U32>}
                  lmap_go(rest, P.link_xx(h, (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1)) + p1 : U32), (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n2)) + p2 : U32)), LAT.fromT(U32, tm), LAT.mirror(U32, LAT.fromT(U32, tm)))

def lmap(ls: List<&2, T.TLink>, s: S.Sp) -> {SM.map(S.sp.links(ls, s)) == SM.map(s) : Array<U32>}:
  match s:
    case S.Sp{h, m}:
      lmap_go(ls, h, m, LAT.mirror(U32, m))

