def port_app(+A: List<&2, U32>, +B: List<&2, U32>, +d: Nat, +r: U32, +ha: {RG.port.ok(A, d, r) == True{} : Bool}, +hb: {RG.port.ok(B, d, r) == True{} : Bool}) -> {RG.port.ok(List.append(&2, U32, A, B), d, r) == True{} : Bool}:
