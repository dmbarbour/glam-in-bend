# A U32 plus 0 is itself (a symbolic sum does not reduce), proved over
# the modulus as a variable, never 2^32 computed (docs/Proving.md)
def add0_m(+m: Nat, +h: U32, +e: {Nat.pow(2n, 32n) == m : Nat}) -> {U32.to_nat((h + 0 : U32)) == U32.to_nat(h) : Nat}:
  Equal.trans(Nat, U32.to_nat((h + 0 : U32)), Nat.add(U32.to_nat(h), 0n), U32.to_nat(h),
    MU.internal_u32_add_exact(m, h, 0, e, ME.subst(Nat, x => MN.lt(x, m), U32.to_nat(h), Nat.add(U32.to_nat(h), 0n), MN.add_zero_sym(U32.to_nat(h)), MU.internal_u32_to_nat_lt(m, h, e))),
    MN.add_zero(U32.to_nat(h)))

def u32_add0(+h: U32) -> {(h + 0 : U32) == h : U32}:
  MU.u32_to_nat_inj((h + 0 : U32), h, add0_m(Nat.pow(2n, 32n), h, {==}))

# the ring's reading of a word and the splice's agree
def plof(m: Maybe<&2, U32>) -> {RG.pl.of(m) == KMd.word.m(m) : U32}:
  match m:
    case Some{+q}:
      {==}
    case None{}:
      {==}

# The links pass leaves the map as it was
def lmap_go(ls: List<&2, T.TLink>, -h: P.H, -map: Array<U32>, mm: LAT.Mirror(U32, map)) ->
  {SM.map(S.sp.links(ls, S.Sp{h, map})) == map : Array<U32>}:
  match ls:
    case Nil{}:
      {==}
    case Con{l, +rest}:
      match l:
        case T.TL{e1, e2}:
          match e1:
            case T.TE{+n1, +p1}:
              match e2:
                case T.TE{+n2, +p2}:
                  (+tm, +em) = mm
                  %em : {SM.map(S.sp.links(Con{T.TL{T.TE{n1, p1}, T.TE{n2, p2}}, rest}, S.Sp{h, _})) == _ : Array<U32>}
                  %Equal.sym(Array<U32> & U32, Array.get(U32, LAT.fromT(U32, tm), n1), (LAT.fromT(U32, tm), Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1))), LA.get_pair(U32, LAT.fromT(U32, tm), n1)) :
                    {SM.map(S.sp.links(rest, S.sp.link1(S.sp.ref(_, p1), T.TE{n2, p2}, h))) == LAT.fromT(U32, tm) : Array<U32>}
                  %Equal.sym(Array<U32> & U32, Array.get(U32, LAT.fromT(U32, tm), n2), (LAT.fromT(U32, tm), Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n2))), LA.get_pair(U32, LAT.fromT(U32, tm), n2)) :
                    {SM.map(S.sp.links(rest, S.sp.link2(S.sp.ref(_, p2), (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1)) + p1 : U32), h))) == LAT.fromT(U32, tm) : Array<U32>}
                  lmap_go(rest, P.link_xx(h, (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1)) + p1 : U32), (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n2)) + p2 : U32)), LAT.fromT(U32, tm), LAT.mirror(U32, LAT.fromT(U32, tm)))

def lmap(ls: List<&2, T.TLink>, s: S.Sp) -> {SM.map(S.sp.links(ls, s)) == SM.map(s) : Array<U32>}:
  match s:
    case S.Sp{h, m}:
      lmap_go(ls, h, m, LAT.mirror(U32, m))

# and the words full
def lfull_go(ls: List<&2, T.TLink>, -w: Array<U32>, -a: Array<V.Val>, -map: Array<U32>, +d: Nat,
  hf: {AD.full(U32, w, d) == True{} : Bool}, mw: LAT.Mirror(U32, w), ma: LAT.Mirror(V.Val, a), mm: LAT.Mirror(U32, map)) ->
  {AD.full(U32, KMd.words(SM.heap(S.sp.links(ls, S.Sp{P.H{KM.MG{w}, a}, map}))), d) == True{} : Bool}:
  match ls:
    case Nil{}:
      hf
    case Con{l, +rest}:
      match l:
        case T.TL{e1, e2}:
          match e1:
            case T.TE{+n1, +p1}:
              match e2:
                case T.TE{+n2, +p2}:
                  (+t0, +ew) = mw
                  (+ta, +eav) = ma
                  (+tm, +em) = mm
                  +hft = LAP.full_t(U32, w, t0, d, ew, hf)
                  %ew : {AD.full(U32, KMd.words(SM.heap(S.sp.links(Con{T.TL{T.TE{n1, p1}, T.TE{n2, p2}}, rest}, S.Sp{P.H{KM.MG{_}, a}, map}))), d) == True{} : Bool}
                  %eav : {AD.full(U32, KMd.words(SM.heap(S.sp.links(Con{T.TL{T.TE{n1, p1}, T.TE{n2, p2}}, rest}, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, _}, map}))), d) == True{} : Bool}
                  %em : {AD.full(U32, KMd.words(SM.heap(S.sp.links(Con{T.TL{T.TE{n1, p1}, T.TE{n2, p2}}, rest}, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, _}))), d) == True{} : Bool}
                  %Equal.sym(Array<U32> & U32, Array.get(U32, LAT.fromT(U32, tm), n1), (LAT.fromT(U32, tm), Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1))), LA.get_pair(U32, LAT.fromT(U32, tm), n1)) :
                    {AD.full(U32, KMd.words(SM.heap(S.sp.links(rest, S.sp.link1(S.sp.ref(_, p1), T.TE{n2, p2}, P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)})))), d) == True{} : Bool}
                  %Equal.sym(Array<U32> & U32, Array.get(U32, LAT.fromT(U32, tm), n2), (LAT.fromT(U32, tm), Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n2))), LA.get_pair(U32, LAT.fromT(U32, tm), n2)) :
                    {AD.full(U32, KMd.words(SM.heap(S.sp.links(rest, S.sp.link2(S.sp.ref(_, p2), (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1)) + p1 : U32), P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)})))), d) == True{} : Bool}
                  %SPP.heta(P.link_xx(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1)) + p1 : U32), (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n2)) + p2 : U32))) :
                    {AD.full(U32, KMd.words(SM.heap(S.sp.links(rest, S.Sp{_, LAT.fromT(U32, tm)}))), d) == True{} : Bool}
                  lfull_go(rest, KMd.words(P.link_xx(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1)) + p1 : U32), (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n2)) + p2 : U32))), KMd.vals(P.link_xx(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1)) + p1 : U32), (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n2)) + p2 : U32))), LAT.fromT(U32, tm), d, SPP.lxf(P.is_static((Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1)) + p1 : U32)), P.is_static((Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n2)) + p2 : U32)), t0, LAT.fromT(V.Val, ta), d, (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1)) + p1 : U32), (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n2)) + p2 : U32), hft), LAT.mirror(U32, KMd.words(P.link_xx(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1)) + p1 : U32), (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n2)) + p2 : U32)))), LAT.mirror(V.Val, KMd.vals(P.link_xx(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1)) + p1 : U32), (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n2)) + p2 : U32)))), LAT.mirror(U32, LAT.fromT(U32, tm)))

# Lists appended
def sub_app_l(A: List<&2, U32>, +B: List<&2, U32>) -> {RG.sub(A, List.append(&2, U32, A, B)) == True{} : Bool}:
  match A:
    case Nil{}:
      {==}
    case Con{+x, +r}:
      MB.and_eq_true(RG.has(Con{x, List.append(&2, U32, r, B)}, x), RG.sub(r, Con{x, List.append(&2, U32, r, B)}), GP.has_self(x, List.append(&2, U32, r, B)), GP.sub_cons_r(r, x, List.append(&2, U32, r, B), sub_app_l(r, B)))

def sub_app_r(A: List<&2, U32>, +B: List<&2, U32>) -> {RG.sub(B, List.append(&2, U32, A, B)) == True{} : Bool}:
  match A:
    case Nil{}:
      GP.sub_refl(B)
    case Con{+x, +r}:
      GP.sub_cons_r(B, x, List.append(&2, U32, r, B), sub_app_r(r, B))

def sub_app2(X: List<&2, U32>, +Y: List<&2, U32>, +M: List<&2, U32>, +hx: {RG.sub(X, M) == True{} : Bool}, +hy: {RG.sub(Y, M) == True{} : Bool}) -> {RG.sub(List.append(&2, U32, X, Y), M) == True{} : Bool}:
  match X:
    case Nil{}:
      hy
    case Con{+x, +r}:
      MB.and_eq_true(RG.has(M, x), RG.sub(List.append(&2, U32, r, Y), M), MB.eq_true_of_and_left(RG.has(M, x), RG.sub(r, M), hx), sub_app2(r, Y, M, MB.eq_true_of_and_right(RG.has(M, x), RG.sub(r, M), hx), hy))

def sub_app_mono(+A: List<&2, U32>, +B: List<&2, U32>, +C: List<&2, U32>, +hs: {RG.sub(B, C) == True{} : Bool}) -> {RG.sub(List.append(&2, U32, A, B), List.append(&2, U32, A, C)) == True{} : Bool}:
  sub_app2(A, B, List.append(&2, U32, A, C), sub_app_l(A, C), GP.sub_trans(B, C, List.append(&2, U32, A, C), hs, sub_app_r(A, C)))

def ol_app(A: List<&2, U32>, +B: List<&2, U32>, +d: Nat, +i: U32, +ha: {RG.off.links(A, d, i) == True{} : Bool}, +hb: {RG.off.links(B, d, i) == True{} : Bool}) -> {RG.off.links(List.append(&2, U32, A, B), d, i) == True{} : Bool}:
  match A:
    case Nil{}:
      hb
    case Con{+y, +r}:
      MB.and_eq_true(Bool.not(Nat.is_eq(AD.slot(i, d), AD.slot((y + 3 : U32), d))), RG.off.links(List.append(&2, U32, r, B), d, i), MB.eq_true_of_and_left(Bool.not(Nat.is_eq(AD.slot(i, d), AD.slot((y + 3 : U32), d))), RG.off.links(r, d, i), ha), ol_app(r, B, d, i, MB.eq_true_of_and_right(Bool.not(Nat.is_eq(AD.slot(i, d), AD.slot((y + 3 : U32), d))), RG.off.links(r, d, i), ha), hb))

def op_app(A: List<&2, U32>, +B: List<&2, U32>, +d: Nat, +i: U32, +ha: {RG.off.pos(A, d, i) == True{} : Bool}, +hb: {RG.off.pos(B, d, i) == True{} : Bool}) -> {RG.off.pos(List.append(&2, U32, A, B), d, i) == True{} : Bool}:
  match A:
    case Nil{}:
      hb
    case Con{+y, +r}:
      MB.and_eq_true(Bool.not(Nat.is_eq(AD.slot(i, d), AD.slot((y + 2 : U32), d))), RG.off.pos(List.append(&2, U32, r, B), d, i), MB.eq_true_of_and_left(Bool.not(Nat.is_eq(AD.slot(i, d), AD.slot((y + 2 : U32), d))), RG.off.pos(r, d, i), ha), op_app(r, B, d, i, MB.eq_true_of_and_right(Bool.not(Nat.is_eq(AD.slot(i, d), AD.slot((y + 2 : U32), d))), RG.off.pos(r, d, i), ha), hb))

def port_app(+A: List<&2, U32>, +B: List<&2, U32>, +d: Nat, +r: U32, +ha: {RG.port.ok(A, d, r) == True{} : Bool}, +hb: {RG.port.ok(B, d, r) == True{} : Bool}) -> {RG.port.ok(List.append(&2, U32, A, B), d, r) == True{} : Bool}:
  MB.and_eq_true(RG.off.links(List.append(&2, U32, A, B), d, (r + 1 : U32)), RG.off.pos(List.append(&2, U32, A, B), d, (r + 1 : U32)), ol_app(A, B, d, (r + 1 : U32), MB.eq_true_of_and_left(RG.off.links(A, d, (r + 1 : U32)), RG.off.pos(A, d, (r + 1 : U32)), ha), MB.eq_true_of_and_left(RG.off.links(B, d, (r + 1 : U32)), RG.off.pos(B, d, (r + 1 : U32)), hb)), op_app(A, B, d, (r + 1 : U32), MB.eq_true_of_and_right(RG.off.links(A, d, (r + 1 : U32)), RG.off.pos(A, d, (r + 1 : U32)), ha), MB.eq_true_of_and_right(RG.off.links(B, d, (r + 1 : U32)), RG.off.pos(B, d, (r + 1 : U32)), hb)))

def fm_app(m: Maybe<&2, U32>, +d: Nat, +A: List<&2, U32>, +B: List<&2, U32>, +ha: {RG.faces.m(m, d, A) == True{} : Bool}, +hb: {RG.faces.m(m, d, B) == True{} : Bool}) -> {RG.faces.m(m, d, List.append(&2, U32, A, B)) == True{} : Bool}:
  match m:
    case Some{+r}:
      port_app(A, B, d, r, ha, hb)
    case None{}:
      ha

# faces against two lists, faces against both
def faces_two(ys: List<&2, U32>, +v: List<&2, U32>, +d: Nat, +A: List<&2, U32>, +B: List<&2, U32>, +ha: {RG.faces(ys, v, d, A) == True{} : Bool}, +hb: {RG.faces(ys, v, d, B) == True{} : Bool}) -> {RG.faces(ys, v, d, List.append(&2, U32, A, B)) == True{} : Bool}:
  match ys:
    case Nil{}:
      {==}
    case Con{+m, +r}:
      MB.and_eq_true(RG.faces.m(List.get(&2, U32, v, AD.slot((m + 1 : U32), d)), d, List.append(&2, U32, A, B)), RG.faces(r, v, d, List.append(&2, U32, A, B)), fm_app(List.get(&2, U32, v, AD.slot((m + 1 : U32), d)), d, A, B, MB.eq_true_of_and_left(RG.faces.m(List.get(&2, U32, v, AD.slot((m + 1 : U32), d)), d, A), RG.faces(r, v, d, A), ha), MB.eq_true_of_and_left(RG.faces.m(List.get(&2, U32, v, AD.slot((m + 1 : U32), d)), d, B), RG.faces(r, v, d, B), hb)), faces_two(r, v, d, A, B, MB.eq_true_of_and_right(RG.faces.m(List.get(&2, U32, v, AD.slot((m + 1 : U32), d)), d, A), RG.faces(r, v, d, A), ha), MB.eq_true_of_and_right(RG.faces.m(List.get(&2, U32, v, AD.slot((m + 1 : U32), d)), d, B), RG.faces(r, v, d, B), hb)))

# faces of two lists appended
def faces_app(A: List<&2, U32>, +B: List<&2, U32>, +v: List<&2, U32>, +d: Nat, +M: List<&2, U32>, +ha: {RG.faces(A, v, d, M) == True{} : Bool}, +hb: {RG.faces(B, v, d, M) == True{} : Bool}) -> {RG.faces(List.append(&2, U32, A, B), v, d, M) == True{} : Bool}:
  match A:
    case Nil{}:
      hb
    case Con{+m, +r}:
      MB.and_eq_true(RG.faces.m(List.get(&2, U32, v, AD.slot((m + 1 : U32), d)), d, M), RG.faces(List.append(&2, U32, r, B), v, d, M), MB.eq_true_of_and_left(RG.faces.m(List.get(&2, U32, v, AD.slot((m + 1 : U32), d)), d, M), RG.faces(r, v, d, M), ha), faces_app(r, B, v, d, M, MB.eq_true_of_and_right(RG.faces.m(List.get(&2, U32, v, AD.slot((m + 1 : U32), d)), d, M), RG.faces(r, v, d, M), ha), hb))

# Distinct lists
def bff(+x: Bool, +y: Bool, +hx: {x == False{} : Bool}, +hy: {y == False{} : Bool}) -> {Bool.or(x, y) == False{} : Bool}:
  %Equal.sym(Bool, x, False{}, hx) : {Bool.or(_, y) == False{} : Bool}
  hy

def orf_l(+x: Bool, +y: Bool, +h: {Bool.or(x, y) == False{} : Bool}) -> {x == False{} : Bool}:
  match x:
    case True{}:
      Empty.absurd({True{} == False{} : Bool}, MB.false_ne_true()(Equal.sym(Bool, True{}, False{}, h)))
    case False{}:
      {==}

def orf_r(+x: Bool, +y: Bool, +h: {Bool.or(x, y) == False{} : Bool}) -> {y == False{} : Bool}:
  match x:
    case True{}:
      Empty.absurd({y == False{} : Bool}, MB.false_ne_true()(Equal.sym(Bool, True{}, False{}, h)))
    case False{}:
      h

def nott(+x: Bool, +hx: {x == False{} : Bool}) -> {Bool.not(x) == True{} : Bool}:
  %Equal.sym(Bool, x, False{}, hx) : {Bool.not(_) == True{} : Bool}
  {==}

# a node apart from b is not b
def neq_k(+e: Bool, +a: U32, +b: U32, +d: Nat, +he: {U32.is_eq(b, a) == e : Bool}, +h: {RG.disj4(d, a, b) == True{} : Bool}) -> {e == False{} : Bool}:
  match e:
    case False{}:
      {==}
    case True{}:
      Empty.absurd({True{} == False{} : Bool}, MB.false_ne_true()(ME.subst(Bool, z => {Bool.not(z) == True{} : Bool}, Nat.is_eq(AD.slot(a, d), AD.slot(a, d)), True{}, MN.is_eq_refl(AD.slot(a, d)),
        MB.eq_true_of_and_left(Bool.not(Nat.is_eq(AD.slot(a, d), AD.slot(a, d))), RG.off(Con{(a + 1 : U32), Con{(a + 2 : U32), Con{(a + 3 : U32), Nil{}}}}, d, a), MB.eq_true_of_and_left(RG.off(Con{a, Con{(a + 1 : U32), Con{(a + 2 : U32), Con{(a + 3 : U32), Nil{}}}}}, d, a), Bool.and(RG.off(Con{a, Con{(a + 1 : U32), Con{(a + 2 : U32), Con{(a + 3 : U32), Nil{}}}}}, d, (a + 1 : U32)), Bool.and(RG.off(Con{a, Con{(a + 1 : U32), Con{(a + 2 : U32), Con{(a + 3 : U32), Nil{}}}}}, d, (a + 2 : U32)), RG.off(Con{a, Con{(a + 1 : U32), Con{(a + 2 : U32), Con{(a + 3 : U32), Nil{}}}}}, d, (a + 3 : U32)))), ME.subst(U32, z => {RG.disj4(d, a, z) == True{} : Bool}, b, a, MS.u32_eq_of_is_eq(b, a, he), h))))))

def neq(+a: U32, +b: U32, +d: Nat, +h: {RG.disj4(d, a, b) == True{} : Bool}) -> {U32.is_eq(b, a) == False{} : Bool}:
  neq_k(U32.is_eq(b, a), a, b, d, {==}, h)

def cross_notin(t: List<&2, U32>, +d: Nat, +a: U32, +h: {RG.cross(t, d, a) == True{} : Bool}) -> {RG.has(t, a) == False{} : Bool}:
  match t:
    case Nil{}:
