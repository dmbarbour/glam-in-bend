def Laws.serve_root_keeps(w, a, map, d, dm, ts, ls, by, ns, s, t, cs, nc, rn, rp, j, hf, hd32, hfm, hdm, hr, hc, hl, hlay, hbs, hdy, hpa, hhd, hfr, ht, hcp, hnc, hu, hro, hj, hjr, hjh, hjf):
