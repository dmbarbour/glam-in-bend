                  lfull_go(rest, KMd.words(P.link_xx(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1)) + p1 : U32), (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n2)) + p2 : U32))), KMd.vals(P.link_xx(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1)) + p1 : U32), (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n2)) + p2 : U32))), LAT.fromT(U32, tm), d, SPP.lxf(P.is_static((Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1)) + p1 : U32)), P.is_static((Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n2)) + p2 : U32)), t0, LAT.fromT(V.Val, ta), d, (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1)) + p1 : U32), (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n2)) + p2 : U32), hft), LAT.mirror(U32, KMd.words(P.link_xx(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1)) + p1 : U32), (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n2)) + p2 : U32)))), LAT.mirror(V.Val, KMd.vals(P.link_xx(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n1)) + p1 : U32), (Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), n2)) + p2 : U32)))), LAT.mirror(U32, LAT.fromT(U32, tm)))

# Lists appended
def sub_app_l(A: List<&2, U32>, +B: List<&2, U32>) -> {RG.sub(A, List.append(&2, U32, A, B)) == True{} : Bool}:
  match A:
    case Nil{}:
      {==}
    case Con{+x, +r}:
      MB.and_eq_true(RG.has(Con{x, List.append(&2, U32, r, B)}, x), RG.sub(r, Con{x, List.append(&2, U32, r, B)}), GP.has_self(x, List.append(&2, U32, r, B)), GP.sub_cons_r(r, x, List.append(&2, U32, r, B), sub_app_l(r, B)))

def sub_app_r(A: List<&2, U32>, +B: List<&2, U32>) -> {RG.sub(B, List.append(&2, U32, A, B)) == True{} : Bool}:
  match A:
    case Nil{}:
      GP.sub_refl(B)
    case Con{+x, +r}:
      GP.sub_cons_r(B, x, List.append(&2, U32, r, B), sub_app_r(r, B))

def sub_app2(X: List<&2, U32>, +Y: List<&2, U32>, +M: List<&2, U32>, +hx: {RG.sub(X, M) == True{} : Bool}, +hy: {RG.sub(Y, M) == True{} : Bool}) -> {RG.sub(List.append(&2, U32, X, Y), M) == True{} : Bool}:
  match X:
    case Nil{}:
      hy
    case Con{+x, +r}:
      MB.and_eq_true(RG.has(M, x), RG.sub(List.append(&2, U32, r, Y), M), MB.eq_true_of_and_left(RG.has(M, x), RG.sub(r, M), hx), sub_app2(r, Y, M, MB.eq_true_of_and_right(RG.has(M, x), RG.sub(r, M), hx), hy))

def sub_app_mono(+A: List<&2, U32>, +B: List<&2, U32>, +C: List<&2, U32>, +hs: {RG.sub(B, C) == True{} : Bool}) -> {RG.sub(List.append(&2, U32, A, B), List.append(&2, U32, A, C)) == True{} : Bool}:
  sub_app2(A, B, List.append(&2, U32, A, C), sub_app_l(A, C), GP.sub_trans(B, C, List.append(&2, U32, A, C), hs, sub_app_r(A, C)))

def bases_app(A: List<&2, U32>, +B: List<&2, U32>, +ha: {RG.bases(A) == True{} : Bool}, +hb: {RG.bases(B) == True{} : Bool}) -> {RG.bases(List.append(&2, U32, A, B)) == True{} : Bool}:
