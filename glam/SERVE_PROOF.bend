def serve_go(-w: Array<U32>, -a: Array<V.Val>, -map: Array<U32>, +d: Nat, +dm: Nat, +ts: List<&2, T.TNode>, +ls: List<&2, T.TLink>, +by: U32, +ns: List<&2, U32>, +s: U32, +t: List<&2, U32>, +cs: List<&2, R.FzC>, +j: U32,
    hf: {AD.full(U32, w, d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool}, hfm: {AD.full(U32, map, dm) == True{} : Bool}, +hdm: {Nat.is_lt(dm, 32n) == True{} : Bool}, hr: {RG.ring.ok(AD.view(U32, w), d, s, t) == True{} : Bool},
    hc: {KMd.chain(ns, AD.view(U32, w), d, KMd.word(AD.view(U32, w), d, P.at_fh())) == True{} : Bool}, +hl: {SM.made(ts) == List.length(&2, U32, ns) : Nat}, +hlay: {RG.layout(List.append(&2, U32, Con{s, t}, ns), d) == True{} : Bool},
    +hbs: {RG.bases(ns) == True{} : Bool}, +hdy: {SV.dyn(ns) == True{} : Bool}, +hpa: {KMd.past(List.append(&2, U32, Con{s, t}, ns), d) == True{} : Bool}, +hhd: {KMd.off.words(KMd.hdr_words(), d, P.at_fh()) == True{} : Bool}, hfr: {RG.faces(Con{s, t}, AD.view(U32, w), d, ns) == True{} : Bool},
    +ht: {SM.tpl.ok(ls, ts, dm) == True{} : Bool}, +hcp: {SV.copy.ok(cs, ls, ts, dm) == True{} : Bool}, +hj: {KMd.nodes.off(ns, d, j) == True{} : Bool}, +hjr: {RG.off.nodes(Con{s, t}, d, j) == True{} : Bool}, +hjh: {KMd.off.words(KMd.hdr_all(), d, j) == True{} : Bool},
    hjf: {RG.off.ports(RG.faced(Con{s, t}, AD.view(U32, w), d), d, j) == True{} : Bool}, mw: LAT.Mirror(U32, w), ma: LAT.Mirror(V.Val, a), mm: LAT.Mirror(U32, map)) ->
  {Pair.snd(P.H, U32, P.rd(Pair.snd(Array<U32>, P.H, R.crossings(cs, (SM.map(S.sp.links(ls, S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{w}, a}, map}, by))), SM.heap(S.sp.links(ls, S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{w}, a}, map}, by)))), s)), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{w}, a}, j)) : U32}:
  (+t0, +ew) = mw
  (+ta, +ea) = ma
  (+tm, +em) = mm
  +hft = LAP.full_t(U32, w, t0, d, ew, hf)
  +hfmt = LAP.full_t(U32, map, tm, dm, em, hfm)
  +hr2 = LAB.subst(Array<U32>, q => {RG.ring.ok(AD.view(U32, q), d, s, t) == True{} : Bool}, w, LAT.fromT(U32, t0), Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, ew), hr)
  +hct = LAB.subst(Array<U32>, q => {KMd.chain(ns, AD.view(U32, q), d, KMd.word(AD.view(U32, q), d, P.at_fh())) == True{} : Bool}, w, LAT.fromT(U32, t0), Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, ew), hc)
  +hfr2 = LAB.subst(Array<U32>, q => {RG.faces(Con{s, t}, AD.view(U32, q), d, ns) == True{} : Bool}, w, LAT.fromT(U32, t0), Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, ew), hfr)
  +hjf2 = LAB.subst(Array<U32>, q => {RG.off.ports(RG.faced(Con{s, t}, AD.view(U32, q), d), d, j) == True{} : Bool}, w, LAT.fromT(U32, t0), Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, ew), hjf)
  %ew : {Pair.snd(P.H, U32, P.rd(Pair.snd(Array<U32>, P.H, R.crossings(cs, (SM.map(S.sp.links(ls, S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{_}, a}, map}, by))), SM.heap(S.sp.links(ls, S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{_}, a}, map}, by)))), s)), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{_}, a}, j)) : U32}
  %ea : {Pair.snd(P.H, U32, P.rd(Pair.snd(Array<U32>, P.H, R.crossings(cs, (SM.map(S.sp.links(ls, S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, _}, map}, by))), SM.heap(S.sp.links(ls, S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, _}, map}, by)))), s)), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{LAT.fromT(U32, t0)}, _}, j)) : U32}
  %em : {Pair.snd(P.H, U32, P.rd(Pair.snd(Array<U32>, P.H, R.crossings(cs, (SM.map(S.sp.links(ls, S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, _}, by))), SM.heap(S.sp.links(ls, S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, _}, by)))), s)), j)) == Pair.snd(P.H, U32, P.rd(P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, j)) : U32}
  serve_core(ts, ls, t0, ta, tm, d, dm, by, ns, s, t, hft, hd32, hfmt, hdm, hr2, hct, hl, hlay, hbs, hdy, hpa, hhd, hfr2, ht, cs, hcp, j, hj, hjr, hjh, hjf2)

def Laws.serve_keeps(w, a, map, d, dm, ts, ls, by, ns, s, t, cs, j, hf, hd32, hfm, hdm, hr, hc, hl, hlay, hbs, hdy, hpa, hhd, hfr, ht, hcp, hj, hjr, hjh, hjf):
  serve_go(w, a, map, d, dm, ts, ls, by, ns, s, t, cs, j, hf, hd32, hfm, hdm, hr, hc, hl, hlay, hbs, hdy, hpa, hhd, hfr, ht, hcp, hj, hjr, hjh, hjf, LAT.mirror(U32, w), LAT.mirror(V.Val, a), LAT.mirror(U32, map))

# The served cursor leaving at the source's root (serve_ring_exact). The
# crossings keep the map they read
def cr_map(cs: List<&2, R.FzC>, -mp: Array<U32>, -h: P.H, +s: U32, mm: LAT.Mirror(U32, mp)) -> {Pair.fst(Array<U32>, P.H, R.crossings(cs, (mp, h), s)) == mp : Array<U32>}:
  match cs:
    case Nil{}:
      {==}
    case Con{c, +rest}:
      match c:
        case R.FzC{+at, +src, +neg, +far}:
          (+tm, +em) = mm
          %em : {Pair.fst(Array<U32>, P.H, R.crossings(Con{R.FzC{at, src, neg, far}, rest}, (_, h), s)) == _ : Array<U32>}
          %Equal.sym(Array<U32> & U32, Array.get(U32, LAT.fromT(U32, tm), at), (LAT.fromT(U32, tm), Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at))), LA.get_pair(U32, LAT.fromT(U32, tm), at)) :
            {Pair.fst(Array<U32>, P.H, R.crossings(rest, R.crossing.pl(_, h, s, src, neg, far), s)) == LAT.fromT(U32, tm) : Array<U32>}
          cr_map(rest, LAT.fromT(U32, tm), R.cross(h, s, Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)), src, neg, far), s, LAT.mirror(U32, LAT.fromT(U32, tm)))

# no crossing finds c's position in a view that reads c's word 2 alike
def unf_agree(cs: List<&2, R.FzC>, +v1: List<&2, U32>, +v0: List<&2, U32>, +d: Nat, +c: U32,
    +he: {List.get(&2, U32, v1, AD.slot((c + 2 : U32), d)) == List.get(&2, U32, v0, AD.slot((c + 2 : U32), d)) : Maybe<&2, U32>}, +h: {RG.unfound(cs, v0, d, c) == True{} : Bool}) -> {RG.unfound(cs, v1, d, c) == True{} : Bool}:
  match cs:
    case Nil{}:
      {==}
    case Con{f, +r}:
