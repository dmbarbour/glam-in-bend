  hp: {RG.pend.ok(AD.view(U32, w), d, s, rt, RG.pls(cl, AD.view(U32, map), dm), L) == True{} : Bool}, +hag: {RG.agree(rt, AD.view(U32, w), pv, d) == True{} : Bool}, +hpd: {GP.pdef(RG.pls(cl, AD.view(U32, map), dm), pv, d) == True{} : Bool},
