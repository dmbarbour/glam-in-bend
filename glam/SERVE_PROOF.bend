def crfi.go(cl: List<&2, R.FzC>, -w: Array<U32>, -a: Array<V.Val>, -map: Array<U32>, +d: Nat, +dm: Nat, +s: U32, +rt: List<&2, U32>, +L: List<&2, U32>, +pv: List<&2, U32>, +F: List<&2, U32>,
