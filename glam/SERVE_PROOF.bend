          +hfx = GP.cross_full.m(LAT.fromT(U32, tw), LAT.fromT(V.Val, ta), d, s, rt, Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)), src, neg, far, hft, hd32, hr0, LAT.mirror(U32, LAT.fromT(U32, tw)), LAT.mirror(V.Val, LAT.fromT(V.Val, ta)))
          +hfit = LAB.subst(Array<U32>, q => {GP.faced.in(L, AD.view(U32, q), d, F) == True{} : Bool}, w, LAT.fromT(U32, tw), Equal.sym(Array<U32>, LAT.fromT(U32, tw), w, ew), hfi)
          +hfin = GP.crf.m(LAT.fromT(U32, tw), LAT.fromT(V.Val, ta), d, s, rt, RG.pls(rest, AD.view(U32, LAT.fromT(U32, tm)), dm), L, Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)), src, neg, far, F, hft, hd32, hp3, hfit, LAT.mirror(U32, LAT.fromT(U32, tw)), LAT.mirror(V.Val, LAT.fromT(V.Val, ta)))
          +hfin2 = ME.subst(Maybe<&2, U32>, q => {GP.faced.in(RG.cross.L(q, Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)), L), AD.view(U32, RG.words(R.cross(P.H{KM.MG{LAT.fromT(U32, tw)}, LAT.fromT(V.Val, ta)}, s, Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)), src, neg, far))), d, F) == True{} : Bool}, RG.first(rt, AD.view(U32, LAT.fromT(U32, tw)), d, far), RG.first(rt, pv, d, far), eF, hfin)
          %ew : {GP.faced.in(Pair.snd(List<&2, U32>, List<&2, U32>, RG.cr(Con{R.FzC{at, src, neg, far}, rest}, AD.view(U32, map), dm, pv, d, rt, L)), AD.view(U32, RG.words(Pair.snd(Array<U32>, P.H, R.crossings(Con{R.FzC{at, src, neg, far}, rest}, (map, P.H{KM.MG{_}, a}), s)))), d, F) == True{} : Bool}
          %ea : {GP.faced.in(Pair.snd(List<&2, U32>, List<&2, U32>, RG.cr(Con{R.FzC{at, src, neg, far}, rest}, AD.view(U32, map), dm, pv, d, rt, L)), AD.view(U32, RG.words(Pair.snd(Array<U32>, P.H, R.crossings(Con{R.FzC{at, src, neg, far}, rest}, (map, P.H{KM.MG{LAT.fromT(U32, tw)}, _}), s)))), d, F) == True{} : Bool}
