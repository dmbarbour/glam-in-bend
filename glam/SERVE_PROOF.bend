# whether a list's head is x: a recursion's split on it, as a parameter
def hdeq(xs: List<&2, U32>, +x: U32) -> Bool:
  match xs:
    case Nil{}:
      False{}
    case Con{+y, +r}:
      U32.is_eq(y, x)

