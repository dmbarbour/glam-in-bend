            e => SPP.or_r(U32.is_eq(RG.pl.of(List.get(&2, U32, vm, AD.slot(a2, dm))), RG.pl.of(List.get(&2, U32, vm, AD.slot(at, dm)))), RG.has(RG.pls(r, vm, dm), RG.pl.of(List.get(&2, U32, vm, AD.slot(at, dm)))), pls_has(r, vm, dm, at, e)))

