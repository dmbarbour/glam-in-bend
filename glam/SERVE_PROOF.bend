# A word off every copy node that is no hole: a hole's faced port's link
# word off it (the copy's hand-off over the index: the holes' own words)
def has_minus.k(+e: Bool, +x: U32, +r: List<&2, U32>, +ys: List<&2, U32>, +c: U32, +he: {RG.has(ys, x) == e : Bool}, +hr: {RG.has(RG.minus(r, ys), c) == True{} : Bool}) ->
  {RG.has(RG.minus.k(e, x, RG.minus(r, ys)), c) == True{} : Bool}:
  match e:
    case True{}:
      hr
    case False{}:
      SPP.or_r(U32.is_eq(x, c), RG.has(RG.minus(r, ys), c), hr)

def has_minus.x(+e: Bool, +x: U32, +r: List<&2, U32>, +ys: List<&2, U32>, +he: {RG.has(ys, x) == e : Bool}, +hy: {RG.has(ys, x) == False{} : Bool}) ->
  {RG.has(RG.minus.k(e, x, RG.minus(r, ys)), x) == True{} : Bool}:
  match e:
    case True{}:
      Empty.absurd({RG.has(RG.minus.k(True{}, x, RG.minus(r, ys)), x) == True{} : Bool}, MB.false_ne_true()(Equal.trans(Bool, False{}, RG.has(ys, x), True{}, Equal.sym(Bool, RG.has(ys, x), False{}, hy), he)))
    case False{}:
      SPP.or_l(U32.is_eq(x, x), RG.has(RG.minus(r, ys), x), SPP.u32_refl(x))

def has_minus(xs: List<&2, U32>, +ys: List<&2, U32>, +c: U32, hx: {RG.has(xs, c) == True{} : Bool}, +hy: {RG.has(ys, c) == False{} : Bool}) -> {RG.has(RG.minus(xs, ys), c) == True{} : Bool}:
  match xs:
    case Nil{}:
      Empty.absurd({RG.has(RG.minus([], ys), c) == True{} : Bool}, MB.false_ne_true()(hx))
    case Con{+x, +r}:
      SPP.or_cases(U32.is_eq(x, c), RG.has(r, c), RG.has(RG.minus(Con{x, r}, ys), c), hx,
        q => ME.subst(U32, z => {RG.has(RG.minus(Con{z, r}, ys), c) == True{} : Bool}, c, x, Equal.sym(U32, x, c, MS.u32_eq_of_is_eq(x, c, q)),
          has_minus.x(RG.has(ys, c), c, r, ys, {==}, hy)),
        q => has_minus.k(RG.has(ys, x), x, r, ys, c, {==}, has_minus(r, ys, c, q, hy)))

def off_fresh2(+cs: List<&2, R.FzC>, +ts: List<&2, T.TNode>, +ls: List<&2, T.TLink>, +t0: LAT.Tree<U32>, +ta: LAT.Tree<V.Val>, +tm: LAT.Tree<U32>, +d: Nat, +dm: Nat, +by: U32, +ns: List<&2, U32>, +s: U32, +t: List<&2, U32>,
    +hft: {AD.full(U32, LAT.fromT(U32, t0), d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool}, +hfmt: {AD.full(U32, LAT.fromT(U32, tm), dm) == True{} : Bool}, +hdm: {Nat.is_lt(dm, 32n) == True{} : Bool},
    +hct: {KMd.chain(ns, AD.view(U32, LAT.fromT(U32, t0)), d, KMd.word(AD.view(U32, LAT.fromT(U32, t0)), d, P.at_fh())) == True{} : Bool}, +hl: {SM.made(ts) == List.length(&2, U32, ns) : Nat},
    +hlay: {RG.layout(List.append(&2, U32, Con{s, t}, ns), d) == True{} : Bool}, +hbs: {RG.bases(ns) == True{} : Bool}, +hdy: {SV.dyn(ns) == True{} : Bool}, +hpa: {KMd.past(List.append(&2, U32, Con{s, t}, ns), d) == True{} : Bool}, +hhd: {KMd.off.words(KMd.hdr_words(), d, P.at_fh()) == True{} : Bool},
    +hfr: {RG.faces(Con{s, t}, AD.view(U32, LAT.fromT(U32, t0)), d, ns) == True{} : Bool}, +ht: {SM.tpl.ok(ls, ts, dm) == True{} : Bool}, +j: U32, +hj: {KMd.nodes.off(RG.minus(ns, RG.pls(cs, AD.view(U32, SM.map(S.sp.links(ls, S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by)))), dm)), d, j) == True{} : Bool}, +n: U32, +p: U32, +hk1: {SV.node.at(ts, dm, n) == True{} : Bool}, +hp: {SM.port3(p) == True{} : Bool}, +hnin: {SV.sl.in(SV.ats(cs), dm, n) == False{} : Bool}, +hh: {SV.holes.ok(SV.ats(cs), ls, ts, dm, SV.ats(cs)) == True{} : Bool}) ->
    {KMd.off.port(d, (KMd.word(AD.view(U32, SM.map(S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by))), dm, n) + p : U32), j) == True{} : Bool}:
  SPP.opk(P.is_static((KMd.word(AD.view(U32, SM.map(S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by))), dm, n) + p : U32)), d, (KMd.word(AD.view(U32, SM.map(S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by))), dm, n) + p : U32), j, SPP.lwoff(RG.minus(ns, RG.pls(cs, AD.view(U32, SM.map(S.sp.links(ls, S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by)))), dm)), KMd.word(AD.view(U32, SM.map(S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by))), dm, n), p, d, j, ME.subst(Bool, z => {z == True{} : Bool}, RG.has(RG.minus(ns, RG.pls(cs, AD.view(U32, SM.map(S.sp.links(ls, S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by)))), dm)), KMd.word(AD.view(U32, SM.map(S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by))), dm, n)), KMd.has(RG.minus(ns, RG.pls(cs, AD.view(U32, SM.map(S.sp.links(ls, S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by)))), dm)), KMd.word(AD.view(U32, SM.map(S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by))), dm, n)), Equal.sym(Bool, KMd.has(RG.minus(ns, RG.pls(cs, AD.view(U32, SM.map(S.sp.links(ls, S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by)))), dm)), KMd.word(AD.view(U32, SM.map(S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by))), dm, n)), RG.has(RG.minus(ns, RG.pls(cs, AD.view(U32, SM.map(S.sp.links(ls, S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by)))), dm)), KMd.word(AD.view(U32, SM.map(S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by))), dm, n)), hasb(RG.minus(ns, RG.pls(cs, AD.view(U32, SM.map(S.sp.links(ls, S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by)))), dm)), KMd.word(AD.view(U32, SM.map(S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by))), dm, n))), has_minus(ns, RG.pls(cs, AD.view(U32, SM.map(S.sp.links(ls, S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by)))), dm), KMd.word(AD.view(U32, SM.map(S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by))), dm, n), in_ns(ts, ls, t0, ta, tm, d, dm, by, ns, s, t, hft, hd32, hfmt, hdm, hct, hl, hlay, hbs, hdy, hpa, hhd, hfr, ht, n, hk1), ME.subst(U32, z => {RG.has(RG.pls(cs, AD.view(U32, SM.map(S.sp.links(ls, S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by)))), dm), z) == False{} : Bool}, RG.pl.of(List.get(&2, U32, AD.view(U32, SM.map(S.sp.links(ls, S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by)))), AD.slot(n, dm))), KMd.word(AD.view(U32, SM.map(S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by))), dm, n), hv_wv(ts, ls, t0, ta, tm, d, dm, by, ns, s, t, hft, hd32, hfmt, hdm, hct, hl, hlay, hbs, hdy, hpa, hhd, hfr, ht, n), hole_notin(cs, SV.ats(cs), ts, ls, t0, ta, tm, d, dm, by, ns, s, t, hft, hd32, hfmt, hdm, hct, hl, hlay, hbs, hdy, hpa, hhd, hfr, ht, n, hk1, hnin, hh)))), hp, hj))

def lw_holej2(lr: List<&2, T.TLink>, +cs: List<&2, R.FzC>, +ts: List<&2, T.TNode>, +ls: List<&2, T.TLink>, +t0: LAT.Tree<U32>, +ta: LAT.Tree<V.Val>, +tm: LAT.Tree<U32>, +d: Nat, +dm: Nat, +by: U32, +ns: List<&2, U32>, +s: U32, +t: List<&2, U32>,
    +hft: {AD.full(U32, LAT.fromT(U32, t0), d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool}, +hfmt: {AD.full(U32, LAT.fromT(U32, tm), dm) == True{} : Bool}, +hdm: {Nat.is_lt(dm, 32n) == True{} : Bool},
    +hct: {KMd.chain(ns, AD.view(U32, LAT.fromT(U32, t0)), d, KMd.word(AD.view(U32, LAT.fromT(U32, t0)), d, P.at_fh())) == True{} : Bool}, +hl: {SM.made(ts) == List.length(&2, U32, ns) : Nat},
    +hlay: {RG.layout(List.append(&2, U32, Con{s, t}, ns), d) == True{} : Bool}, +hbs: {RG.bases(ns) == True{} : Bool}, +hdy: {SV.dyn(ns) == True{} : Bool}, +hpa: {KMd.past(List.append(&2, U32, Con{s, t}, ns), d) == True{} : Bool}, +hhd: {KMd.off.words(KMd.hdr_words(), d, P.at_fh()) == True{} : Bool},
    +hfr: {RG.faces(Con{s, t}, AD.view(U32, LAT.fromT(U32, t0)), d, ns) == True{} : Bool}, +ht: {SM.tpl.ok(ls, ts, dm) == True{} : Bool}, +at: U32, +hna: {SV.node.at(ts, dm, at) == True{} : Bool}, +hat: {RG.has(SV.ats(cs), at) == True{} : Bool}, +hh: {SV.holes.ok(SV.ats(cs), ls, ts, dm, SV.ats(cs)) == True{} : Bool}, +j: U32, +hj: {KMd.nodes.off(RG.minus(ns, RG.pls(cs, AD.view(U32, SM.map(S.sp.links(ls, S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by)))), dm)), d, j) == True{} : Bool},
    +c1: Bool, +hc1: {c1 == hd1(lr, dm, at) : Bool}, +c2: Bool, +hc2: {c2 == hd2(lr, dm, at) : Bool}, +old: U32, +hold: {Bool.or(KMd.off.port(d, old, j), SV.names(lr, dm, at)) == True{} : Bool},
    +htl: {SM.tpl.ok(lr, ts, dm) == True{} : Bool}, +hhl: {SV.hole.links(lr, ts, dm, at, SV.ats(cs)) == True{} : Bool}) -> {KMd.off.port(d, SM.lw(lr, AD.view(U32, SM.map(S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by))), dm, d, (KMd.word(AD.view(U32, SM.map(S.sp.nodes(ts, 0, S.Sp{P.H{KM.MG{LAT.fromT(U32, t0)}, LAT.fromT(V.Val, ta)}, LAT.fromT(U32, tm)}, by))), dm, at) + 1 : U32), old), j) == True{} : Bool}:
  match lr:
    case Nil{}:
      orfalse(KMd.off.port(d, old, j), hold)
    case Con{l, +rest}:
      match l:
        case T.TL{e1, e2}:
          match e1:
            case T.TE{+n1, +p1}:
              match e2:
                case T.TE{+n2, +p2}:
                  match c1:
                    case True{}:
                      +heq = Equal.sym(Bool, True{}, SV.sl.eq(n1, at, dm), hc1)
                      +xa = ME.subst(Bool, z => {Bool.or(Bool.not(z), Bool.and(U32.is_eq(p1, 0), Bool.and(SV.node.at(ts, dm, n2), Bool.not(SV.sl.in(SV.ats(cs), dm, n2))))) == True{} : Bool}, SV.sl.eq(n1, at, dm), True{}, heq, MB.eq_true_of_and_left(SV.hole.end(n1, p1, n2, ts, dm, at, SV.ats(cs)), Bool.and(SV.hole.end(n2, p2, n1, ts, dm, at, SV.ats(cs)), SV.hole.links(rest, ts, dm, at, SV.ats(cs))), hhl))
                      +k2 = MB.eq_true_of_and_left(SV.node.at(ts, dm, n2), Bool.not(SV.sl.in(SV.ats(cs), dm, n2)), MB.eq_true_of_and_right(U32.is_eq(p1, 0), Bool.and(SV.node.at(ts, dm, n2), Bool.not(SV.sl.in(SV.ats(cs), dm, n2))), xa))
