# Distinct lists
def bff(+x: Bool, +y: Bool, +hx: {x == False{} : Bool}, +hy: {y == False{} : Bool}) -> {Bool.or(x, y) == False{} : Bool}:
  %Equal.sym(Bool, x, False{}, hx) : {Bool.or(_, y) == False{} : Bool}
  hy

def orf_l(+x: Bool, +y: Bool, +h: {Bool.or(x, y) == False{} : Bool}) -> {x == False{} : Bool}:
  match x:
    case True{}:
      Empty.absurd({True{} == False{} : Bool}, MB.false_ne_true()(Equal.sym(Bool, True{}, False{}, h)))
    case False{}:
      {==}

def orf_r(+x: Bool, +y: Bool, +h: {Bool.or(x, y) == False{} : Bool}) -> {y == False{} : Bool}:
  match x:
    case True{}:
      Empty.absurd({y == False{} : Bool}, MB.false_ne_true()(Equal.sym(Bool, True{}, False{}, h)))
    case False{}:
      h

def nott(+x: Bool, +hx: {x == False{} : Bool}) -> {Bool.not(x) == True{} : Bool}:
  %Equal.sym(Bool, x, False{}, hx) : {Bool.not(_) == True{} : Bool}
  {==}

# a node apart from b is not b
def neq_k(+e: Bool, +a: U32, +b: U32, +d: Nat, +he: {U32.is_eq(b, a) == e : Bool}, +h: {RG.disj4(d, a, b) == True{} : Bool}) -> {e == False{} : Bool}:
  match e:
    case False{}:
      {==}
    case True{}:
