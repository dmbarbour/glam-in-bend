          +hpd2 = ME.subst(U32, q => {GP.pdef(Con{q, RG.pls(rest, AD.view(U32, LAT.fromT(U32, tm)), dm)}, pv, d) == True{} : Bool}, RG.pl.of(List.get(&2, U32, AD.view(U32, LAT.fromT(U32, tm)), AD.slot(at, dm))), Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)), ePL, hpd1)
          +hpd0 = MB.eq_true_of_and_left(GP.issome(List.get(&2, U32, pv, AD.slot((Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)) + 2 : U32), d))), GP.pdef(RG.pls(rest, AD.view(U32, LAT.fromT(U32, tm)), dm), pv, d), hpd2)
