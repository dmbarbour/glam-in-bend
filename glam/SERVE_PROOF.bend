# Two holes apart: at two slots apart, the node pass's fold leaves two
# nodes, if both are nodes, distinct. Small facts of Bool
def hasb(xs: List<&2, U32>, +x: U32) -> {KMd.has(xs, x) == RG.has(xs, x) : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+y, +r}:
      ME.subst(Bool, z => {Bool.or(U32.is_eq(y, x), KMd.has(r, x)) == Bool.or(U32.is_eq(y, x), z) : Bool}, KMd.has(r, x), RG.has(r, x), hasb(r, x), {==})

def andt(+x: Bool) -> {Bool.and(x, True{}) == x : Bool}:
  match x:
    case True{}:
      {==}
    case False{}:
      {==}

def andf(+x: Bool) -> {Bool.and(x, False{}) == False{} : Bool}:
  match x:
    case True{}:
      {==}
    case False{}:
      {==}

# an implication's conclusion weakened: not (a or b) to not b, or to not a
def imp_r(+c: Bool, +a: Bool, +b: Bool, +h: {Bool.or(Bool.not(c), Bool.not(Bool.or(a, b))) == True{} : Bool}) -> {Bool.or(Bool.not(c), Bool.not(b)) == True{} : Bool}:
  match c:
    case True{}:
      nott(b, orf_r(a, b, MB.eq_false_of_not_eq_true(Bool.or(a, b), h)))
    case False{}:
      {==}

def imp_l(+c: Bool, +a: Bool, +b: Bool, +h: {Bool.or(Bool.not(c), Bool.not(Bool.or(a, b))) == True{} : Bool}) -> {Bool.or(Bool.not(c), Bool.not(a)) == True{} : Bool}:
  match c:
    case True{}:
      nott(a, orf_l(a, b, MB.eq_false_of_not_eq_true(Bool.or(a, b), h)))
    case False{}:
      {==}

# an eraser's step keeps each slot's fact: the static written is no node
def e1(+b: Bool, +k: U32, +w: U32, +xs: List<&2, U32>, +h: {Bool.or(Bool.not(U32.is_eq(k, 1)), Bool.not(RG.has(xs, w))) == True{} : Bool}) -> {Bool.or(Bool.not(U32.is_eq(SM.pick(b, 2, k), 1)), Bool.not(RG.has(xs, SM.pick(b, P.era(), w)))) == True{} : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      h

def e3(+b1: Bool, +b2: Bool, +k1: U32, +w1: U32, +k2: U32, +w2: U32, +h: {Bool.or(Bool.not(Bool.and(U32.is_eq(k1, 1), U32.is_eq(k2, 1))), Bool.not(U32.is_eq(w1, w2))) == True{} : Bool}) ->
