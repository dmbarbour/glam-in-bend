# The served cursor's leave at the source's root, its frame
# (serve_root_keeps; cells-freeze.sharing.cursors.index.ring.leave): the
# port a node faces among Fp, its link word off j where Fp's all are
def fin_off(m: Maybe<&2, U32>, +d: Nat, +Fp: List<&2, U32>, +j: U32, +h: {GP.fin.m(m, d, Fp) == True{} : Bool}, +hops: {RG.off.ports(Fp, d, j) == True{} : Bool}) -> {KMd.off.port(d, KMd.word.m(m), j) == True{} : Bool}:
  match m:
    case Some{+r}:
      GP.ops_at(Fp, d, j, r, hops, h)
    case None{}:
      Empty.absurd({KMd.off.port(d, KMd.word.m(None{}), j) == True{} : Bool}, MB.false_ne_true()(h))

