          +hagn = GP.crs_agree(tw, ta, d, s, rt, RG.pls(rest, AD.view(U32, LAT.fromT(U32, tm)), dm), L, Pair.snd(Array<U32>, U32, Array.get(U32, LAT.fromT(U32, tm), at)), src, neg, far, pv, RG.first(rt, pv, d, far), eF, hft, hd32, hp3, hagt, hpd0)
