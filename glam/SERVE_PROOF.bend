# Lists appended: a sublist's part, membership, none and distinct
def has_app_back(A: List<&2, U32>, +B: List<&2, U32>, +x: U32, +h: {RG.has(List.append(&2, U32, A, B), x) == True{} : Bool}, +hb: {RG.has(B, x) == False{} : Bool}) -> {RG.has(A, x) == True{} : Bool}:
  match A:
    case Nil{}:
      Empty.absurd({RG.has([], x) == True{} : Bool}, MB.false_ne_true()(Equal.trans(Bool, False{}, RG.has(B, x), True{}, Equal.sym(Bool, RG.has(B, x), False{}, hb), h)))
    case Con{+y, +r}:
      GP.or_cases(U32.is_eq(y, x), RG.has(List.append(&2, U32, r, B), x), RG.has(Con{y, r}, x), h, q => SPP.or_l(U32.is_eq(y, x), RG.has(r, x), q),
        q => SPP.or_r(U32.is_eq(y, x), RG.has(r, x), has_app_back(r, B, x, q, hb)))

def sub_left(X: List<&2, U32>, +A: List<&2, U32>, +B: List<&2, U32>, +hs: {RG.sub(X, List.append(&2, U32, A, B)) == True{} : Bool}, +hn: {RG.none.in(B, X) == True{} : Bool}) -> {RG.sub(X, A) == True{} : Bool}:
  match X:
    case Nil{}:
      {==}
    case Con{+x, +r}:
      MB.and_eq_true(RG.has(A, x), RG.sub(r, A), has_app_back(A, B, x, MB.eq_true_of_and_left(RG.has(List.append(&2, U32, A, B), x), RG.sub(r, List.append(&2, U32, A, B)), hs), GP.none_has(B, Con{x, r}, x, hn, GP.has_head(x, r))), sub_left(r, A, B, MB.eq_true_of_and_right(RG.has(List.append(&2, U32, A, B), x), RG.sub(r, List.append(&2, U32, A, B)), hs), GP.none_sub(B, Con{x, r}, r, hn, GP.sub_cons_r(r, x, r, GP.sub_refl(r)))))

def none_appl(A: List<&2, U32>, +B: List<&2, U32>, +M: List<&2, U32>, +h: {RG.none.in(List.append(&2, U32, A, B), M) == True{} : Bool}) -> {RG.none.in(A, M) == True{} : Bool}:
  match A:
    case Nil{}:
      {==}
    case Con{+x, +r}:
      MB.and_eq_true(Bool.not(RG.has(M, x)), RG.none.in(r, M), MB.eq_true_of_and_left(Bool.not(RG.has(M, x)), RG.none.in(List.append(&2, U32, r, B), M), h), none_appl(r, B, M, MB.eq_true_of_and_right(Bool.not(RG.has(M, x)), RG.none.in(List.append(&2, U32, r, B), M), h)))

def none_appr(A: List<&2, U32>, +B: List<&2, U32>, +M: List<&2, U32>, +h: {RG.none.in(List.append(&2, U32, A, B), M) == True{} : Bool}) -> {RG.none.in(B, M) == True{} : Bool}:
  match A:
    case Nil{}:
      h
    case Con{+x, +r}:
      none_appr(r, B, M, MB.eq_true_of_and_right(Bool.not(RG.has(M, x)), RG.none.in(List.append(&2, U32, r, B), M), h))

def has_app_lf(A: List<&2, U32>, +B: List<&2, U32>, +x: U32, +h: {RG.has(List.append(&2, U32, A, B), x) == False{} : Bool}) -> {RG.has(A, x) == False{} : Bool}:
  match A:
    case Nil{}:
      {==}
    case Con{+y, +r}:
      GP.or_ff(U32.is_eq(y, x), RG.has(r, x), GP.or_false_l(U32.is_eq(y, x), RG.has(List.append(&2, U32, r, B), x), h), has_app_lf(r, B, x, GP.or_false_r(U32.is_eq(y, x), RG.has(List.append(&2, U32, r, B), x), h)))

def dist_pre(A: List<&2, U32>, +B: List<&2, U32>, +h: {RG.distinct(List.append(&2, U32, A, B)) == True{} : Bool}) -> {RG.distinct(A) == True{} : Bool}:
  match A:
    case Nil{}:
      {==}
    case Con{+x, +r}:
      MB.and_eq_true(Bool.not(RG.has(r, x)), RG.distinct(r), GP.nf2(RG.has(r, x), has_app_lf(r, B, x, MB.eq_false_of_not_eq_true(RG.has(List.append(&2, U32, r, B), x), MB.eq_true_of_and_left(Bool.not(RG.has(List.append(&2, U32, r, B), x)), RG.distinct(List.append(&2, U32, r, B)), h)))), dist_pre(r, B, MB.eq_true_of_and_right(Bool.not(RG.has(List.append(&2, U32, r, B), x)), RG.distinct(List.append(&2, U32, r, B)), h)))

def dist_suf(A: List<&2, U32>, +B: List<&2, U32>, +h: {RG.distinct(List.append(&2, U32, A, B)) == True{} : Bool}) -> {RG.distinct(B) == True{} : Bool}:
  match A:
    case Nil{}:
      h
    case Con{+x, +r}:
      dist_suf(r, B, MB.eq_true_of_and_right(Bool.not(RG.has(List.append(&2, U32, r, B), x)), RG.distinct(List.append(&2, U32, r, B)), h))

# A node past the header's words, of a list past them; a sublist past them
def kpast_at(Y: List<&2, U32>, +d: Nat, +n: U32, +hp: {KMd.past(Y, d) == True{} : Bool}, hn: {RG.has(Y, n) == True{} : Bool}) -> {KMd.ws.off(KMd.nw(n), KMd.hdr_all(), d) == True{} : Bool}:
  match Y:
    case Nil{}:
      Empty.absurd({KMd.ws.off(KMd.nw(n), KMd.hdr_all(), d) == True{} : Bool}, MB.false_ne_true()(hn))
