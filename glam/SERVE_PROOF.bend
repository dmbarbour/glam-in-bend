def fm_app(m: Maybe<&2, U32>, +d: Nat, +A: List<&2, U32>, +B: List<&2, U32>, +ha: {RG.faces.m(m, d, A) == True{} : Bool}, +hb: {RG.faces.m(m, d, B) == True{} : Bool}) -> {RG.faces.m(m, d, List.append(&2, U32, A, B)) == True{} : Bool}:
