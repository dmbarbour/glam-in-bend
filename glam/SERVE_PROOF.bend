# each node of K faces a port of L's faced ports, K in L
def fi_w(K: List<&2, U32>, +L: List<&2, U32>, -w: Array<U32>, +d: Nat, hf: {AD.full(U32, w, d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool}, +hs: {RG.sub(K, L) == True{} : Bool}, mw: LAT.Mirror(U32, w)) ->
    {GP.faced.in(K, AD.view(U32, w), d, RG.faced(L, AD.view(U32, w), d)) == True{} : Bool}:
  (+tw, +ew) = mw
  +hft = LAP.full_t(U32, w, tw, d, ew, hf)
  %ew : {GP.faced.in(K, AD.view(U32, _), d, RG.faced(L, AD.view(U32, _), d)) == True{} : Bool}
  GP.faced_init(K, L, tw, d, hft, hd32, hs)

