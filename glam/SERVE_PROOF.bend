def Laws.serve_ring_exact(w, a, map, d, dm, ts, ls, by, ns, s, t, cs, nc, rn, rp, hf, hd32, hfm, hdm, hr, hc, hl, hlay, hbs, hdy, hpa, hhd, hfr, ht, hcp, hnc, hu, hro):
