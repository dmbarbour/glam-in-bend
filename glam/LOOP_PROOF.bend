# a slot that holds a word holds the one it reads
def some_word(m: Maybe<&2, U32>, +h: {XP.is_some(m) == True{} : Bool}) -> {m == Some{KMd.word.m(m)} : Maybe<&2, U32>}:
  match m:
    case Some{+y}:
      {==}
    case None{}:
      Empty.absurd({None{} == Some{KMd.word.m(None{})} : Maybe<&2, U32>}, MB.false_ne_true()(h))

# the ring model's apartness is the index model's
def apart_br(ws: List<&2, U32>, +d: Nat, +h: {RG.apartw(ws, d) == True{} : Bool}) -> {IM.ws.apart(ws, d) == True{} : Bool}:
  match ws:
    case Nil{}:
      {==}
    case Con{+w, +t}:
      XP.and_intro(KMd.off.words(t, d, w), IM.ws.apart(t, d), SP.offw(t, d, w, XP.and_l(RG.off(t, d, w), RG.apartw(t, d), h)), apart_br(t, d, XP.and_r(RG.off(t, d, w), RG.apartw(t, d), h)))

