  Equal.trans(Bool, XP.is_some(List.get(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, v, AD.slot(P.at_fh(), d), nx), AD.slot(s, d), hd), AD.slot(ws_at(s, pi), d), 0), AD.slot((s + 1 : U32), d), P.era()), AD.slot((s + 2 : U32), d), k), AD.slot((s + 3 : U32), d), s), AD.slot(j, d))), XP.is_some(List.get(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, v, AD.slot(P.at_fh(), d), nx), AD.slot(s, d), hd), AD.slot(ws_at(s, pi), d), 0), AD.slot((s + 1 : U32), d), P.era()), AD.slot((s + 2 : U32), d), k), AD.slot(j, d))), True{}, sm_set(List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, v, AD.slot(P.at_fh(), d), nx), AD.slot(s, d), hd), AD.slot(ws_at(s, pi), d), 0), AD.slot((s + 1 : U32), d), P.era()), AD.slot((s + 2 : U32), d), k), AD.slot((s + 3 : U32), d), AD.slot(j, d), s), Equal.trans(Bool, XP.is_some(List.get(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, v, AD.slot(P.at_fh(), d), nx), AD.slot(s, d), hd), AD.slot(ws_at(s, pi), d), 0), AD.slot((s + 1 : U32), d), P.era()), AD.slot((s + 2 : U32), d), k), AD.slot(j, d))), XP.is_some(List.get(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, v, AD.slot(P.at_fh(), d), nx), AD.slot(s, d), hd), AD.slot(ws_at(s, pi), d), 0), AD.slot((s + 1 : U32), d), P.era()), AD.slot(j, d))), True{}, sm_set(List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, v, AD.slot(P.at_fh(), d), nx), AD.slot(s, d), hd), AD.slot(ws_at(s, pi), d), 0), AD.slot((s + 1 : U32), d), P.era()), AD.slot((s + 2 : U32), d), AD.slot(j, d), k), Equal.trans(Bool, XP.is_some(List.get(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, v, AD.slot(P.at_fh(), d), nx), AD.slot(s, d), hd), AD.slot(ws_at(s, pi), d), 0), AD.slot((s + 1 : U32), d), P.era()), AD.slot(j, d))), XP.is_some(List.g