def ba.lay(N: List<&2, U32>, +d: Nat, +h2: {Nat.is_le(2n, d) == True{} : Bool}, +hd: {Nat.is_le(d, 32n) == True{} : Bool}, +hB: {RG.bases(N) == True{} : Bool}, +hP: {KMd.past(N, d) == True{} : Bool}, +hI: {RG.nodes.in(N, d) == True{} : Bool}, +hD: {RG.distinct(N) == True{} : Bool}) ->
