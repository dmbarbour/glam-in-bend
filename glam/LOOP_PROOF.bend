# The root serve's conclusion to the next serve's premise (serve_root_next)
# ========================================================================

# a list headed by s without a node other than s: headed by s still
def wo_headed.s(+s: U32, +nc: U32, +r: List<&2, U32>, +hne: {U32.is_eq(s, nc) == False{} : Bool}) -> {LM.headed(RG.without(Con{s, r}, nc), s) == True{} : Bool}:
  %Equal.sym(List<&2, U32>, RG.without(Con{s, r}, nc), Con{s, RG.without(r, nc)}, wo_head(s, nc, r, hne)) : {LM.headed(_, s) == True{} : Bool}
  XP.is_eq_self(s)

def wo_headed(X: List<&2, U32>, +s: U32, +nc: U32, +hh: {LM.headed(X, s) == True{} : Bool}, +hne: {U32.is_eq(s, nc) == False{} : Bool}) -> {LM.headed(RG.without(X, nc), s) == True{} : Bool}:
  match X:
    case Nil{}:
      Empty.absurd({LM.headed(RG.without(Nil{}, nc), s) == True{} : Bool}, MB.false_ne_true()(hh))
    case Con{+x, +r}:
      ME.subst(U32, z => {LM.headed(RG.without(Con{z, r}, nc), s) == True{} : Bool}, s, x, Equal.sym(U32, x, s, MS.u32_eq_of_is_eq(x, s, hh)), wo_headed.s(s, nc, r, hne))

