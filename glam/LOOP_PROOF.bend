# The base case (situate_pend)
# ============================

# the leaf none of the free list: not its head s, and none of F
def nl_or(+s: U32, +leaf: U32, +F: List<&2, U32>, +h: {RG.none.in(Con{leaf, Nil{}}, Con{s, F}) == True{} : Bool}) ->
  {Bool.or(U32.is_eq(s, leaf), RG.has(F, leaf)) == False{} : Bool}:
  XP.not_true(Bool.or(U32.is_eq(s, leaf), RG.has(F, leaf)), XP.and_l(Bool.not(Bool.or(U32.is_eq(s, leaf), RG.has(F, leaf))), True{}, h))

def nl_s(+s: U32, +leaf: U32, +F: List<&2, U32>, +h: {RG.none.in(Con{leaf, Nil{}}, Con{s, F}) == True{} : Bool}) -> {U32.is_eq(s, leaf) == False{} : Bool}:
  XP.orf_l(U32.is_eq(s, leaf), RG.has(F, leaf), nl_or(s, leaf, F, h))

def nl_F(+s: U32, +leaf: U32, +F: List<&2, U32>, +h: {RG.none.in(Con{leaf, Nil{}}, Con{s, F}) == True{} : Bool}) -> {RG.has(F, leaf) == False{} : Bool}:
  XP.orf_r(U32.is_eq(s, leaf), RG.has(F, leaf), nl_or(s, leaf, F, h))

def off_0(+d: Nat, +b: U32, +x: U32, +h: {RG.off(RG.nw(b), d, x) == True{} : Bool}) -> {Nat.is_eq(AD.slot(b, d), AD.slot(x, d)) == False{} : Bool}:
  XP.not_true(Nat.is_eq(AD.slot(b, d), AD.slot(x, d)), XP.and_l(Bool.not(Nat.is_eq(AD.slot(b, d), AD.slot(x, d))), Bool.not(Nat.is_eq(AD.slot((b + 1 : U32), d), AD.slot(x, d))) && (Bool.not(Nat.is_eq(AD.slot((b + 2 : U32), d), AD.slot(x, d))) && (Bool.not(Nat.is_eq(AD.slot((b + 3 : U32), d), AD.slot(x, d))) && True{})), h))

def off_1(+d: Nat, +b: U32, +x: U32, +h: {RG.off(RG.nw(b), d, x) == True{} : Bool}) -> {Nat.is_eq(AD.slot((b + 1 : U32), d), AD.slot(x, d)) == False{} : Bool}:
  XP.not_true(Nat.is_eq(AD.slot((b + 1 : U32), d), AD.slot(x, d)), XP.and_l(Bool.not(Nat.is_eq(AD.slot((b + 1 : U32), d), AD.slot(x, d))), Bool.not(Nat.is_eq(AD.slot((b + 2 : U32), d), AD.slot(x, d))) && (Bool.not(Nat.is_eq(AD.slot((b + 3 : U32), d), AD.slot(x, d))) && True{}), XP.and_r(Bool.not(Nat.is_eq(AD.slot(b, d), AD.slot(x, d))), Bool.not(Nat.is_eq(AD.slot((b + 1 : U32), d), AD.slot(x, d))) && (Bool.not(Nat.is_eq(AD.slot((b + 2 : U32), d), AD.slot(x, d))) && (Bool.not(Nat.is_eq(AD.slot((b + 3 : U32), d), AD.slot(x, d))) && True{})), h)))

def off_2(+d: Nat, +b: U32, +x: U32, +h: {RG.off(RG.nw(b), d, x) == True{} : Bool}) -> {Nat.is_eq(AD.slot((b + 2 : U32), d), AD.slot(x, d)) == False{} : Bool}:
  XP.not_true(Nat.is_eq(AD.slot((b + 2 : U32), d), AD.slot(x, d)), XP.and_l(Bool.not(Nat.is_eq(AD.slot((b + 2 : U32), d), AD.slot(x, d))), Bool.not(Nat.is_eq(AD.slot((b + 3 : U32), d), AD.slot(x, d))) && True{}, XP.and_r(Bool.not(Nat.is_eq(AD.slot((b + 1 : U32), d), AD.slot(x, d))), Bool.not(Nat.is_eq(AD.slot((b + 2 : U32), d), AD.slot(x, d))) && (Bool.not(Nat.is_eq(AD.slot((b + 3 : U32), d), AD.slot(x, d))) && True{}), XP.and_r(Bool.not(Nat.is_eq(AD.slot(b, d), AD.slot(x, d))), Bool.not(Nat.is_eq(AD.slot((b + 1 : U32), d), AD.slot(x, d))) && (Bool.not(Nat.is_eq(AD.slot((b + 2 : U32), d), AD.slot(x, d))) && (Bool.not(Nat.is_eq(AD.slot((b + 3 : U32), d), AD.slot(x, d))) && True{})), h))))

def off_3(+d: Nat, +b: U32, +x: U32, +h: {RG.off(RG.nw(b), d, x) == True{} : Bool}) -> {Nat.is_eq(AD.slot((b + 3 : U32), d), AD.slot(x, d)) == False{} : Bool}:
  XP.not_true(Nat.is_eq(AD.slot((b + 3 : U32), d), AD.slot(x, d)), XP.and_l(Bool.not(Nat.is_eq(AD.slot((b + 3 : U32), d), AD.slot(x, d))), True{}, XP.and_r(Bool.not(Nat.is_eq(AD.slot((b + 2 : U32), d), AD.slot(x, d))), Bool.not(Nat.is_eq(AD.slot((b + 3 : U32), d), AD.slot(x, d))) && True{}, XP.and_r(Bool.not(Nat.is_eq(AD.slot((b + 1 : U32), d), AD.slot(x, d))), Bool.not(Nat.is_eq(AD.slot((b + 2 : U32), d), AD.slot(x, d))) && (Bool.not(Nat.is_eq(AD.slot((b + 3 : U32), d), AD.slot(x, d))) && True{}), XP.and_r(Bool.not(Nat.is_eq(AD.slot(b, d), AD.slot(x, d))), Bool.not(Nat.is_eq(AD.slot((b + 1 : U32), d), AD.slot(x, d))) && (Bool.not(Nat.is_eq(AD.slot((b + 2 : U32), d), AD.slot(x, d))) && (Bool.not(Nat.is_eq(AD.slot((b + 3 : U32), d), AD.slot(x, d))) && True{})), h)))))

# node b's word i, i below 4
def ws_at(+b: U32, i: Nat) -> U32:
  match i:
    case 0n:
      b
    case 1n+0n:
      (b + 1 : U32)
    case 1n+1n+0n:
      (b + 2 : U32)
    case 1n+1n+1n+r:
      (b + 3 : U32)

def off_at(+d: Nat, +b: U32, +x: U32, i: Nat, +h: {RG.off(RG.nw(b), d, x) == True{} : Bool}) -> {Nat.is_eq(AD.slot(ws_at(b, i), d), AD.slot(x, d)) == False{} : Bool}:
  match i:
    case 0n:
      off_0(d, b, x, h)
    case 1n+0n:
      off_1(d, b, x, h)
    case 1n+1n+0n:
      off_2(d, b, x, h)
    case 1n+1n+1n+r:
      off_3(d, b, x, h)

# the free list's nodes, all tracked, none s: a write at s's word i is
# off every one's word 1, which the chain reads
def offw_s(F: List<&2, U32>, +N: List<&2, U32>, +d: Nat, +s: U32, +i: Nat, +hN: {RG.layout(N, d) == True{} : Bool}, +hFN: {RG.sub(F, N) == True{} : Bool},
  +hsN: {RG.has(N, s) == True{} : Bool}, +hsF: {RG.has(F, s) == False{} : Bool}) -> {XP.offw(F, d, ws_at(s, i)) == True{} : Bool}:
  match F:
    case Nil{}:
      {==}
    case Con{+n, +r}:
      +hnN = XP.and_l(RG.has(N, n), RG.sub(r, N), hFN)
      +hns = XP.orf_l(U32.is_eq(n, s), RG.has(r, s), hsF)
      +hdj = GP.lay_pair(N, d, n, s, hN, hnN, hsN, hns)
      +hof = XP.and_l(RG.off(RG.nw(s), d, (n + 1 : U32)), RG.off(RG.nw(s), d, (n + 2 : U32)) && RG.off(RG.nw(s), d, (n + 3 : U32)), XP.and_r(RG.off(RG.nw(s), d, n), RG.off(RG.nw(s), d, (n + 1 : U32)) && (RG.off(RG.nw(s), d, (n + 2 : U32)) && RG.off(RG.nw(s), d, (n + 3 : U32))), hdj))
      XP.and_intro(Bool.not(Nat.is_eq(AD.slot(ws_at(s, i), d), AD.slot((n + 1 : U32), d))), XP.offw(r, d, ws_at(s, i)),
        XP.nf(Nat.is_eq(AD.slot(ws_at(s, i), d), AD.slot((n + 1 : U32), d)), off_at(d, s, (n + 1 : U32), i, hof)),
        offw_s(r, N, d, s, i, hN, XP.and_r(RG.has(N, n), RG.sub(r, N), hFN), hsN, XP.orf_r(U32.is_eq(n, s), RG.has(r, s), hsF)))

# membership: a list none of whose members is x, or y
def ni_one(F: List<&2, U32>, +x: U32, +h: {RG.has(F, x) == False{} : Bool}) -> {RG.none.in(F, Con{x, Nil{}}) == True{} : Bool}:
  match F:
    case Nil{}:
      {==}
    case Con{+n, +r}:
      +hx = Equal.trans(Bool, U32.is_eq(x, n), U32.is_eq(n, x), False{}, XP.ueq_comm(x, n), XP.orf_l(U32.is_eq(n, x), RG.has(r, x), h))
      XP.and_intro(Bool.not(Bool.or(U32.is_eq(x, n), False{})), RG.none.in(r, Con{x, Nil{}}),
        XP.nf(Bool.or(U32.is_eq(x, n), False{}), ME.subst(Bool, z => {Bool.or(z, False{}) == False{} : Bool}, False{}, U32.is_eq(x, n), Equal.sym(Bool, U32.is_eq(x, n), False{}, hx), {==})),
        ni_one(r, x, XP.orf_r(U32.is_eq(n, x), RG.has(r, x), h)))

def ni_two(F: List<&2, U32>, +x: U32, +y: U32, +hx: {RG.has(F, x) == False{} : Bool}, +hy: {RG.has(F, y) == False{} : Bool}) -> {RG.none.in(F, Con{x, Con{y, Nil{}}}) == True{} : Bool}:
  match F:
    case Nil{}:
      {==}
    case Con{+n, +r}:
      +ex = Equal.trans(Bool, U32.is_eq(x, n), U32.is_eq(n, x), False{}, XP.ueq_comm(x, n), XP.orf_l(U32.is_eq(n, x), RG.has(r, x), hx))
      +ey = Equal.trans(Bool, U32.is_eq(y, n), U32.is_eq(n, y), False{}, XP.ueq_comm(y, n), XP.orf_l(U32.is_eq(n, y), RG.has(r, y), hy))
      +e2 = ME.subst(Bool, z => {Bool.or(z, False{}) == False{} : Bool}, False{}, U32.is_eq(y, n), Equal.sym(Bool, U32.is_eq(y, n), False{}, ey), {==})
      +e1 = ME.subst(Bool, z => {Bool.or(z, Bool.or(U32.is_eq(y, n), False{})) == False{} : Bool}, False{}, U32.is_eq(x, n), Equal.sym(Bool, U32.is_eq(x, n), False{}, ex), e2)
      XP.and_intro(Bool.not(Bool.or(U32.is_eq(x, n), Bool.or(U32.is_eq(y, n), False{}))), RG.none.in(r, Con{x, Con{y, Nil{}}}),
        XP.nf(Bool.or(U32.is_eq(x, n), Bool.or(U32.is_eq(y, n), False{})), e1),
        ni_two(r, x, y, XP.orf_r(U32.is_eq(n, x), RG.has(r, x), hx), XP.orf_r(U32.is_eq(n, y), RG.has(r, y), hy)))

# reads of a list written: a slot written reads what was written there, if
# it held any; a set keeps whether a slot holds any
def map_sm(m: Maybe<&2, U32>, +x: U32) -> {XP.is_some(Maybe.map(&2, U32, U32, y => x, m)) == XP.is_some(m) : Bool}:
  match m:
    case Some{+y}:
      {==}
    case None{}:
      {==}

def sm_set.k(+e: Bool, +v: List<&2, U32>, +i: Nat, +j: Nat, +x: U32, +he: {Nat.is_eq(i, j) == e : Bool}) ->
  {XP.is_some(List.get(&2, U32, List.set(&2, U32, v, i, x), j)) == XP.is_some(List.get(&2, U32, v, j)) : Bool}:
  match e:
    case True{}:
      +eij = MN.eq_of_is_eq(i, j, he)
      +at = Equal.trans(Bool, XP.is_some(List.get(&2, U32, List.set(&2, U32, v, i, x), i)), XP.is_some(Maybe.map(&2, U32, U32, y => x, List.get(&2, U32, v, i))), XP.is_some(List.get(&2, U32, v, i)),
        Equal.cong(Maybe<&2, U32>, Bool, m => XP.is_some(m), List.get(&2, U32, List.set(&2, U32, v, i, x), i), Maybe.map(&2, U32, U32, y => x, List.get(&2, U32, v, i)), ML.get_set_self(&2, U32, v, i, x)), map_sm(List.get(&2, U32, v, i), x))
      ME.subst(Nat, z => {XP.is_some(List.get(&2, U32, List.set(&2, U32, v, i, x), z)) == XP.is_some(List.get(&2, U32, v, z)) : Bool}, i, j, eij, at)
    case False{}:
      Equal.cong(Maybe<&2, U32>, Bool, m => XP.is_some(m), List.get(&2, U32, List.set(&2, U32, v, i, x), j), List.get(&2, U32, v, j), LAB.get_set_ne(U32, v, i, j, x, he))

def sm_set(+v: List<&2, U32>, +i: Nat, +j: Nat, +x: U32) -> {XP.is_some(List.get(&2, U32, List.set(&2, U32, v, i, x), j)) == XP.is_some(List.get(&2, U32, v, j)) : Bool}:
  sm_set.k(Nat.is_eq(i, j), v, i, j, x, {==})

# the view after R.situate's writes: the head moved on (nx), the node's
# header (hd) and payload (0, at its word pi), its word 1 the static
# eraser, word 2 the source's entry, word 3 itself
def sv(+v: List<&2, U32>, +d: Nat, +s: U32, +nx: U32, +hd: U32, +pi: Nat, +k: U32) -> List<&2, U32>:
  List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, List.set(&2, U32, v, AD.slot(P.at_fh(), d), nx), AD.slot(s, d), hd), AD.slot(ws_at(s, pi), d), 0), AD.slot((s + 1 : U32), d), P.era()), AD.slot((s + 2 : U32), d), k), AD.slot((s + 3 : U32), d), s)

# a slot of the view after the writes holds a word where the view before did
