# The tracked lists grown by free nodes past them (lx_extend)
# ===========================================================

def bases_app(A: List<&2, U32>, +B: List<&2, U32>, +ha: {RG.bases(A) == True{} : Bool}, +hb: {RG.bases(B) == True{} : Bool}) -> {RG.bases(List.append(&2, U32, A, B)) == True{} : Bool}:
  match A:
    case Nil{}:
      hb
    case Con{+x, +r}:
      XP.and_intro(U32.is_eq(P.base(x), x), RG.bases(List.append(&2, U32, r, B)), XP.and_l(U32.is_eq(P.base(x), x), RG.bases(r), ha),
        bases_app(r, B, XP.and_r(U32.is_eq(P.base(x), x), RG.bases(r), ha), hb))

def past_app(A: List<&2, U32>, +B: List<&2, U32>, +d: Nat, +ha: {KMd.past(A, d) == True{} : Bool}, +hb: {KMd.past(B, d) == True{} : Bool}) -> {KMd.past(List.append(&2, U32, A, B), d) == True{} : Bool}:
  match A:
    case Nil{}:
      hb
    case Con{+x, +r}:
      XP.and_intro(KMd.ws.off(KMd.nw(x), KMd.hdr_all(), d), KMd.past(List.append(&2, U32, r, B), d), XP.and_l(KMd.ws.off(KMd.nw(x), KMd.hdr_all(), d), KMd.past(r, d), ha),
        past_app(r, B, d, XP.and_r(KMd.ws.off(KMd.nw(x), KMd.hdr_all(), d), KMd.past(r, d), ha), hb))

# the faced ports' link words off N's nodes and off E's: off N ++ E's
def pxoff_app(ys: List<&2, U32>, +v: List<&2, U32>, +d: Nat, +L: List<&2, U32>, +N: List<&2, U32>, +E: List<&2, U32>, +hn: {RG.px.off(ys, v, d, L, N) == True{} : Bool}, +he: {RG.px.off(ys, v, d, L, E) == True{} : Bool}) ->
  {RG.px.off(ys, v, d, L, List.append(&2, U32, N, E)) == True{} : Bool}:
  match ys:
    case Nil{}:
      {==}
    case Con{+z, +t}:
      XP.and_intro(RG.po.all(KMd.word(v, d, (z + 1 : U32)), L, d, List.append(&2, U32, N, E)), RG.px.off(t, v, d, L, List.append(&2, U32, N, E)),
        SP.po_app(N, E, KMd.word(v, d, (z + 1 : U32)), L, d, XP.and_l(RG.po.all(KMd.word(v, d, (z + 1 : U32)), L, d, N), RG.px.off(t, v, d, L, N), hn),
          XP.and_l(RG.po.all(KMd.word(v, d, (z + 1 : U32)), L, d, E), RG.px.off(t, v, d, L, E), he)),
        pxoff_app(t, v, d, L, N, E, XP.and_r(RG.po.all(KMd.word(v, d, (z + 1 : U32)), L, d, N), RG.px.off(t, v, d, L, N), hn),
          XP.and_r(RG.po.all(KMd.word(v, d, (z + 1 : U32)), L, d, E), RG.px.off(t, v, d, L, E), he)))

