# the index laid out apart from s: s none of its leaves
def lay_nl(I: IM.Ix, +s: U32, +d: Nat, +h: {IM.ix.lay(I, s, d) == True{} : Bool}) -> {RG.has(IM.ix.leaves(I), s) == False{} : Bool}:
  match I:
    case IM.Ept{}:
      {==}
    case IM.Has{+t}:
      XP.absent_of_offn(t, d, s, XP.and_l(IM.tr.offn(t, d, s), IM.tr.lay(t, d), XP.and_r(IM.nd.ok(s, d), IM.tr.offn(t, d, s) && IM.tr.lay(t, d), h)))

