# the payload word by the header's test: 2 for a data node, else 3
def sp.b(+b: Bool, +t0: LAT.Tree<U32>, -a: Array<V.Val>, +d: Nat, +by: U32, +k: U32, +s: U32, +leaf: U32, +F: List<&2, U32>, +N: List<&2, U32>, +hft: {AD.full(U32, LAT.fromT(U32, t0), d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool}, +h2: {Nat.is_le(2n, d) == True{} : Bool}, +hch: {KMd.chain(Con{s, F}, AD.view(U32, LAT.fromT(U32, t0)), d, KMd.word(AD.view(U32, LAT.fromT(U32, t0)), d, P.at_fh())) == True{} : Bool}, +hdF: {RG.distinct(Con{s, F}) == True{} : Bool}, +hN: {RG.layout(N, d) == True{} : Bool}, +hB: {RG.bases(N) == True{} : Bool}, +hsN: {RG.sub(Con{s, Con{leaf, Nil{}}}, N) == True{} : Bool}, +hFN: {RG.sub(F, N) == True{} : Bool}, +hlf: {RG.none.in(Con{leaf, Nil{}}, Con{s, F}) == True{} : Bool}, +hq1: {RG.port.ok(Con{s, Con{leaf, Nil{}}}, d, KMd.word(AD.view(U32, LAT.fromT(U32, t0)), d, (leaf + 1 : U32))) == True{} : Bool}, +hq2: {RG.po.all(KMd.word(AD.view(U32, LAT.fromT(U32, t0)), d, (leaf + 1 : U32)), Con{s, Con{leaf, Nil{}}}, d, N) == True{} : Bool}, +hq3: {KMd.off.port(d, KMd.word(AD.view(U32, LAT.fromT(U32, t0)), d, (leaf + 1 : U32)), (leaf + 1 : U32)) == True{} : Bool}, +hq4: {KMd.off.port(d, KMd.word(AD.view(U32, LAT.fromT(U32, t0)), d, (leaf + 1 : U32)), (s + 1 : U32)) == True{} : Bool}, +heq: {U32.is_eq((P.hd2(18, 2, by) .&. 63 : U32), 5) == b : Bool}) -> {RG.px.ok(AD.view(U32, RG.words(Pair.fst(P.H, U32, R.situate(P.H{KM.MG{LAT.fromT(U32, t0)}, a}, by, k)))), d, s, IM.Ept{}, Con{leaf, Nil{}}, Con{s, Con{leaf, Nil{}}}, F, N) && AD.full(U32, RG.words(Pair.fst(P.H, U32, R.situate(P.H{KM.MG{LAT.fromT(U32, t0)}, a}, by, k))), d) == True{} : Bool}:
  match b:
    case True{}:
      sp.w(1n+1n+0n, t0, a, d, by, k, s, leaf, F, N, hft, hd32, h2, hch, hdF, hN, hB, hsN, hFN, hlf, hq1, hq2, hq3, hq4, Equal.cong(U32, U32, z => (s + z : U32), P.node.word(P.hd2(18, 2, by)), 2, ME.subst(Bool, z => {P.node.word.t(z) == 2 : U32}, True{}, U32.is_eq((P.hd2(18, 2, by) .&. 63 : U32), 5), Equal.sym(Bool, U32.is_eq((P.hd2(18, 2, by) .&. 63 : U32), 5), True{}, heq), {==})))
    case False{}:
      sp.w(1n+1n+1n+0n, t0, a, d, by, k, s, leaf, F, N, hft, hd32, h2, hch, hdF, hN, hB, hsN, hFN, hlf, hq1, hq2, hq3, hq4, Equal.cong(U32, U32, z => (s + z : U32), P.node.word(P.hd2(18, 2, by)), 3, ME.subst(Bool, z => {P.node.word.t(z) == 3 : U32}, False{}, U32.is_eq((P.hd2(18, 2, by) .&. 63 : U32), 5), Equal.sym(Bool, U32.is_eq((P.hd2(18, 2, by) .&. 63 : U32), 5), False{}, heq), {==})))

def sp.k(+t0: LAT.Tree<U32>, -a: Array<V.Val>, +d: Nat, +by: U32, +k: U32, +s: U32, +leaf: U32, +F: List<&2, U32>, +N: List<&2, U32>, +hft: {AD.full(U32, LAT.fromT(U32, t0), d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool}, +h2: {Nat.is_le(2n, d) == True{} : Bool}, +hch: {KMd.chain(Con{s, F}, AD.view(U32, LAT.fromT(U32, t0)), d, KMd.word(AD.view(U32, LAT.fromT(U32, t0)), d, P.at_fh())) == True{} : Bool}, +hdF: {RG.distinct(Con{s, F}) == True{} : Bool}, +hN: {RG.layout(N, d) == True{} : Bool}, +hB: {RG.bases(N) == True{} : Bool}, +hsN: {RG.sub(Con{s, Con{leaf, Nil{}}}, N) == True{} : Bool}, +hFN: {RG.sub(F, N) == True{} : Bool}, +hlf: {RG.none.in(Con{leaf, Nil{}}, Con{s, F}) == True{} : Bool}, +hq1: {RG.port.ok(Con{s, Con{leaf, Nil{}}}, d, KMd.word(AD.view(U32, LAT.fromT(U32, t0)), d, (leaf + 1 : U32))) == True{} : Bool}, +hq2: {RG.po.all(KMd.word(AD.view(U32, LAT.fromT(U32, t0)), d, (leaf + 1 : U32)), Con{s, Con{leaf, Nil{}}}, d, N) == True{} : Bool}, +hq3: {KMd.off.port(d, KMd.word(AD.view(U32, LAT.fromT(U32, t0)), d, (leaf + 1 : U32)), (leaf + 1 : U32)) == True{} : Bool}, +hq4: {KMd.off.port(d, KMd.word(AD.view(U32, LAT.fromT(U32, t0)), d, (leaf + 1 : U32)), (s + 1 : U32)) == True{} : Bool}) -> {RG.px.ok(AD.view(U32, RG.words(Pair.fst(P.H, U32, R.situate(P.H{KM.MG{LAT.fromT(U32, t0)}, a}, by, k)))), d, s, IM.Ept{}, Con{leaf, Nil{}}, Con{s, Con{leaf, Nil{}}}, F, N) && AD.full(U32, RG.words(Pair.fst(P.H, U32, R.situate(P.H{KM.MG{LAT.fromT(U32, t0)}, a}, by, k))), d) == True{} : Bool}:
