def sp.m(-w: Array<U32>, -a: Array<V.Val>, +d: Nat, +by: U32, +k: U32, +s: U32, +leaf: U32, +F: List<&2, U32>, +N: List<&2, U32>, +hf: {AD.full(U32, w, d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool}, +h2: {Nat.is_le(2n, d) == True{} : Bool}, +hch: {KMd.chain(Con{s, F}, AD.view(U32, w), d, KMd.word(AD.view(U32, w), d, P.at_fh())) == True{} : Bool}, +hdF: {RG.distinct(Con{s, F}) == True{} : Bool}, +hN: {RG.layout(N, d) == True{} : Bool}, +hB: {RG.bases(N) == True{} : Bool}, +hsN: {RG.sub(Con{s, Con{leaf, Nil{}}}, N) == True{} : Bool}, +hFN: {RG.sub(F, N) == True{} : Bool}, +hlf: {RG.none.in(Con{leaf, Nil{}}, Con{s, F}) == True{} : Bool}, +hq1: {RG.port.ok(Con{s, Con{leaf, Nil{}}}, d, KMd.word(AD.view(U32, w), d, (leaf + 1 : U32))) == True{} : Bool}, +hq2: {RG.po.all(KMd.word(AD.view(U32, w), d, (leaf + 1 : U32)), Con{s, Con{leaf, Nil{}}}, d, N) == True{} : Bool}, +hq3: {KMd.off.port(d, KMd.word(AD.view(U32, w), d, (leaf + 1 : U32)), (leaf + 1 : U32)) == True{} : Bool}, +hq4: {KMd.off.port(d, KMd.word(AD.view(U32, w), d, (leaf + 1 : U32)), (s + 1 : U32)) == True{} : Bool},
  m0: LAT.Mirror(U32, w)) -> {RG.px.ok(AD.view(U32, RG.words(Pair.fst(P.H, U32, R.situate(P.H{KM.MG{w}, a}, by, k)))), d, s, IM.Ept{}, Con{leaf, Nil{}}, Con{s, Con{leaf, Nil{}}}, F, N) && AD.full(U32, RG.words(Pair.fst(P.H, U32, R.situate(P.H{KM.MG{w}, a}, by, k))), d) == True{} : Bool}:
  (+t0, +e0) = m0
  +hft = LAB.subst(Array<U32>, x => {AD.full(U32, x, d) == True{} : Bool}, w, LAT.fromT(U32, t0), Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, e0), hf)
  +hcht = LAB.subst(Array<U32>, x => {KMd.chain(Con{s, F}, AD.view(U32, x), d, KMd.word(AD.view(U32, x), d, P.at_fh())) == True{} : Bool}, w, LAT.fromT(U32, t0), Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, e0), hch)
  +hq1t = LAB.subst(Array<U32>, x => {RG.port.ok(Con{s, Con{leaf, Nil{}}}, d, KMd.word(AD.view(U32, x), d, (leaf + 1 : U32))) == True{} : Bool}, w, LAT.fromT(U32, t0), Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, e0), hq1)
  +hq2t = LAB.subst(Array<U32>, x => {RG.po.all(KMd.word(AD.view(U32, x), d, (leaf + 1 : U32)), Con{s, Con{leaf, Nil{}}}, d, N) == True{} : Bool}, w, LAT.fromT(U32, t0), Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, e0), hq2)
  +hq3t = LAB.subst(Array<U32>, x => {KMd.off.port(d, KMd.word(AD.view(U32, x), d, (leaf + 1 : U32)), (leaf + 1 : U32)) == True{} : Bool}, w, LAT.fromT(U32, t0), Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, e0), hq3)
  +hq4t = LAB.subst(Array<U32>, x => {KMd.off.port(d, KMd.word(AD.view(U32, x), d, (leaf + 1 : U32)), (s + 1 : U32)) == True{} : Bool}, w, LAT.fromT(U32, t0), Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, e0), hq4)
  LAB.subst(Array<U32>, x => {RG.px.ok(AD.view(U32, RG.words(Pair.fst(P.H, U32, R.situate(P.H{KM.MG{x}, a}, by, k)))), d, s, IM.Ept{}, Con{leaf, Nil{}}, Con{s, Con{leaf, Nil{}}}, F, N) && AD.full(U32, RG.words(Pair.fst(P.H, U32, R.situate(P.H{KM.MG{x}, a}, by, k))), d) == True{} : Bool}, LAT.fromT(U32, t0), w, e0, sp.k(t0, a, d, by, k, s, leaf, F, N, hft, hd32, h2, hcht, hdF, hN, hB, hsN, hFN, hlf, hq1t, hq2t, hq3t, hq4t))

def Laws.situate_pend(w, a, d, by, k, s, leaf, F, N, hf, hd32, h2, hch, hdF, hN, hB, hsN, hFN, hlf, hq1, hq2, hq3, hq4):
  sp.m(w, a, d, by, k, s, leaf, F, N, hf, hd32, h2, hch, hdF, hN, hB, hsN, hFN, hlf, hq1, hq2, hq3, hq4, LAT.mirror(U32, w))

# The live nodes distinct across the crossings (cxs_distinct)
# ============================================================

def hw.k(+e: Bool, +z: U32, +t: List<&2, U32>, +x: U32, +y: U32, +hez: {U32.is_eq(z, x) == e : Bool}, +hzy: {U32.is_eq(z, y) == False{} : Bool},
  ih: {RG.has(RG.without(t, x), y) == False{} : Bool}) -> {RG.has(List.append(&2, U32, RG.keep(e, z), RG.without(t, x)), y) == False{} : Bool}:
  match e:
    case True{}:
      ih
    case False{}:
      ME.subst(Bool, b => {Bool.or(b, RG.has(RG.without(t, x), y)) == False{} : Bool}, False{}, U32.is_eq(z, y), Equal.sym(Bool, U32.is_eq(z, y), False{}, hzy), ih)

# taking x out of a list adds no member
def has_without(ys: List<&2, U32>, +x: U32, +y: U32, +h: {RG.has(ys, y) == False{} : Bool}) -> {RG.has(RG.without(ys, x), y) == False{} : Bool}:
  match ys:
    case Nil{}:
      {==}
    case Con{+z, +t}:
      hw.k(U32.is_eq(z, x), z, t, x, y, {==}, XP.orf_l(U32.is_eq(z, y), RG.has(t, y), h), has_without(t, x, y, XP.orf_r(U32.is_eq(z, y), RG.has(t, y), h)))

def wd.k(+e: Bool, +z: U32, +t: List<&2, U32>, +x: U32, +hez: {U32.is_eq(z, x) == e : Bool}, +hzt: {RG.has(t, z) == False{} : Bool},
  ih: {RG.distinct(RG.without(t, x)) == True{} : Bool}) -> {RG.distinct(List.append(&2, U32, RG.keep(e, z), RG.without(t, x))) == True{} : Bool}:
  match e:
    case True{}:
      ih
    case False{}:
      XP.and_intro(Bool.not(RG.has(RG.without(t, x), z)), RG.distinct(RG.without(t, x)), XP.nf(RG.has(RG.without(t, x), z), has_without(t, x, z, hzt)), ih)

# taking x out of a distinct list leaves it distinct
def without_distinct(ys: List<&2, U32>, +x: U32, +h: {RG.distinct(ys) == True{} : Bool}) -> {RG.distinct(RG.without(ys, x)) == True{} : Bool}:
  match ys:
    case Nil{}:
      {==}
    case Con{+z, +t}:
      +hzt = XP.not_true(RG.has(t, z), XP.and_l(Bool.not(RG.has(t, z)), RG.distinct(t), h))
      wd.k(U32.is_eq(z, x), z, t, x, {==}, hzt, without_distinct(t, x, XP.and_r(Bool.not(RG.has(t, z)), RG.distinct(t), h)))

def cxl_distinct(m: Maybe<&2, U32>, +x: U32, +L: List<&2, U32>, +h: {RG.distinct(L) == True{} : Bool}) -> {RG.distinct(RG.cx.L(m, x, L)) == True{} : Bool}:
  match m:
    case Some{+y}:
      without_distinct(RG.without(L, x), y, without_distinct(L, x, h))
    case None{}:
      h

def cxs_d(cs: List<&2, R.FzC>, +vm: List<&2, U32>, +dm: Nat, +I: IM.Ix, +L: List<&2, U32>, +F: List<&2, U32>, +h: {RG.distinct(L) == True{} : Bool}) ->
  {RG.distinct(RG.cxs.L(RG.cxs(cs, vm, dm, I, L, F))) == True{} : Bool}:
  match cs:
    case Nil{}:
      h
    case Con{c, r}:
      match c:
        case R.FzC{+at, +src, neg, +far}:
          cxs_d(r, vm, dm, RG.cx.I(IM.ix.look(I, far), I, RG.pl.of(List.get(&2, U32, vm, AD.slot(at, dm))), src, RG.cx.hd(F), far),
            RG.cx.L(IM.ix.look(I, far), RG.pl.of(List.get(&2, U32, vm, AD.slot(at, dm))), L),
            RG.cx.F1(IM.ix.look(I, far), I, RG.pl.of(List.get(&2, U32, vm, AD.slot(at, dm))), far, RG.cx.tl(IM.ix.look(I, far), I, F)),
            cxl_distinct(IM.ix.look(I, far), RG.pl.of(List.get(&2, U32, vm, AD.slot(at, dm))), L, h))

def Laws.cxs_distinct(cs, vm, dm, I, L, F, h):
  cxs_d(cs, vm, dm, I, L, F, h)

# The copy's half: its holes, fresh nodes from the free list
# (SP.holes_sub), none live, appended to a distinct live list keep it
# distinct (dist_app, in the serve's law to come)

# none of A in Con{b, B}: b in none of A, and none of A in B
def ni_head(A: List<&2, U32>, +b: U32, +B: List<&2, U32>, +h: {RG.none.in(A, Con{b, B}) == True{} : Bool}) -> {RG.has(A, b) == False{} : Bool}:
  match A:
    case Nil{}:
      {==}
    case Con{+a, +r}:
      +hab = XP.not_true(Bool.or(U32.is_eq(b, a), RG.has(B, a)), XP.and_l(Bool.not(Bool.or(U32.is_eq(b, a), RG.has(B, a))), RG.none.in(r, Con{b, B}), h))
      +eab = Equal.trans(Bool, U32.is_eq(a, b), U32.is_eq(b, a), False{}, XP.ueq_comm(a, b), XP.orf_l(U32.is_eq(b, a), RG.has(B, a), hab))
      +ir = ni_head(r, b, B, XP.and_r(Bool.not(Bool.or(U32.is_eq(b, a), RG.has(B, a))), RG.none.in(r, Con{b, B}), h))
      ME.subst(Bool, z => {Bool.or(z, RG.has(r, b)) == False{} : Bool}, False{}, U32.is_eq(a, b), Equal.sym(Bool, U32.is_eq(a, b), False{}, eab),
        ME.subst(Bool, z => {Bool.or(False{}, z) == False{} : Bool}, False{}, RG.has(r, b), Equal.sym(Bool, RG.has(r, b), False{}, ir), {==}))

def ni_tail(A: List<&2, U32>, +b: U32, +B: List<&2, U32>, +h: {RG.none.in(A, Con{b, B}) == True{} : Bool}) -> {RG.none.in(A, B) == True{} : Bool}:
  match A:
    case Nil{}:
      {==}
    case Con{+a, +r}:
      +hab = XP.not_true(Bool.or(U32.is_eq(b, a), RG.has(B, a)), XP.and_l(Bool.not(Bool.or(U32.is_eq(b, a), RG.has(B, a))), RG.none.in(r, Con{b, B}), h))
      XP.and_intro(Bool.not(RG.has(B, a)), RG.none.in(r, B), XP.nf(RG.has(B, a), XP.orf_r(U32.is_eq(b, a), RG.has(B, a), hab)),
        ni_tail(r, b, B, XP.and_r(Bool.not(Bool.or(U32.is_eq(b, a), RG.has(B, a))), RG.none.in(r, Con{b, B}), h)))

# none of A in B: none of B in A
def ni_sym(+A: List<&2, U32>, B: List<&2, U32>, +h: {RG.none.in(A, B) == True{} : Bool}) -> {RG.none.in(B, A) == True{} : Bool}:
  match B:
    case Nil{}:
      {==}
    case Con{+b, +r}:
