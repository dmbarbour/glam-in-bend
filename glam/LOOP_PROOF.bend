  match X:
    case Nil{}:
      {==}
    case Con{+x, +r}:
      XP.and_intro(RG.inr(x, d), RG.nodes.in(r, d), nin_has(N, x, d, hI, XP.and_l(RG.has(N, x), RG.sub(r, N), hs)), nin_sub(r, N, d, XP.and_r(RG.has(N, x), RG.sub(r, N), hs), hI))

def nin_app(A: List<&2, U32>, +B: List<&2, U32>, +d: Nat, +ha: {RG.nodes.in(A, d) == True{} : Bool}, +hb: {RG.nodes.in(B, d) == True{} : Bool}) -> {RG.nodes.in(List.append(&2, U32, A, B), d) == True{} : Bool}:
  match A:
    case Nil{}:
      hb
    case Con{+x, +r}:
      XP.and_intro(RG.inr(x, d), RG.nodes.in(List.append(&2, U32, r, B), d), XP.and_l(RG.inr(x, d), RG.nodes.in(r, d), ha), nin_app(r, B, d, XP.and_r(RG.inr(x, d), RG.nodes.in(r, d), ha), hb))

