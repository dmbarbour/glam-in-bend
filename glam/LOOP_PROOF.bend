# a faced port's link word off every node of N: off every node of N2
def po_sub(N2: List<&2, U32>, +N: List<&2, U32>, +r: U32, +L: List<&2, U32>, +d: Nat, +h: {RG.po.all(r, L, d, N) == True{} : Bool}, +hs: {RG.sub(N2, N) == True{} : Bool}) -> {RG.po.all(r, L, d, N2) == True{} : Bool}:
  match N2:
    case Nil{}:
      GP.po_fh(N, r, L, d, h)
    case Con{+n, +t}:
      XP.and_intro(RG.po.n(r, L, d, n), RG.po.all(r, L, d, t), GP.po_at(N, r, L, d, n, h, XP.and_l(RG.has(N, n), RG.sub(t, N), hs)),
        po_sub(t, N, r, L, d, h, XP.and_r(RG.has(N, n), RG.sub(t, N), hs)))

def pxoff_sub(ys: List<&2, U32>, +v: List<&2, U32>, +d: Nat, +L: List<&2, U32>, +N2: List<&2, U32>, +N: List<&2, U32>, +h: {RG.px.off(ys, v, d, L, N) == True{} : Bool}, +hs: {RG.sub(N2, N) == True{} : Bool}) ->
  {RG.px.off(ys, v, d, L, N2) == True{} : Bool}:
  match ys:
    case Nil{}:
      {==}
    case Con{+z, +t}:
      XP.and_intro(RG.po.all(KMd.word(v, d, (z + 1 : U32)), L, d, N2), RG.px.off(t, v, d, L, N2),
