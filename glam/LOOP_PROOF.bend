# a word read alike: equal
def sm_eq(a: Maybe<&2, U32>, b: Maybe<&2, U32>, +h: {LM.same(a, b) == True{} : Bool}) -> {a == b : Maybe<&2, U32>}:
  match a:
    case Some{+x}:
      match b:
        case Some{+y}:
          Equal.cong(U32, Maybe<&2, U32>, q => Some{q}, x, y, MS.u32_eq_of_is_eq(x, y, h))
        case None{}:
          Empty.absurd({Some{x} == None{} : Maybe<&2, U32>}, MB.false_ne_true()(h))
    case None{}:
      match b:
        case Some{+y}:
          Empty.absurd({None{} == Some{y} : Maybe<&2, U32>}, MB.false_ne_true()(h))
        case None{}:
          {==}

def kw_get(+x: U32, +v: List<&2, U32>, +d: Nat, +v2: List<&2, U32>, +h: {LM.kept.w(x, v, d, v2) == True{} : Bool}) -> {List.get(&2, U32, v2, AD.slot(x, 1n+d)) == List.get(&2, U32, v, AD.slot(x, d)) : Maybe<&2, U32>}:
  sm_eq(List.get(&2, U32, v2, AD.slot(x, 1n+d)), List.get(&2, U32, v, AD.slot(x, d)), h)

def kw_word(+x: U32, +v: List<&2, U32>, +d: Nat, +v2: List<&2, U32>, +h: {LM.kept.w(x, v, d, v2) == True{} : Bool}) -> {KMd.word(v2, 1n+d, x) == KMd.word(v, d, x) : U32}:
