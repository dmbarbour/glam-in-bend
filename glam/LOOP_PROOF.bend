def Laws.bases_apart(N, d, h2, hd32, hB, hP, hI, hD):
  ba.lay(N, d, h2, MN.le_of_lt(d, 32n, hd32), hB, hP, hI, hD)

# The tracked nodes in range (nodes.in) over a sub-list and an append
# ===================================================================

def nin_has.k(+e: Bool, +y: U32, +t: List<&2, U32>, +x: U32, +d: Nat, +he: {U32.is_eq(y, x) == e : Bool}, +hI: {RG.nodes.in(Con{y, t}, d) == True{} : Bool}, +hx: {Bool.or(e, RG.has(t, x)) == True{} : Bool},
  ih: {RG.has(t, x) == True{} : Bool} -> {RG.inr(x, d) == True{} : Bool}) -> {RG.inr(x, d) == True{} : Bool}:
  match e:
    case True{}:
      ME.subst(U32, z => {RG.inr(z, d) == True{} : Bool}, y, x, MS.u32_eq_of_is_eq(y, x, he), XP.and_l(RG.inr(y, d), RG.nodes.in(t, d), hI))
    case False{}:
      ih(hx)

def nin_has(N: List<&2, U32>, +x: U32, +d: Nat, +hI: {RG.nodes.in(N, d) == True{} : Bool}, +hx: {RG.has(N, x) == True{} : Bool}) -> {RG.inr(x, d) == True{} : Bool}:
  match N:
    case Nil{}:
      Empty.absurd({RG.inr(x, d) == True{} : Bool}, MB.false_ne_true()(hx))
    case Con{+y, +t}:
      nin_has.k(U32.is_eq(y, x), y, t, x, d, {==}, hI, hx, h => nin_has(t, x, d, XP.and_r(RG.inr(y, d), RG.nodes.in(t, d), hI), h))

