def sp.m(-w: Array<U32>, -a: Array<V.Val>, +d: Nat, +by: U32, +k: U32, +s: U32, +leaf: U32, +F: List<&2, U32>, +N: List<&2, U32>, +hf: {AD.full(U32, w, d) == True{} : Bool}, +hd32: {Nat.is_lt(d, 32n) == True{} : Bool}, +h2: {Nat.is_le(2n, d) == True{} : Bool}, +hch: {KMd.chain(Con{s, F}, AD.view(U32, w), d, KMd.word(AD.view(U32, w), d, P.at_fh())) == True{} : Bool}, +hdF: {RG.distinct(Con{s, F}) == True{} : Bool}, +hN: {RG.layout(N, d) == True{} : Bool}, +hB: {RG.bases(N) == True{} : Bool}, +hsN: {RG.sub(Con{s, Con{leaf, Nil{}}}, N) == True{} : Bool}, +hFN: {RG.sub(F, N) == True{} : Bool}, +hlf: {RG.none.in(Con{leaf, Nil{}}, Con{s, F}) == True{} : Bool}, +hq1: {RG.port.ok(Con{s, Con{leaf, Nil{}}}, d, KMd.word(AD.view(U32, w), d, (leaf + 1 : U32))) == True{} : Bool}, +hq2: {RG.po.all(KMd.word(AD.view(U32, w), d, (leaf + 1 : U32)), Con{s, Con{leaf, Nil{}}}, d, N) == True{} : Bool}, +hq3: {KMd.off.port(d, KMd.word(AD.view(U32, w), d, (leaf + 1 : U32)), (leaf + 1 : U32)) == True{} : Bool}, +hq4: {KMd.off.port(d, KMd.word(AD.view(U32, w), d, (leaf + 1 : U32)), (s + 1 : U32)) == True{} : Bool},
  m0: LAT.Mirror(U32, w)) -> {RG.px.ok(AD.view(U32, RG.words(Pair.fst(P.H, U32, R.situate(P.H{KM.MG{w}, a}, by, k)))), d, s, IM.Ept{}, Con{leaf, Nil{}}, Con{s, Con{leaf, Nil{}}}, F, N) && AD.full(U32, RG.words(Pair.fst(P.H, U32, R.situate(P.H{KM.MG{w}, a}, by, k))), d) == True{} : Bool}:
  (+t0, +e0) = m0
  +hft = LAB.subst(Array<U32>, x => {AD.full(U32, x, d) == True{} : Bool}, w, LAT.fromT(U32, t0), Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, e0), hf)
  +hcht = LAB.subst(Array<U32>, x => {KMd.chain(Con{s, F}, AD.view(U32, x), d, KMd.word(AD.view(U32, x), d, P.at_fh())) == True{} : Bool}, w, LAT.fromT(U32, t0), Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, e0), hch)
  +hq1t = LAB.subst(Array<U32>, x => {RG.port.ok(Con{s, Con{leaf, Nil{}}}, d, KMd.word(AD.view(U32, x), d, (leaf + 1 : U32))) == True{} : Bool}, w, LAT.fromT(U32, t0), Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, e0), hq1)
  +hq2t = LAB.subst(Array<U32>, x => {RG.po.all(KMd.word(AD.view(U32, x), d, (leaf + 1 : U32)), Con{s, Con{leaf, Nil{}}}, d, N) == True{} : Bool}, w, LAT.fromT(U32, t0), Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, e0), hq2)
  +hq3t = LAB.subst(Array<U32>, x => {KMd.off.port(d, KMd.word(AD.view(U32, x), d, (leaf + 1 : U32)), (leaf + 1 : U32)) == True{} : Bool}, w, LAT.fromT(U32, t0), Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, e0), hq3)
  +hq4t = LAB.subst(Array<U32>, x => {KMd.off.port(d, KMd.word(AD.view(U32, x), d, (leaf + 1 : U32)), (s + 1 : U32)) == True{} : Bool}, w, LAT.fromT(U32, t0), Equal.sym(Array<U32>, LAT.fromT(U32, t0), w, e0), hq4)
  LAB.subst(Array<U32>, x => {RG.px.ok(AD.view(U32, RG.words(Pair.fst(P.H, U32, R.situate(P.H{KM.MG{x}, a}, by, k)))), d, s, IM.Ept{}, Con{leaf, Nil{}}, Con{s, Con{leaf, Nil{}}}, F, N) && AD.full(U32, RG.words(Pair.fst(P.H, U32, R.situate(P.H{KM.MG{x}, a}, by, k))), d) == True{} : Bool}, LAT.fromT(U32, t0), w, e0, sp.k(t0, a, d, by, k, s, leaf, F, N, hft, hd32, h2, hcht, hdF, hN, hB, hsN, hFN, hlf, hq1t, hq2t, hq3t, hq4t))

def Laws.situate_pend(w, a, d, by, k, s, leaf, F, N, hf, hd32, h2, hch, hdF, hN, hB, hsN, hFN, hlf, hq1, hq2, hq3, hq4):
