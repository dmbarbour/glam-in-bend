def Laws.serve_next(w, a, map, d, dm, ts, ls, by, ns, s, t, cs, I, F, M, nc, rn, rp, E, k, hf, hd32, h2, hfm, hdm, hlx, hl, hhd, ht, hcp, hok, hE):
