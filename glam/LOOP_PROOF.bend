      +eab = Equal.trans(Bool, U32.is_eq(a, b), U32.is_eq(b, a), False{}, XP.ueq_comm(a, b), XP.orf_l(U32.is_eq(b, a), RG.has(r, a), hta))
      XP.and_intro(RG.disj4(d, a, b), RG.cross(r, d, a), lay_pair(N, d, a, b, hN, ha, XP.and_l(RG.has(N, b), RG.sub(r, N), hts), eab),
        cross_sub(r, N, d, a, hN, ha, XP.and_r(RG.has(N, b), RG.sub(r, N), hts), XP.orf_r(U32.is_eq(b, a), RG.has(r, a), hta)))

# a distinct sub-list of a list laid out apart is laid out apart
def lay_sub(N2: List<&2, U32>, +N: List<&2, U32>, +d: Nat, +hN: {RG.layout(N, d) == True{} : Bool}, +hs: {RG.sub(N2, N) == True{} : Bool}, +hd: {RG.distinct(N2) == True{} : Bool}) -> {RG.layout(N2, d) == True{} : Bool}:
  match N2:
    case Nil{}:
      {==}
    case Con{+a, +t}:
      +ha = XP.and_l(RG.has(N, a), RG.sub(t, N), hs)
      +hts = XP.and_r(RG.has(N, a), RG.sub(t, N), hs)
      +hta = XP.not_true(RG.has(t, a), XP.and_l(Bool.not(RG.has(t, a)), RG.distinct(t), hd))
      XP.and_intro(RG.apartw(RG.nw(a), d), RG.off(RG.nw(a), d, P.at_fh()) && (RG.cross(t, d, a) && RG.layout(t, d)), GP.lay_self(N, d, a, hN, ha),
        XP.and_intro(RG.off(RG.nw(a), d, P.at_fh()), RG.cross(t, d, a) && RG.layout(t, d), GP.lay_head(N, d, a, hN, ha),
          XP.and_intro(RG.cross(t, d, a), RG.layout(t, d), cross_sub(t, N, d, a, hN, ha, hts, hta),
            lay_sub(t, N, d, hN, hts, XP.and_r(Bool.not(RG.has(t, a)), RG.distinct(t), hd)))))

def bases_sub(N2: List<&2, U32>, +N: List<&2, U32>, +hB: {RG.bases(N) == True{} : Bool}, +hs: {RG.sub(N2, N) == True{} : Bool}) -> {RG.bases(N2) == True{} : Bool}:
  match N2:
    case Nil{}:
      {==}
    case Con{+a, +t}:
      XP.and_intro(U32.is_eq(P.base(a), a), RG.bases(t), AL.bases_at(N, a, hB, XP.and_l(RG.has(N, a), RG.sub(t, N), hs)),
        bases_sub(t, N, hB, XP.and_r(RG.has(N, a), RG.sub(t, N), hs)))

# a node of a list past the header is past it
def pa.k(+e: Bool, +m: U32, +t: List<&2, U32>, +d: Nat, +n: U32, +he: {U32.is_eq(m, n) == e : Bool}, +h: {KMd.past(Con{m, t}, d) == True{} : Bool},
  +hn: {Bool.or(e, RG.has(t, n)) == True{} : Bool}, ih: {RG.has(t, n) == True{} : Bool} -> {KMd.ws.off(KMd.nw(n), KMd.hdr_all(), d) == True{} : Bool}) ->
  {KMd.ws.off(KMd.nw(n), KMd.hdr_all(), d) == True{} : Bool}:
  match e:
    case True{}:
      ME.subst(U32, z => {KMd.ws.off(KMd.nw(z), KMd.hdr_all(), d) == True{} : Bool}, m, n, MS.u32_eq_of_is_eq(m, n, he), XP.and_l(KMd.ws.off(KMd.nw(m), KMd.hdr_all(), d), KMd.past(t, d), h))
    case False{}:
      ih(hn)

def past_at(N: List<&2, U32>, +d: Nat, +n: U32, +h: {KMd.past(N, d) == True{} : Bool}, +hn: {RG.has(N, n) == True{} : Bool}) -> {KMd.ws.off(KMd.nw(n), KMd.hdr_all(), d) == True{} : Bool}:
  match N:
    case Nil{}:
      Empty.absurd({KMd.ws.off(KMd.nw(n), KMd.hdr_all(), d) == True{} : Bool}, MB.false_ne_true()(hn))
    case Con{+m, +t}:
      pa.k(U32.is_eq(m, n), m, t, d, n, {==}, h, hn, hnt => past_at(t, d, n, XP.and_r(KMd.ws.off(KMd.nw(m), KMd.hdr_all(), d), KMd.past(t, d), h), hnt))

def past_sub(N2: List<&2, U32>, +N: List<&2, U32>, +d: Nat, +h: {KMd.past(N, d) == True{} : Bool}, +hs: {RG.sub(N2, N) == True{} : Bool}) -> {KMd.past(N2, d) == True{} : Bool}:
  match N2:
    case Nil{}:
      {==}
    case Con{+a, +t}:
      XP.and_intro(KMd.ws.off(KMd.nw(a), KMd.hdr_all(), d), KMd.past(t, d), past_at(N, d, a, h, XP.and_l(RG.has(N, a), RG.sub(t, N), hs)),
        past_sub(t, N, d, h, XP.and_r(RG.has(N, a), RG.sub(t, N), hs)))
