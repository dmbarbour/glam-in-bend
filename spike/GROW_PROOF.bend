      +hiD = MN.lt_of_lt_of_le(U32.to_nat(i), Nat.add(U32.to_nat(i), 1n+p), U32.to_nat(c), lt_add(U32.to_nat(i), p), hr)
      +e1 = tn1(i, c, hiD)
      +hi2 = MN.lt_of_lt_of_le(U32.to_nat(i), U32.to_nat(c), Nat.pow(2n, D), hiD, hcD)
