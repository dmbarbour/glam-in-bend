# n at most 4n
def le4(+n: Nat) -> {Nat.is_le(n, Nat.mul(n, 4n)) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      MN.le_trans(p, Nat.mul(p, 4n), 3n+Nat.mul(p, 4n), le4(p), MN.le_add_left(Nat.mul(p, 4n), 3n))

