  %Equal.sym(Array<U32>, GM.arr(KM.grow(KM.MG{w}, cap)), KM.copy(U32.to_nat(cap), 0, KM.CP{w, Array.new(U32, 1n+d, 0)}), gr.eq(w, d, cap, hdp)) : {AD.full(U32, _, 1n+d) == True{} : Bool}
