def tl(+k: Nat, +i: U32, +to: U32, -a: Array<U32>, +n: U32, +D: Nat, +c: U32, +hf: {AD.full(U32, a, D) == True{} : Bool}, +hD: {Nat.is_lt(D, 32n) == True{} : Bool},
