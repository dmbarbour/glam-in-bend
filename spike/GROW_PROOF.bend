  +hS3a = LA.set_full(U32, GM.arr(P.thread(U32.to_nat(((((wc * 4 : U32) * 2 : U32) >> 2n : U32) - (wc + 1 : U32) : U32)), KM.grow(KM.MG{LAT.fromT(U32, tw)}, (wc * 4 : U32)), (wc + 1 : U32), (((wc * 4 : U32) * 2 : U32) >> 2n : U32))), 3n+e, P.at_fh(), (wc + 2 : U32), hT)
  +hS3 = LA.set_full(U32, Array.set(U32, GM.arr(P.thread(U32.to_nat(((((wc * 4 : U32) * 2 : U32) >> 2n : U32) - (wc + 1 : U32) : U32)), KM.grow(KM.MG{LAT.fromT(U32, tw)}, (wc * 4 : U32)), (wc + 1 : U32), (((wc * 4 : U32) * 2 : U32) >> 2n : U32))), P.at_fh(), (wc + 2 : U32)), 3n+e, P.at_wcap(), (((wc * 4 : U32) * 2 : U32) >> 2n : U32), hS3a)
