      %ed : {Pair.snd(Array<U32>, U32, Array.get(U32, KM.copy(1n+p, i, KM.CP{LAT.fromT(U32, ts), _}), j)) == Pair.snd(Array<U32>, U32, Array.get(U32, _, j)) : U32}
