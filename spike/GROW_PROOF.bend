def mo.w(-w: Array<U32>, -a: Array<V.Val>, +wc: U32, +e: Nat, +j: U32, +hf: {AD.full(U32, w, 2n+e) == True{} : Bool}, +hwc: {Pair.snd(Array<U32>, U32, Array.get(U32, w, P.at_wcap())) == wc : U32},
  +hw: {U32.to_nat(wc) == Nat.pow(2n, e) : Nat}, +he3: {Nat.is_le(3n, e) == True{} : Bool}, +he27: {Nat.is_lt(e, 28n) == True{} : Bool},
  +hj: {Nat.is_lt(U32.to_nat(j), Nat.pow(2n, 2n+e)) == True{} : Bool}, +hj0: {Nat.is_eq(U32.to_nat(j), U32.to_nat(P.at_fh())) == False{} : Bool}, +hj3: {Nat.is_eq(U32.to_nat(j), U32.to_nat(P.at_wcap())) == False{} : Bool}, mw: LAT.Mirror(U32, w)) ->
  {Pair.snd(Array<U32>, U32, Array.get(U32, KMd.words(Pair.fst(P.H, Bool, P.grow_more(P.H{KM.MG{w}, a}))), j)) == Pair.snd(Array<U32>, U32, Array.get(U32, w, j)) : U32}:
  (+tw, +ew) = mw
  +hf2 = LAP.full_t(U32, w, tw, 2n+e, ew, hf)
  +hwc2 = ME.subst(Array<U32>, z => {Pair.snd(Array<U32>, U32, Array.get(U32, z, P.at_wcap())) == wc : U32}, w, LAT.fromT(U32, tw), Equal.sym(Array<U32>, LAT.fromT(U32, tw), w, ew), hwc)
  %ew : {Pair.snd(Array<U32>, U32, Array.get(U32, KMd.words(Pair.fst(P.H, Bool, P.grow_more(P.H{KM.MG{_}, a}))), j)) == Pair.snd(Array<U32>, U32, Array.get(U32, _, j)) : U32}
  mo(tw, a, wc, e, hw, he3, he27, j, hf2, hwc2, hj, hj0, hj3)

def Laws.more_old(w, a, wc, e, j, hf, hwc, hw, he3, he27, hj, hj0, hj3):
  mo.w(w, a, wc, e, j, hf, hwc, hw, he3, he27, hj, hj0, hj3, LAT.mirror(U32, w))

# four times a equals four times b just where a equals b; one past four
# times a is never four times b
def q4(a: Nat, b: Nat) -> {Nat.is_eq(Nat.mul(a, 4n), Nat.mul(b, 4n)) == Nat.is_eq(a, b) : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      q4(p, q)

def o4(a: Nat, b: Nat) -> {Nat.is_eq(1n+Nat.mul(a, 4n), Nat.mul(b, 4n)) == False{} : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      o4(p, q)

# a node's reference as a number, four times its index, within a bound c;
# 2^32 abstract as m, put back only for the shift's premise
def sh4.k(+m: Nat, +e: {Nat.pow(2n, 32n) == m : Nat}, +i: U32, +c: U32, +h: {Nat.is_lt(Nat.mul(U32.to_nat(i), 4n), U32.to_nat(c)) == True{} : Bool}) -> {U32.to_nat((i << 2n : U32)) == Nat.mul(U32.to_nat(i), 4n) : Nat}:
  +hp = ME.subst(Nat, q => {Nat.is_lt(q, U32.to_nat(c)) == True{} : Bool}, Nat.mul(U32.to_nat(i), 4n), Nat.mul(U32.to_nat(i), Nat.pow(2n, 2n)), {==}, h)
  +hcm = ME.subst(Nat, q => {Nat.is_lt(U32.to_nat(c), q) == True{} : Bool}, Nat.pow(2n, 32n), m, e, WL.to_nat_lt(c))
  +hfm = MN.lt_of_lt_of_le(Nat.mul(U32.to_nat(i), Nat.pow(2n, 2n)), U32.to_nat(c), m, hp, MN.le_of_lt(U32.to_nat(c), m, hcm))
  +hf = ME.subst(Nat, q => {Nat.is_lt(Nat.mul(U32.to_nat(i), Nat.pow(2n, 2n)), q) == True{} : Bool}, m, Nat.pow(2n, 32n), Equal.sym(Nat, Nat.pow(2n, 32n), m, e), hfm)
  WL.to_nat_shln_fits(i, 2n, hf)

def sh4(+i: U32, +c: U32, +h: {Nat.is_lt(Nat.mul(U32.to_nat(i), 4n), U32.to_nat(c)) == True{} : Bool}) -> {U32.to_nat((i << 2n : U32)) == Nat.mul(U32.to_nat(i), 4n) : Nat}:
  sh4.k(Nat.pow(2n, 32n), {==}, i, c, h)

