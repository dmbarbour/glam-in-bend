# a number's predecessor, so that a successor's strips by computation
def npred(+n: Nat) -> Nat:
  match n:
    case 0n:
      0n
    case 1n+p:
      p

# a Bool decided: either case's proof
def bcase(+b: Bool, -G: Type, ct: {b == True{} : Bool} -> G, cf: {b == False{} : Bool} -> G) -> G:
  match b:
    case True{}:
      ct({==})
    case False{}:
      cf({==})

