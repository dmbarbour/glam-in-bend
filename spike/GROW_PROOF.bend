def fw1(+wc: U32, +e: Nat, +hw: {U32.to_nat(wc) == Nat.pow(2n, e) : Nat}, +he3: {Nat.is_le(3n, e) == True{} : Bool}, +he27: {Nat.is_lt(e, 28n) == True{} : Bool}) -> {U32.to_nat((wc + 1 : U32)) == 1n+U32.to_nat(wc) : Nat}:
