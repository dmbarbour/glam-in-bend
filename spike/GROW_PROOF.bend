def Laws.more_link(w, a, wc, e, hf, hwc, hw, he3, he27, m, hlo, hhi):
  more_link.w(w, a, wc, e, hw, he3, he27, hf, hwc, m, hlo, hhi, LAT.mirror(U32, w))

def more_last.w(-w: Array<U32>, -a: Array<V.Val>, +wc: U32, +e: Nat, +hw: {U32.to_nat(wc) == Nat.pow(2n, e) : Nat}, +he3: {Nat.is_le(3n, e) == True{} : Bool}, +he27: {Nat.is_lt(e, 28n) == True{} : Bool}, +hf: {AD.full(U32, w, 2n+e) == True{} : Bool}, +hwc: {Pair.snd(Array<U32>, U32, Array.get(U32, w, P.at_wcap())) == wc : U32}, +m: U32, +hm: {1n+U32.to_nat(m) == Nat.pow(2n, 1n+e) : Nat}, mw: LAT.Mirror(U32, w)) -> {Pair.snd(Array<U32>, U32, Array.get(U32, KMd.words(Pair.fst(P.H, Bool, P.grow_more(P.H{KM.MG{w}, a}))), ((m << 2n : U32) + 1 : U32))) == Pair.snd(Array<U32>, U32, Array.get(U32, w, P.at_fh())) : U32}:
  (+tw, +ew) = mw
  +hf2 = LAP.full_t(U32, w, tw, 2n+e, ew, hf)
  +hwc2 = ME.subst(Array<U32>, z => {Pair.snd(Array<U32>, U32, Array.get(U32, z, P.at_wcap())) == wc : U32}, w, LAT.fromT(U32, tw), Equal.sym(Array<U32>, LAT.fromT(U32, tw), w, ew), hwc)
  %ew : {Pair.snd(Array<U32>, U32, Array.get(U32, KMd.words(Pair.fst(P.H, Bool, P.grow_more(P.H{KM.MG{_}, a}))), ((m << 2n : U32) + 1 : U32))) == Pair.snd(Array<U32>, U32, Array.get(U32, _, P.at_fh())) : U32}
  fr.last.m(tw, a, wc, e, hw, he3, he27, hf2, hwc2, m, hm)

def Laws.more_last(w, a, wc, e, hf, hwc, hw, he3, he27, m, hm):
  more_last.w(w, a, wc, e, hw, he3, he27, hf, hwc, m, hm, LAT.mirror(U32, w))

