# Outer's Inner made for Outer2 and for Outer3: two objects, each its
# own copy of Inner, bound to its host. Z inherits both, so a is
# introduced twice, as two parents each introducing it would.
import Base

object Outer with
  shared def name() -> String:
    "outer"
  object Inner with
    def a() -> String:
      ^name()

object Outer2 extends Outer

object Outer3 extends Outer

object Z extends Outer2.Inner, Outer3.Inner
